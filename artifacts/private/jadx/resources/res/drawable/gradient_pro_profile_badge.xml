<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/p5d_corner_radius_rounded"/>
            <gradient
                android:startColor="#ff00c45a"
                android:endColor="#ff006ed4"
                android:angle="0"
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="20"
                android:endY="20"/>
            <stroke
                android:width="@dimen/p5d_border_medium"
                android:color="@color/white"/>
        </shape>
    </item>
</layer-list>
