<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:height="16dp"
                android:width="16dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/p5d_primary"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size
                android:height="8dp"
                android:width="8dp"/>
            <solid android:color="@color/p5d_primary"/>
        </shape>
    </item>
</layer-list>
