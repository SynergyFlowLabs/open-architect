<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/p5d_space_small"
        android:textColor="@color/text.beta"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xxx_small"
        android:text="@string/ai_designer_furnisher_description"
        android:lines="3"
        android:layout_marginHorizontal="@dimen/p5d_space_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
    <com.planner5d.library.widget.VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:layout_marginHorizontal="@dimen/p5d_space_large"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/font_size_big"
        android:id="@+id/button_continue"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginBottom="32dp"
        android:text="@string/contest_continue"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.UnelevatedButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
