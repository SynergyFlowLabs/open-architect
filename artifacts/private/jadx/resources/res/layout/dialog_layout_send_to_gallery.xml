<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:background="@drawable/background_white_round"
        android:paddingBottom="@dimen/p5d_space_tiny"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/folder_selection_header_height"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/dialog_icon"
                android:paddingTop="@dimen/p5d_space_tiny"
                android:paddingBottom="@dimen/p5d_space_tiny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/p5d_grey_1"
                android:gravity="start|center_vertical"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/folder_selection_header_height"
                android:paddingStart="@dimen/p5d_space_tiny"
                android:paddingEnd="@dimen/p5d_space_xx_small"
                app:layout_constraintStart_toEndOf="@+id/dialog_icon"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <View
            android:id="@+id/dialog_title_separator"
            android:background="@color/p5d_grey_6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border"
            app:layout_constraintTop_toBottomOf="@+id/title_container"/>
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_title_separator"/>
        <TextView
            android:textColor="@color/p5d_text"
            android:id="@+id/button_cancel"
            android:background="@drawable/background_button_grey"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/p5d_space_x_large"
            android:text="@string/Cancel"
            android:layout_marginEnd="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toStartOf="@+id/button_middle"
            app:layout_constraintTop_toBottomOf="@+id/content"
            style="@style/Planner5D.Button"/>
        <TextView
            android:textColor="@color/main_theme_color"
            android:id="@+id/button_middle"
            android:background="@drawable/background_button_grey"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/p5d_space_x_large"
            android:layout_marginEnd="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toStartOf="@+id/button_save"
            app:layout_constraintTop_toBottomOf="@+id/content"
            style="@style/Planner5D.Button"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/button_save"
            android:background="@drawable/background_button_primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/p5d_space_x_large"
            android:text="@string/send"
            android:layout_marginEnd="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content"
            style="@style/Planner5D.Button"/>
        <com.planner5d.library.widget.preloader.PreloaderBoxView
            android:id="@+id/preloader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:theme="@style/progressBarPrimary"
        android:layout_gravity="center"
        android:id="@+id/send_to_gallery_progress_bar"
        android:visibility="gone"
        android:layout_width="@dimen/p5d_space_40"
        android:layout_height="@dimen/p5d_space_40"/>
</FrameLayout>
