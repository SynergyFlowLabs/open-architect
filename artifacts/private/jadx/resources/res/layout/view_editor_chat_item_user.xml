<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message"
    android:paddingTop="@dimen/p5d_space_x_tiny"
    android:paddingBottom="@dimen/p5d_space_tiny"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text.alpha"
        android:id="@+id/text"
        android:background="@drawable/editor_chat_bubble_user"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        android:layout_marginBottom="@dimen/p5d_space_tiny"
        android:layout_marginStart="@dimen/p5d_space_40"
        android:layout_marginEnd="@dimen/p5d_space_20"
        android:paddingHorizontal="@dimen/p5d_space_xx_small"
        android:paddingVertical="@dimen/p5d_space_xxx_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/Planner5D.Text.Body_Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
