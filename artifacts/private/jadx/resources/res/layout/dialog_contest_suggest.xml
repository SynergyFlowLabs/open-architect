<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    style="@style/Planner5D.Contest.Dialog">
    <ScrollView
        android:background="@drawable/background_dialog_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/contestSuggestionCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:foreground="@drawable/ripple_round"
                android:layout_marginEnd="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/icon_close_button"/>
            <TextView
                android:textSize="@dimen/font_size_huge"
                android:gravity="center"
                android:id="@+id/contestSuggestionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:text="@string/desing_contest_onboarding_title"
                android:lineSpacingExtra="0dp"
                android:layout_marginStart="@dimen/p5d_space_large"
                android:layout_marginEnd="@dimen/p5d_space_large"
                android:lineHeight="@dimen/p5d_space_x_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSuggestionCancel"
                style="@style/Planner5D.TextView.Bold"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:gravity="center"
                android:id="@+id/contestSuggestionSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSuggestionTitle"
                style="@style/Planner5D.TextView"/>
            <com.planner5d.library.widget.preloader.PreloaderSimpleV2View
                android:id="@+id/contestSuggestionSubtitlePreloader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/contestSuggestionSubtitle"
                app:layout_constraintEnd_toEndOf="@+id/contestSuggestionSubtitle"
                app:layout_constraintStart_toStartOf="@+id/contestSuggestionSubtitle"
                app:layout_constraintTop_toTopOf="@+id/contestSuggestionSubtitle"/>
            <com.planner5d.library.widget.AnimatedImageView
                android:id="@+id/contestSuggestionAnimation"
                android:layout_width="@dimen/dialog_contest_image_size"
                android:layout_height="@dimen/dialog_contest_image_size"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toTopOf="@+id/contestSuggestionPrizes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSuggestionSubtitle"/>
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/contestSuggestionPrizes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:layout_marginBottom="@dimen/p5d_space_20"
                app:constraint_referenced_ids="contestSuggestionPrize1,contestSuggestionPrize2,contestSuggestionPrize3"
                app:flow_horizontalGap="@dimen/p5d_space_large"
                app:flow_wrapMode="chain"
                app:layout_constraintBottom_toTopOf="@+id/contestSuggestionOk"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSuggestionAnimation"/>
            <com.planner5d.library.contest.view.prize.ContestPrizeView
                android:id="@+id/contestSuggestionPrize1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:prizeImage="@drawable/contest_prize_renders"
                app:prizeTitle="@string/renders"/>
            <com.planner5d.library.contest.view.prize.ContestPrizeView
                android:id="@+id/contestSuggestionPrize2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:prizeImage="@drawable/contest_prize_textures"
                app:prizeTitle="@string/textures"/>
            <com.planner5d.library.contest.view.prize.ContestPrizeView
                android:id="@+id/contestSuggestionPrize3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:prizeImage="@drawable/contest_prize_premium"
                app:prizeTitle="@string/premium"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/contestSuggestionOk"
                android:background="@drawable/background_button_default"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_xx_large"
                android:layout_marginBottom="@dimen/p5d_space_x_small"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/desing_contest_onboarding_button"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
