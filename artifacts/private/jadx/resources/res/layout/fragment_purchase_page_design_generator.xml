<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="180dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/font_size_very_big"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/design_generator_paywall_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/purchase_design_generator_title"
                android:fontFamily="@font/roboto_bold_w700"
                android:layout_marginHorizontal="@dimen/p5d_space_x_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_grey_1"
                android:gravity="center"
                android:id="@+id/design_generator_paywall_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/purchase_design_generator_subtitle"
                android:lineSpacingExtra="1sp"
                android:fontFamily="@font/roboto_regular_w400"
                android:layout_marginHorizontal="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/design_generator_paywall_title"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_huge"
                app:layout_constraintTop_toBottomOf="@+id/design_generator_paywall_description">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/design_generator_product_list"
                    android:paddingBottom="@dimen/p5d_space_20"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.planner5d.library.widget.preloader.PreloaderCoverView
                    android:id="@+id/design_generator_product_list_preloader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/error"
                    android:gravity="center"
                    android:id="@+id/purchase_design_generator_error_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/p5d_space_medium"
                    android:layout_marginEnd="@dimen/p5d_space_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_white_vertical"
        android:layout_width="match_parent"
        android:layout_height="180dp"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/design_generator_purchase_continue"
        android:background="@drawable/gradient_green"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="38dp"
        android:foreground="@drawable/ripple_rounded"
        android:text="@string/purchase"
        android:fontFamily="@font/roboto_medium_w500"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"/>
</FrameLayout>
