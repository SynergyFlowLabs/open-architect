<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/background_preloader_v2"
        android:paddingLeft="@dimen/p5d_space_tiny"
        android:paddingTop="@dimen/p5d_space_tiny"
        android:paddingRight="@dimen/p5d_space_x_small"
        android:paddingBottom="@dimen/p5d_space_tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="@dimen/p5d_elevation_large">
        <View
            android:id="@+id/preloaderCircleBackground"
            android:background="@drawable/background_preloader_v2_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.planner5d.library.widget.preloader.PreloaderBarView
            android:layout_gravity="center"
            android:id="@+id/preloaderCircle"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:color="@color/p5d_primary"
            app:layout_constraintBottom_toBottomOf="@+id/preloaderCircleBackground"
            app:layout_constraintLeft_toLeftOf="@+id/preloaderCircleBackground"
            app:layout_constraintRight_toRightOf="@+id/preloaderCircleBackground"
            app:layout_constraintTop_toTopOf="@+id/preloaderCircleBackground"/>
        <TextView
            android:textSize="@dimen/font_size_normal"
            android:textColor="@color/p5d_eerie_black"
            android:gravity="left"
            android:layout_gravity="center_horizontal"
            android:id="@+id/preloaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/p5d_space_tiny"
            android:minWidth="128dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/preloaderCircleBackground"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
