<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/house_image"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/house_location"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="4:3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="92dp"
                android:src="@drawable/tip"
                android:elevation="@dimen/p5d_elevation_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/text.alpha"
                android:gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/onboarding_address_details_title"
                android:letterSpacing="@dimen/p5d_letter_spacing_minus_medium"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/house_image"
                style="@style/Planner5D.Text.Headline_Small_W2"/>
            <TextView
                android:textColor="@color/text.beta"
                android:gravity="center_horizontal"
                android:id="@+id/full_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"
                app:lineHeight="@dimen/p5d_space_medium"
                style="@style/Planner5D.Text.Body_Medium"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/house_info_list"
                android:background="@drawable/background_gamma_round_very_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:divider="@color/border.gamma"
                android:dividerHeight="@dimen/p5d_border"
                android:showDividers="middle"
                android:nestedScrollingEnabled="false"
                android:layout_marginHorizontal="@dimen/p5d_space_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/full_address"/>
            <TextView
                android:textColor="@color/text.beta"
                android:gravity="center"
                android:id="@+id/idea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:layout_constraintTop_toBottomOf="@+id/house_info_list"
                app:lineHeight="@dimen/p5d_space_20"
                style="@style/Planner5D.Text.Body_Small"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_back_circle"
        android:layout_marginStart="@dimen/p5d_space_xx_small"
        android:elevation="@dimen/p5d_elevation_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/font_size_very_big"
        android:id="@+id/button_continue"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="@dimen/p5d_space_large"
        android:text="@string/contest_continue"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Planner5D.UnelevatedButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
