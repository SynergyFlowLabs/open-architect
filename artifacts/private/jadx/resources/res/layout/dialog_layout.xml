<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_round_huge"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="280dp">
    <ImageView
        android:id="@+id/dialog_icon"
        android:layout_width="@dimen/dialog_icon_size"
        android:layout_height="@dimen/dialog_icon_size"
        android:layout_marginTop="@dimen/p5d_space_20"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/p5d_space_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/p5d_silver"/>
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textColor="@color/text.alpha"
        android:gravity="start|center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_medium"
        android:layout_marginHorizontal="@dimen/p5d_space_medium"
        app:layout_constraintStart_toEndOf="@+id/dialog_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_x_large"
        android:layout_marginBottom="@dimen/p5d_space_20"
        android:text="@string/Cancel"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_middle"
        app:layout_constraintTop_toBottomOf="@+id/content"
        style="@style/Planner5D.UnelevatedButton.Neutral"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_middle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_x_large"
        android:layout_marginBottom="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_save"
        app:layout_constraintTop_toBottomOf="@+id/content"
        style="@style/Planner5D.UnelevatedButton.Secondary"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_save"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_x_large"
        android:layout_marginBottom="@dimen/p5d_space_20"
        android:text="@string/save"
        android:layout_marginEnd="@dimen/p5d_space_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"
        style="@style/Planner5D.UnelevatedButton"/>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/preloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
