<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/snackBarAnchor"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_xxx_huge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/image_list"
        android:paddingBottom="@dimen/bottom_free_space"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/p5d_space_tiny"/>
    <View
        android:background="@drawable/gradient_white_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_free_space"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/button_send_to_gallery"
        android:background="@drawable/gradient_green"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_space_huge"
        android:layout_marginBottom="@dimen/p5d_space_x_large"
        android:foreground="@drawable/ripple_rounded"
        android:text="@string/tools_autostyle_save_all_to_gallery"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <com.planner5d.library.widget.preloader.PreloaderSimpleV2View
        android:id="@+id/gallery_preloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
