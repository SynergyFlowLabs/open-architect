<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.planner5d.library.widget.editor.editor2d.Editor2D
        android:id="@+id/editor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/p5d_space_xx_large"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/shapes_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/shapes_list"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_medium"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/next_button"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:id="@+id/next_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/smart_wizard_next_button_height"
        android:layout_marginBottom="@dimen/p5d_space_large"
        android:text="@string/next"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_rounded"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Planner5D.ButtonTextView.Green"/>
    <TextView
        android:id="@+id/tooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_tiny"
        android:text="@string/smart_wizard_room_shape_tooltip"
        app:layout_constraintBottom_toTopOf="@+id/shapes_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.TextView.Tooltip"/>
    <FrameLayout
        android:id="@+id/tooltip_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
