<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingBottom="@dimen/p5d_space_large"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:nestedScrollingEnabled="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/authentication_padding"
        android:layout_marginEnd="@dimen/authentication_padding"
        style="@style/Planner5D.Authentication.Content">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="0dp"
            android:layout_height="@dimen/authentication_image_height"
            android:src="@drawable/icon_sign_in"
            app:layout_constraintDimensionRatio="94:65"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/text.alpha"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_20"
            android:text="@string/user_sign_in_main_title"
            android:letterSpacing="0"
            android:paddingHorizontal="@dimen/p5d_space_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            style="@style/Planner5D.Text.Headline_Small_W1"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/authenticationSignInByService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_medium"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="@dimen/font_size_small"
            android:textColor="@color/p5d_grey_3"
            android:gravity="center_horizontal"
            android:id="@+id/agreementsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/agreements_button_bottom_padding"
            android:text="@string/new_welcome_terms_and_conditions_format"
            android:lineSpacingExtra="3dp"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            android:layout_marginEnd="@dimen/p5d_space_x_small"
            android:breakStrategy="simple"
            app:layout_constraintBottom_toTopOf="@+id/authenticationSignInCreateQuestion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/authenticationSignInByService"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/text.alpha"
            android:id="@+id/authenticationSignInCreateQuestion"
            android:background="@drawable/ripple_rounded_corners"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="124dp"
            android:text="@string/already_have_an_account_question"
            android:layout_marginEnd="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toStartOf="@+id/authenticationSignIn"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/agreementsLabel"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/p5d_primary"
            android:id="@+id/authenticationSignIn"
            android:background="@drawable/ripple_rounded_corners"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_log_in"
            app:layout_constraintBottom_toBottomOf="@+id/authenticationSignInCreateQuestion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/authenticationSignInCreateQuestion"
            app:layout_constraintTop_toTopOf="@+id/authenticationSignInCreateQuestion"
            style="@style/Planner5D.TextView.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
