<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/icon_measurement_size"
                android:layout_height="@dimen/icon_measurement_size"
                android:layout_marginTop="@dimen/icon_measurement_top_margin"
                android:src="@drawable/icon_measurement"
                android:contentDescription="@string/ai_upload_add_scale_length_alert_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_very_very_very_very_big"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:text="@string/ai_upload_add_scale_length_alert_title"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/icon"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_grey_1_dark"
                android:gravity="center"
                android:id="@+id/description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_tiny"
                android:text="@string/ai_enter_length_subtitle"
                android:layout_marginHorizontal="@dimen/p5d_space_x_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"
                style="@style/Planner5D.TextView"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_primary"
                android:gravity="center_vertical"
                android:id="@+id/button_cm"
                android:background="@drawable/background_button_checkmark"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_measurement_height"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:text="@string/ai_enter_length_button_centimetres"
                android:drawablePadding="@dimen/p5d_space_xx_small"
                android:paddingStart="@dimen/p5d_space_x_small"
                android:layout_marginStart="@dimen/p5d_space_20"
                app:drawableStartCompat="@drawable/ai_check_mark"
                app:layout_constraintEnd_toStartOf="@+id/button_inch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/description"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_primary"
                android:gravity="center_vertical"
                android:id="@+id/button_inch"
                android:background="@drawable/background_button_checkmark"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_measurement_height"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:text="@string/ai_upload_scale_measurement_action_feet_inches"
                android:drawablePadding="@dimen/p5d_space_xx_small"
                android:paddingStart="@dimen/p5d_space_x_small"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:drawableStartCompat="@drawable/ai_check_mark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/button_cm"
                app:layout_constraintTop_toBottomOf="@+id/description"
                style="@style/Planner5D.TextView.Medium"/>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material.Dark"
                android:id="@+id/scale_cm_input_layout"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_small"
                android:hint="@string/ai_upload_scale_measurement_action_cm"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:helperText=" "
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/button_cm">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/scale_cm_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="4"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material.Dark"
                android:id="@+id/scale_ft_input_layout"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_small"
                android:hint="@string/ai_enter_length_unit_ft"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:helperText=" "
                app:layout_constraintEnd_toStartOf="@+id/scale_in_input_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/button_cm">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/scale_ft_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="4"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material.Dark"
                android:id="@+id/scale_in_input_layout"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_small"
                android:hint="@string/ai_enter_length_unit_in"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:helperText=" "
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/scale_ft_input_layout"
                app:layout_constraintTop_toBottomOf="@+id/button_cm">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/scale_in_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="2"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/conversion_panel"
                android:background="@drawable/background_conversion_panel_ok"
                android:layout_width="match_parent"
                android:layout_height="@dimen/p5d_space_x_huge"
                android:drawablePadding="@dimen/p5d_space_x_small"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                android:paddingHorizontal="@dimen/p5d_space_x_small"
                app:drawableStartCompat="@drawable/icon_info_white"
                app:layout_constraintTop_toBottomOf="@+id/scale_cm_input_layout"/>
            <com.planner5d.library.widget.textview.ButtonTextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/submit_button"
                android:background="@drawable/gradient_green"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_xx_large"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:layout_marginBottom="@dimen/p5d_space_40"
                android:foreground="@drawable/ripple_rounded_corners_huge"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/conversion_panel"
                app:layout_constraintVertical_bias="1"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/measurements_back"
        android:background="@drawable/ripple_round"
        android:padding="@dimen/p5d_space_xx_tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/p5d_space_x_small"
        android:src="@drawable/icon_back_32"
        app:tint="@color/p5d_grey_1_dark"/>
</FrameLayout>
