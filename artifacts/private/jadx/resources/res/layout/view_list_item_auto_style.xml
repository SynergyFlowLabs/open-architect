<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.Planner5D.MaterialCard.Material"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_styles_card_height"
    android:layout_marginTop="@dimen/p5d_space_x_small"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/card_press"
    android:layout_marginHorizontal="@dimen/p5d_space_20"
    app:cardCornerRadius="@dimen/p5d_corner_radius_large"
    app:cardElevation="@dimen/p5d_elevation_large">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:scaleX="1.1"
            android:scaleY="1.1"/>
        <View
            android:background="@color/black_50"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.planner5d.library.widget.textview.ButtonTextView
            android:textSize="@dimen/font_size_small"
            android:textColor="@color/white"
            android:id="@+id/badge_new"
            android:background="@drawable/gradient_green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            android:foreground="@drawable/ripple_rounded"
            android:text="@string/common_new"
            android:layout_marginHorizontal="@dimen/p5d_space_tiny"
            android:paddingHorizontal="@dimen/p5d_space_tiny"
            android:paddingVertical="@dimen/p5d_space_xx_tiny"
            app:backgroundCornerRadius="@dimen/p5d_corner_radius_large"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
        <ImageView
            android:id="@+id/icon_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            android:src="@drawable/icon_error_red_20"
            android:layout_marginHorizontal="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_size_very_big"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:lines="1"
            android:layout_marginHorizontal="@dimen/p5d_space_x_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_tiny"
            android:lines="2"
            android:layout_marginHorizontal="@dimen/p5d_space_x_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/Planner5D.TextView"/>
        <com.planner5d.library.widget.textview.ButtonTextView
            android:textSize="@dimen/font_size_small"
            android:textColor="@color/white"
            android:id="@+id/restart"
            android:background="@drawable/gradient_green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/p5d_space_x_small"
            android:foreground="@drawable/ripple_rounded"
            android:text="@string/tools_autostyle_design_restart"
            android:layout_marginHorizontal="@dimen/p5d_space_x_small"
            android:paddingHorizontal="@dimen/p5d_space_xx_small"
            android:paddingVertical="5dp"
            app:backgroundCornerRadius="@dimen/p5d_corner_radius_rounded"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
