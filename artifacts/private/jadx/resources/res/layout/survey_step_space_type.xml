<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/survey_button_back"
        android:padding="@dimen/p5d_space_xx_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/icon_back_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:theme="@style/Theme.Planner5D.Material3"
        android:id="@+id/survey_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:progress="60"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="6dp"
        app:indicatorColor="@color/primary.icon.gamma"
        app:layout_constraintBottom_toBottomOf="@+id/survey_step_nr"
        app:layout_constraintEnd_toStartOf="@+id/survey_step_nr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/survey_step_nr"
        app:trackColor="@color/neutral.border.beta"/>
    <TextView
        android:id="@+id/survey_step_nr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3/5"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/survey_button_back"
        style="@style/Planner5D.Text.Misc_Caption"/>
    <TextView
        android:textColor="@color/text.alpha"
        android:gravity="center"
        android:id="@+id/survey_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_20"
        android:text="@string/survey_step_title_space_type"
        android:letterSpacing="-0.021"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/survey_step_nr"
        style="@style/Planner5D.Text.Headline_Small_W2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/recycler_view"
        android:paddingTop="@dimen/p5d_space_medium"
        android:paddingBottom="@dimen/p5d_space_40"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/survey_title"
        app:layout_constraintWidth_max="520dp"
        app:spanCount="2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
