<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.planner5d.library.widget.RoundedCornersLayout
        android:id="@+id/contentWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_rounded_corners_large"
        app:cornerRadius="@dimen/p5d_corner_radius_large"
        app:roundedBorderColor="@color/p5d_grey_5"
        app:roundedBorderWidth="@dimen/p5d_border">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/contestImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="2:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_small"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/contestRemainingTime"
                android:background="@drawable/background_button_primary_label_beta_rounded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:drawablePadding="@dimen/p5d_space_x_tiny"
                android:paddingEnd="@dimen/p5d_space_tiny"
                android:layout_marginStart="@dimen/p5d_space_x_small"
                app:drawableStartCompat="@drawable/icon_clock"
                app:layout_constraintBottom_toBottomOf="@+id/contestImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestImage"
                style="@style/Planner5D.Font.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_very_very_big"
                android:textColor="@color/text.alpha"
                android:ellipsize="end"
                android:id="@+id/contestName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:maxLines="2"
                android:layout_marginHorizontal="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestImage"
                style="@style/Planner5D.Font.Bold"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/text.beta"
                android:ellipsize="end"
                android:id="@+id/contestRequirements"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_small"
                android:maxLines="4"
                app:layout_constraintEnd_toEndOf="@+id/contestName"
                app:layout_constraintStart_toStartOf="@+id/contestName"
                app:layout_constraintTop_toBottomOf="@+id/contestName"
                style="@style/Planner5D.TextView"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/primary.label.alpha"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/contestShareExplanation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:text="@string/design_battle_share_explain"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="@+id/contestName"
                app:layout_constraintStart_toStartOf="@+id/contestName"
                app:layout_constraintTop_toBottomOf="@+id/contestRequirements"
                style="@style/Planner5D.TextView.Bold"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/contestButtonParticipate"
                android:background="@drawable/background_button_primary_fill_beta_rounded"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_40"
                android:layout_marginTop="42dp"
                android:foreground="@drawable/ripple_rounded_corners"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:layout_marginHorizontal="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestRequirements"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/contestButtonVote"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_40"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:layout_marginBottom="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_rounded_corners"
                android:includeFontPadding="false"
                android:layout_marginHorizontal="@dimen/p5d_space_x_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestButtonParticipate"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.planner5d.library.widget.RoundedCornersLayout>
    <View
        android:id="@+id/emptyPlaceholder"
        android:background="@drawable/background_grey_round_xx"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.planner5d.library.widget.preloader.PreloaderShimmerV2View
        android:id="@+id/preloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
