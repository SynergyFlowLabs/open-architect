<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text.alpha"
        android:gravity="start"
        android:id="@+id/title"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bernard_promt_title"
        android:paddingHorizontal="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Text.Headline_Small_W1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/suggestions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="@dimen/p5d_space_xx_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <include layout="@layout/view_editor_chat_item_suggestion"/>
        <include layout="@layout/view_editor_chat_item_suggestion"/>
        <include layout="@layout/view_editor_chat_item_suggestion"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
