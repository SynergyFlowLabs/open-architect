<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_very_very_big"
        android:id="@+id/title"
        android:paddingTop="@dimen/p5d_space_tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:paddingStart="@dimen/p5d_space_xxx_small"
        android:paddingEnd="@dimen/p5d_space_xxx_small"
        android:nestedScrollingEnabled="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/placeholder"
        android:paddingTop="@dimen/p5d_space_tiny"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/p5d_space_xxx_small"
        android:paddingEnd="@dimen/p5d_space_xxx_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <include layout="@layout/view_list_item_design_of_day_placeholder"/>
        <include layout="@layout/view_list_item_design_of_day_placeholder"/>
        <include layout="@layout/view_list_item_design_of_day_placeholder"/>
        <include layout="@layout/view_list_item_design_of_day_placeholder"/>
        <include layout="@layout/view_list_item_design_of_day_placeholder"/>
        <include layout="@layout/view_list_item_design_of_day_placeholder"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
