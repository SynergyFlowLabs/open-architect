<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="440dp"
        android:layout_height="280dp">
        <ImageView
            android:id="@+id/dialog_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:scaleType="center"
            android:layout_marginStart="@dimen/p5d_space_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_size_very_very_big"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/title"
            android:background="@drawable/background_dialog_top_bar"
            android:paddingLeft="24dp"
            android:paddingTop="0dp"
            android:paddingRight="24dp"
            android:paddingBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_top_bar_height"
            android:drawablePadding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dialog_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/dialog_button_container"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <LinearLayout
            android:gravity="right"
            android:id="@+id/dialog_button_container"
            android:background="@drawable/background_dialog_bottom_bar"
            android:paddingLeft="24dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_bottom_bar_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <Button
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/main_theme_color"
                android:gravity="center"
                android:id="@+id/button_additional"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/Cancel"
                android:textAllCaps="false"
                style="?android:attr/borderlessButtonStyle"/>
            <Button
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/main_theme_color"
                android:gravity="center"
                android:id="@+id/button_cancel"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/Cancel"
                android:textAllCaps="false"
                style="?android:attr/borderlessButtonStyle"/>
            <Button
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/main_theme_color"
                android:gravity="center"
                android:id="@+id/button_save"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/save"
                android:textAllCaps="false"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
        <com.planner5d.library.widget.preloader.PreloaderCoverView
            android:id="@+id/preloader"
            android:visibility="gone"
            android:layout_width="440dp"
            android:layout_height="280dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
