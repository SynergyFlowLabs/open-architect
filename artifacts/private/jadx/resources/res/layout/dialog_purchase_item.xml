<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_button_green_secondary"
    android:paddingTop="@dimen/purchase_product_title_padding_vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:minWidth="@dimen/purchase_product_min_width"
    android:minHeight="@dimen/purchase_premium_products_height"
    android:paddingHorizontal="@dimen/purchase_product_title_padding_horizontal">
    <TextView
        android:textSize="@dimen/purchase_product_title_text_size"
        android:id="@+id/purchaseProductTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/purchaseProductSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/purchase_product_subtitle_text_size"
        android:textColor="@color/p5d_eerie_black"
        android:id="@+id/purchaseProductSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/purchase_product_line_spacing"
        app:layout_constraintBottom_toTopOf="@+id/purchaseProductPrice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/purchaseProductTitle"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:textSize="@dimen/purchase_product_price_text_size"
        android:textColor="@color/p5d_primary_dark"
        android:id="@+id/purchaseProductPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/purchaseProductTapButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/purchaseProductSubtitle"
        style="@style/Planner5D.TextView.Bold"/>
    <TextView
        android:textSize="@dimen/purchase_product_subtitle_text_size"
        android:textColor="@color/p5d_grey_3"
        android:id="@+id/purchaseProductTapButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tap_to_purchase"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/purchaseProductPrice"
        style="@style/Planner5D.TextView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
