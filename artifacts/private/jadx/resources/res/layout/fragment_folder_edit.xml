<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/folder_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/folder_image_size"
        android:src="@drawable/icon_folder_white"
        android:tint="@color/folder_color_1"
        android:tintMode="multiply"
        android:paddingVertical="@dimen/p5d_space_x_small"/>
    <RadioGroup
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/color_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small">
        <RadioButton
            android:buttonTint="@color/folder_color_1"
            style="@style/Planner5D.ColorPicker.RadioButton"/>
        <RadioButton
            android:buttonTint="@color/folder_color_2"
            style="@style/Planner5D.ColorPicker.RadioButton"/>
        <RadioButton
            android:buttonTint="@color/folder_color_3"
            style="@style/Planner5D.ColorPicker.RadioButton"/>
        <RadioButton
            android:buttonTint="@color/folder_color_4"
            style="@style/Planner5D.ColorPicker.RadioButton"/>
        <RadioButton
            android:buttonTint="@color/folder_color_5"
            style="@style/Planner5D.ColorPicker.RadioButton"/>
    </RadioGroup>
    <com.google.android.material.textfield.TextInputLayout
        android:theme="@style/Theme.Planner5D.Form.Material.Grey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_large"
        android:hint="@string/name"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20">
        <com.planner5d.library.widget.TextInputEditTextCompat
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
            style="@style/Planner5D.Text.Body_Medium"/>
    </com.google.android.material.textfield.TextInputLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:id="@+id/delete_button"
        android:background="@drawable/background_transparent_round_border_gamma"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_space_huge"
        android:layout_marginBottom="@dimen/p5d_space_medium"
        android:foreground="@drawable/ripple_rounded"
        android:layout_marginHorizontal="@dimen/p5d_space_20">
        <TextView
            android:textColor="@color/error.text.beta"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_folder"
            app:drawableStartCompat="@drawable/icon_trash_red"
            style="@style/Planner5D.Text.Title_Small"/>
    </FrameLayout>
</LinearLayout>
