<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/purchasePremiumScrollView"
    android:background="@drawable/gradient_paywall"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/purchase_logo_height_pro_square"
            android:layout_marginTop="@dimen/purchase_logo_top_pro_square"
            android:src="@drawable/icon_logo_full_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/purchase_title_font_size_pro_square"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/purchase_title_top_margin_pro_square"
            android:text="@string/purchases_switch_paywall_colored_title"
            android:paddingHorizontal="@dimen/purchase_title_padding_square"
            app:autoSizeMaxTextSize="@dimen/purchase_title_font_size_pro_square"
            app:autoSizeMinTextSize="@dimen/font_size_small"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo"
            style="@style/Planner5D.TextView.Bold"/>
        <TextView
            android:textSize="@dimen/purchase_marquee_font_size_pro_square"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@+id/marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/purchase_marque_top_margin_pro_square"
            android:text="@string/purchases_pro_color_scroll_label"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/Planner5D.TextView.Medium"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            app:layout_constraintBottom_toTopOf="@+id/purchasePremiumProducts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/marquee"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/purchasePremiumProducts"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/disclaimerText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width">
            <include
                android:id="@+id/trial_switch"
                app:layout_constraintBottom_toTopOf="@+id/purchasePremiumList"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/view_purchase_trial_switch_square"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/purchasePremiumList"
                android:clipChildren="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/purchase_list_top_margin_pro_square"
                android:layout_marginBottom="@dimen/purchase_action_button_margin_square"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toTopOf="@+id/purchasePremiumActionButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/trial_switch"/>
            <com.planner5d.library.widget.preloader.PreloaderCoverView
                android:id="@+id/purchasePremiumProductListPreloader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/trial_switch"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/error"
                android:gravity="center"
                android:id="@+id/purchasePremiumErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/p5d_space_medium"
                android:layout_marginEnd="@dimen/p5d_space_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/primary.P60"
                android:gravity="center"
                android:id="@+id/purchasePremiumActionButton"
                android:background="@drawable/background_button_white_round_selected"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/continue_premium_purchase"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/purchasePremiumList"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/disclaimerText"
            android:paddingTop="@dimen/purchase_disclaimer_top_padding_pro_square"
            android:paddingBottom="@dimen/purchase_disclaimer_bottom_padding_pro_square"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/purchases_subscription_disclaimer"
            android:lineSpacingMultiplier="1.26"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:layout_constraintBottom_toTopOf="@+id/purchasePremiumTerms"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Planner5D.TextView"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:orientation="horizontal"
            android:id="@+id/purchaseTermsFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="purchasePremiumTerms,purchasePremiumPrivacy,purchasePremiumRestore"
            app:flow_horizontalStyle="packed"
            app:flow_wrapMode="chain"
            app:layout_constraintBottom_toTopOf="@+id/purchaseNoPayment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/white"
            android:id="@+id/purchasePremiumTerms"
            android:paddingBottom="@dimen/purchase_bottom_padding_pro_square"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy_message_title"
            android:paddingHorizontal="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toStartOf="@+id/purchasePremiumPrivacy"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProducts"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/white"
            android:id="@+id/purchasePremiumPrivacy"
            android:paddingBottom="@dimen/purchase_bottom_padding_pro_square"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy_policy"
            android:paddingHorizontal="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toStartOf="@+id/purchasePremiumRestore"
            app:layout_constraintStart_toEndOf="@+id/purchasePremiumTerms"
            app:layout_constraintTop_toTopOf="@+id/purchasePremiumTerms"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/white"
            android:id="@+id/purchasePremiumRestore"
            android:paddingBottom="@dimen/purchase_bottom_padding_pro_square"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchases_button_restore"
            android:paddingHorizontal="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/purchasePremiumPrivacy"
            app:layout_constraintTop_toTopOf="@+id/purchasePremiumTerms"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/white"
            android:id="@+id/purchaseNoPayment"
            android:paddingBottom="@dimen/purchase_bottom_padding_pro_square"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchases.switch_paywall.no_payment_charge"
            app:layout_constraintBottom_toTopOf="@+id/bottomLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumTerms"/>
        <Space
            android:id="@+id/bottomLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchaseNoPayment"/>
        <com.planner5d.library.widget.preloader.PreloaderCoverView
            android:id="@+id/purchasesDialogPreloader"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
