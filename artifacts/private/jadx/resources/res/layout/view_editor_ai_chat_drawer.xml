<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_gravity="start"
        android:id="@+id/editor_bernard_bottomsheet_coordinator"
        android:clipChildren="false"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/p5d_space_20"
        style="@style/Planner5D.BottomSheetLayout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/editor_ai_chat_bottomsheet"
            android:background="@drawable/background_editor_ai_chat_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:behavior_fitToContents="false"
            app:behavior_halfExpandedRatio="0.515"
            app:behavior_hideable="true"
            app:behavior_peekHeight="0dp"
            app:layout_behavior="com.google.android.material.bottomsheet.AdvancedBottomSheetBehavior">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/ai_chat_handle_guideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintGuide_begin="@dimen/p5d_space_x_large"/>
            <View
                android:id="@+id/editor_bernard_bottomsheet_handle"
                android:background="@drawable/background_gray_ga40_round_huge"
                android:layout_width="@dimen/p5d_space_large"
                android:layout_height="@dimen/p5d_space_x_tiny"
                app:layout_constraintBottom_toBottomOf="@+id/ai_chat_handle_guideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/ai_chat_title_guideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintGuide_begin="92dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/ai_chat_messages_guideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintGuide_begin="90dp"/>
            <TextView
                android:textColor="@color/text.alpha"
                android:id="@+id/editor_bernard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_chat_title"
                android:drawablePadding="@dimen/p5d_space_tiny"
                android:layout_marginStart="5dp"
                app:drawableStartCompat="@drawable/icon_ai_color"
                app:layout_constraintBottom_toTopOf="@+id/ai_chat_title_guideline"
                app:layout_constraintStart_toEndOf="@+id/editor_bernard_close"
                app:layout_constraintTop_toTopOf="@+id/ai_chat_handle_guideline"
                style="@style/Planner5D.Text.Title_Large"/>
            <ImageView
                android:id="@+id/editor_bernard_close"
                android:padding="@dimen/p5d_space_xx_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/ripple_round"
                android:src="@drawable/icon_chat_close"
                android:layout_marginStart="@dimen/p5d_space_tiny"
                app:layout_constraintBottom_toTopOf="@+id/ai_chat_title_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ai_chat_handle_guideline"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/messages"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="true"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ai_chat_messages_guideline"
                app:stackFromEnd="false"/>
            <ScrollView
                android:id="@+id/suggestion_layout"
                android:layout_width="0dp"
                android:layout_height="450dp"
                android:fillViewport="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ai_chat_messages_guideline">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/text.alpha"
                        android:gravity="start"
                        android:id="@+id/title"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bernard_promt_title"
                        android:paddingHorizontal="@dimen/p5d_space_20"
                        app:layout_constraintBottom_toTopOf="@+id/suggestions"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.5"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:layout_constraintVertical_weight="0"
                        style="@style/Planner5D.Text.Headline_Small_W1"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/suggestions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="@dimen/p5d_space_xx_small"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/title"
                        app:layout_constraintVertical_weight="1">
                        <include layout="@layout/view_editor_chat_item_suggestion"/>
                        <include layout="@layout/view_editor_chat_item_suggestion"/>
                        <include layout="@layout/view_editor_chat_item_suggestion"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/ai_chat_input"
        android:background="@drawable/background_editor_ai_chat_drawer"
        android:clipChildren="false"
        android:layout_height="wrap_content"
        android:elevation="@dimen/p5d_elevation_huge"
        style="@style/Planner5D.BottomSheetLayout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/p5d_space_x_small">
            <EditText
                android:textColor="@color/text.alpha"
                android:textColorHint="@color/text.gamma"
                android:id="@+id/message"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/bernard_text_placeholder"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen"
                android:layout_marginEnd="@dimen/p5d_space_x_tiny"
                android:paddingVertical="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/button_send"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.Text.Body_Medium"/>
            <ImageView
                android:enabled="false"
                android:id="@+id/button_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_chat_send"
                android:layout_marginStart="@dimen/p5d_space_xx_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</merge>
