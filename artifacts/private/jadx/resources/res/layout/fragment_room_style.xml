<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_grey_1"
                android:gravity="center"
                android:id="@+id/room_style_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/room_style_description"
                android:fontFamily="@font/roboto_regular_w400"
                android:layout_marginHorizontal="@dimen/p5d_space_x_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/room_style_list"
                android:paddingBottom="@dimen/bottom_free_space"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_tiny"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/room_style_description"
                app:spanCount="2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_white_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_free_space"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/button_text_default"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/room_style_continue"
        android:background="@drawable/background_button_default_gradient"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="38dp"
        android:foreground="@drawable/ripple_rounded"
        android:text="@string/contest_continue"
        android:fontFamily="@font/roboto_medium_w500"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"/>
    <com.planner5d.library.widget.preloader.PreloaderSimpleV2View
        android:id="@+id/room_style_preloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
