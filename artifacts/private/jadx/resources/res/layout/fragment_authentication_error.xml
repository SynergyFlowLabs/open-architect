<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_min="410dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.Authentication.FullScreenContent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/authenticationErrorButtons"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/authenticationErrorIcon"
                    android:layout_width="@dimen/authentication_error_icon_size"
                    android:layout_height="@dimen/authentication_error_icon_size"
                    android:layout_marginTop="@dimen/p5d_space_medium"
                    app:srcCompat="@drawable/icon_error_red"/>
                <TextView
                    android:textSize="@dimen/authentication_error_title_size"
                    android:id="@+id/authenticationErrorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/p5d_space_medium"
                    android:text="@string/error_sign_in_label"
                    style="@style/Planner5D.TextView.Medium"/>
                <TextView
                    android:textSize="@dimen/authentication_error_text_size"
                    android:textColor="@color/p5d_text"
                    android:id="@+id/authenticationErrorExplanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/p5d_space_x_small"
                    android:layout_marginBottom="@dimen/p5d_space_medium"
                    android:text="@string/error_sign_in_explanation"
                    style="@style/Planner5D.TextView"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/authenticationErrorButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/authenticationErrorRetry"
                    android:background="@drawable/background_button_default"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/authentication_button_height"
                    android:foreground="@drawable/ripple_rounded_corners"
                    android:text="@string/retry"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Planner5D.TextView.Medium"/>
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/p5d_grey_1"
                    android:gravity="center"
                    android:id="@+id/authenticationErrorCancel"
                    android:background="@drawable/background_button_light_grey"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/authentication_button_height"
                    android:layout_marginTop="@dimen/p5d_space_x_small"
                    android:layout_marginBottom="@dimen/p5d_space_medium"
                    android:foreground="@drawable/ripple_rounded_corners"
                    android:text="@string/cancel_button"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/authenticationErrorRetry"
                    style="@style/Planner5D.TextView.Medium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
