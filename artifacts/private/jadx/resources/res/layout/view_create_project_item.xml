<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/create_project_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_rounded_corners_large"
    android:minHeight="@dimen/create_project_card_height"
    android:elevation="@dimen/p5d_elevation_large"
    android:stateListAnimator="@animator/card_press"
    android:layout_marginHorizontal="@dimen/p5d_space_20"
    android:layout_marginVertical="@dimen/p5d_space_tiny">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_from_scratch"
        android:layout_marginStart="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ai_from_scratch"
        android:layout_marginStart="@dimen/p5d_space_large"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/p5d_grey_2"
        android:layout_gravity="center_vertical"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        android:text="@string/ai_convert_a_blueprint_to_3d_plan"
        android:layout_marginEnd="@dimen/p5d_space_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:id="@+id/tooltipNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="@string/gallery_sort_new"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Badge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
