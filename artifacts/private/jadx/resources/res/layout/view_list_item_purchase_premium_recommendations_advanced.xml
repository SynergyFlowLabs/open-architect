<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/purchase_premium_recommendations_height_advanced">
    <com.planner5d.library.widget.RoundedCornersLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cornerRadius="@dimen/p5d_corner_radius_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/purchase_premium_5"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@drawable/premium_background_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.planner5d.library.widget.RoundedCornersLayout>
    <TextView
        android:textSize="@dimen/font_size_very_very_very_very_big"
        android:textColor="@color/white"
        android:gravity="start"
        android:id="@+id/purchasePremiumProductTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:layout_marginBottom="@dimen/p5d_space_x_small"
        android:text="@string/purchase_paywall_advanced"
        android:paddingStart="@dimen/p5d_space_x_small"
        android:paddingEnd="@dimen/p5d_space_x_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Agreements.Title"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="start"
        android:id="@+id/purchasePremiumProductText"
        android:paddingTop="@dimen/p5d_space_xx_small"
        android:paddingBottom="@dimen/p5d_space_xx_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/p5d_space_xx_huge"
        android:paddingStart="@dimen/p5d_space_x_small"
        android:paddingEnd="@dimen/p5d_space_x_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProductTitle"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:textColor="@color/white"
        android:gravity="start"
        android:id="@+id/purchasePremiumProductRecommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/purchase_paywall_advanced_recommendation"
        android:paddingStart="@dimen/p5d_space_x_small"
        android:paddingEnd="@dimen/p5d_space_x_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProductText"
        style="@style/Planner5D.TextView"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/purchaseChoose"
        android:background="@drawable/gradient_green"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/purchase_paywall_choose"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        android:paddingHorizontal="@dimen/p5d_space_medium"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintBottom_toBottomOf="@+id/purchasePremiumProductText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/purchasePremiumProductTitle"
        style="@style/Planner5D.Agreements.AcceptAll"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/white"
        android:id="@+id/purchasePremiumProductSaleTag"
        android:background="@drawable/background_red_rounded"
        android:paddingTop="@dimen/p5d_space_x_tiny"
        android:paddingBottom="@dimen/p5d_space_x_tiny"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/purchases_badge_percent_off"
        android:textAllCaps="true"
        android:paddingStart="@dimen/p5d_space_xx_small"
        android:paddingEnd="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
