<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_round"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="@dimen/modal_form_width">
    <ImageView
        android:id="@+id/premium_feature_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_medium"
        android:src="@drawable/image_paywall_stumble"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/button_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:src="@drawable/icon_close_button"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/premium_feature_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_medium"
        android:text="@string/premium_feature"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/premium_feature_image"
        style="@style/Planner5D.Title"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_grey_1"
        android:gravity="center"
        android:id="@+id/premium_feature_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:text="@string/premium_feature_message"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20"
        android:letterSpacing="@dimen/p5d_letter_spacing_extra"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/premium_feature_title"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:textColor="@color/button_text_default"
        android:id="@+id/button_save"
        android:background="@drawable/background_button_green_gradient_radius_4"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginTop="@dimen/p5d_space_medium"
        android:layout_marginBottom="@dimen/p5d_space_20"
        android:foreground="@drawable/ripple_rounded_corners"
        android:text="@string/premium_feature_button"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/premium_feature_description"
        style="@style/Planner5D.Button.GreenRounded"/>
</androidx.constraintlayout.widget.ConstraintLayout>
