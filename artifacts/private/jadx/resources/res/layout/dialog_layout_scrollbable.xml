<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="436dp"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="436dp"
        android:layout_height="match_parent">
        <TextView
            android:textColor="#ff444444"
            android:gravity="center"
            android:layout_gravity="top"
            android:id="@+id/title"
            android:background="#ffe0e0e0"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/folder_selection_header_height"/>
        <ScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/folder_selection_header_height"
            android:layout_marginBottom="@dimen/folder_selection_header_height"
            android:fillViewport="false"/>
        <LinearLayout
            android:gravity="right"
            android:layout_gravity="bottom"
            android:id="@+id/dialog_button_container"
            android:background="#ffe0e0e0"
            android:paddingLeft="24dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/folder_selection_header_height">
            <Button
                android:textColor="@color/main_theme_color"
                android:gravity="center"
                android:id="@+id/button_cancel"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/Cancel"
                android:textAllCaps="true"
                style="?android:attr/borderlessButtonStyle"/>
            <Button
                android:textColor="@color/main_theme_color"
                android:gravity="center"
                android:id="@+id/button_middle"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:textAllCaps="true"
                style="?android:attr/borderlessButtonStyle"/>
            <Button
                android:textColor="@color/main_theme_color"
                android:gravity="center"
                android:id="@+id/button_save"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/save"
                android:textAllCaps="true"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
    </FrameLayout>
    <com.planner5d.library.widget.preloader.PreloaderBoxView
        android:id="@+id/preloader"
        android:layout_width="436dp"
        android:layout_height="match_parent"/>
</FrameLayout>
