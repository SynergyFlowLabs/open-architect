<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_gravity="start"
        android:id="@+id/itemPropertiesDrawerCoordinator"
        android:layout_height="match_parent"
        style="@style/Planner5D.BottomSheetLayout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/itemPropertiesDrawerBottomSheet"
            android:background="@drawable/background_white_top_round"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:behavior_fitToContents="false"
            app:behavior_halfExpandedRatio="0.5"
            app:behavior_hideable="true"
            app:behavior_peekHeight="0dp"
            app:layout_behavior="com.google.android.material.bottomsheet.AdvancedBottomSheetBehavior">
            <View
                android:id="@+id/itemPropertiesDrawerHandle"
                android:background="@drawable/background_grey_3_round"
                android:layout_width="35dp"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/itemPropertiesBack"
                android:padding="@dimen/p5d_space_xxx_small"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/ripple_round"
                android:src="@drawable/icon_back_32"
                android:layout_marginStart="@dimen/p5d_space_x_tiny"
                app:layout_constraintBottom_toTopOf="@+id/itemPropertiesGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/p5d_grey_1"/>
            <TextView
                android:ellipsize="middle"
                android:gravity="center_horizontal"
                android:id="@+id/itemPropertiesTitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:maxLines="1"
                app:layout_constraintEnd_toStartOf="@+id/itemPropertiesClose"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintStart_toEndOf="@+id/itemPropertiesBack"
                app:layout_constraintTop_toBottomOf="@+id/itemPropertiesDrawerHandle"
                style="@style/Planner5D.TextView.Medium"/>
            <ImageView
                android:id="@+id/itemPropertiesClose"
                android:padding="@dimen/p5d_space_xx_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/ripple_round"
                android:src="@drawable/icon_close_button"
                android:layout_marginEnd="@dimen/p5d_space_tiny"
                app:layout_constraintBottom_toTopOf="@+id/itemPropertiesGuideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/itemPropertiesGuideline"
                android:background="@color/p5d_grey_5"
                android:layout_width="match_parent"
                android:layout_height="@dimen/p5d_border_small"
                android:layout_marginTop="@dimen/bottom_sheet_peek_height"
                app:layout_constraintTop_toTopOf="parent"/>
            <ViewFlipper
                android:id="@+id/itemPropertiesViewFlipper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="true"
                app:layout_constraintTop_toBottomOf="@+id/itemPropertiesGuideline">
                <include
                    android:id="@+id/itemPropertiesDesignSize"
                    layout="@layout/fragment_item_properties_view_pager"/>
                <include
                    android:id="@+id/itemPropertiesTextureSelector"
                    layout="@layout/fragment_item_properties_texture_selector"/>
            </ViewFlipper>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/itemPropertiesPreloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/itemPropertiesAnchor"
        android:layout_width="1dp"
        android:layout_height="0dp"/>
</FrameLayout>
