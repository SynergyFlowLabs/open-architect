<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_dialog_white_outline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="320dp">
    <ImageView
        android:id="@+id/authenticationStayInTouchPicture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:src="@drawable/icon_newsletter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/authenticationStayInTouchClose"
        android:background="@drawable/ripple_round"
        android:padding="@dimen/p5d_space_x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_close_button"/>
    <TextView
        android:textSize="@dimen/font_size_very_very_big"
        android:gravity="center_horizontal"
        android:id="@+id/authenticationStayInTouchTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:text="@string/stay_in_touch"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toTopOf="@+id/authenticationStayInTouchAgreement"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/authenticationStayInTouchPicture"
        style="@style/Planner5D.TextView.Bold"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_grey_1"
        android:gravity="center"
        android:id="@+id/authenticationStayInTouchAgreement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:text="@string/newsletter_agreement_agree_tips"
        android:letterSpacing="@dimen/p5d_letter_spacing_large"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toTopOf="@+id/authenticationStayInTouchFinish"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/authenticationStayInTouchTitle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/authenticationStayInTouchFinish"
        android:background="@drawable/gradient_green"
        android:layout_width="245dp"
        android:layout_marginTop="@dimen/p5d_space_large"
        android:layout_marginBottom="@dimen/p5d_space_20"
        android:foreground="@drawable/ripple_rounded_corners"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/authenticationStayInTouchAgreement"
        style="@style/Planner5D.NewsletterAgreement.Button">
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@android:color/white"
            android:id="@+id/authenticationStayInTouchFinishLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/newsletter_agreement_agree"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
        <ProgressBar
            android:theme="@style/progressBarWhite"
            android:id="@+id/authenticationStayInTouchSpinner"
            android:visibility="invisible"
            android:layout_width="@dimen/p5d_space_x_small"
            android:layout_height="@dimen/p5d_space_x_small"
            android:layout_marginLeft="@dimen/p5d_space_tiny"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/authenticationStayInTouchFinishLabel"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
