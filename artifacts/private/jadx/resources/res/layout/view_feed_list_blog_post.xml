<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.Planner5D.MaterialCard.Material"
    android:id="@+id/imageWrapper"
    android:tag="layout/view_feed_list_blog_post_0"
    android:layout_width="@dimen/feed_blog_card_width"
    android:layout_height="@dimen/feed_blog_card_height"
    android:layout_marginTop="@dimen/p5d_space_xxx_small"
    android:layout_marginBottom="@dimen/p5d_space_medium"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginStart="@dimen/p5d_space_xxx_small"
    android:layout_marginEnd="@dimen/p5d_space_xxx_small"
    android:stateListAnimator="@animator/card_press"
    app:cardCornerRadius="@dimen/p5d_corner_radius_large"
    app:cardElevation="@dimen/p5d_elevation_large">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/feed_blog_image_height"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:ellipsize="end"
            android:id="@+id/title"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:lines="2"
            android:layout_below="@+id/image"
            android:paddingStart="@dimen/p5d_space_x_small"
            android:paddingEnd="@dimen/p5d_space_x_small"
            android:layout_alignStart="@+id/image"
            android:layout_alignEnd="@+id/image"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textSize="@dimen/font_size_small"
            android:textColor="@color/p5d_grey"
            android:ellipsize="end"
            android:gravity="bottom"
            android:tag="binding_2"
            android:paddingBottom="@dimen/p5d_space_x_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            android:lines="3"
            android:layout_below="@+id/title"
            android:layout_alignParentBottom="true"
            android:paddingStart="@dimen/p5d_space_x_small"
            android:paddingEnd="@dimen/p5d_space_x_small"
            android:layout_alignStart="@+id/image"
            android:layout_alignEnd="@+id/image"
            style="@style/Planner5D.TextView"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
