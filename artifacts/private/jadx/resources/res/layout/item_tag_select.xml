<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:textColor="@color/tag_text_color"
        android:id="@+id/tag_title"
        android:background="@drawable/background_tag"
        android:paddingTop="@dimen/p5d_space_x_tiny"
        android:paddingBottom="@dimen/p5d_space_x_tiny"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingStart="@dimen/p5d_space_tiny"
        android:paddingEnd="@dimen/p5d_space_tiny"/>
</FrameLayout>
