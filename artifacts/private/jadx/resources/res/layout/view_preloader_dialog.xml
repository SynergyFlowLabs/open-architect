<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/background_preloader_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/p5d_space_medium">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/preloaderCircleBackground"
            android:padding="6dp"
            android:layout_width="48dp"
            android:layout_height="48dp">
            <com.planner5d.library.widget.preloader.PreloaderBarView
                android:id="@+id/preloaderCircle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:color="@color/p5d_primary"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/font_size_normal"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/preloaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/p5d_space_xx_small"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            android:layout_marginRight="@dimen/p5d_space_xx_small"
            android:minWidth="96dp"
            style="@style/Planner5D.TextView.Medium"/>
    </LinearLayout>
</merge>
