<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_grey_1"
        android:id="@+id/resizeTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_20"
        android:text="@string/wall_resize_type_label"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
    <com.planner5d.library.widget.ButtonWallResizeV2
        android:id="@+id/resizeType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resizeTypeLabel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
