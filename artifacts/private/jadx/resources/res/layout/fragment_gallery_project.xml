<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_gallery_project_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/title"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.GalleryTitle"/>
    <com.planner5d.library.widget.ProfileIconView
        android:id="@+id/avatar"
        android:layout_width="@dimen/p5d_space_large"
        android:layout_height="@dimen/p5d_space_large"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        app:imageSize="@dimen/p5d_space_large"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:id="@+id/author"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_xx_small"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        style="@style/Planner5D.TextView.Username"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        app:layout_constraintDimensionRatio="36:27"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/shot_number"
        android:background="@drawable/background_black_70_rounded"
        android:layout_width="@dimen/p5d_space_xx_large"
        android:layout_height="@dimen/p5d_space_20"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        android:letterSpacing="@dimen/p5d_letter_spacing_x_large"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:layout_constraintTop_toTopOf="@+id/preview"
        style="@style/Planner5D.Font.Medium"/>
    <com.planner5d.library.widget.PinsIndicator
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:layout_constraintStart_toStartOf="@+id/preview"
        app:layout_constraintTop_toBottomOf="@+id/preview"/>
    <TextView
        android:id="@+id/views"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        app:drawableStartCompat="@drawable/icon_views"
        app:layout_constraintEnd_toStartOf="@+id/likes"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/preview"
        style="@style/Planner5D.TextView.Likes"/>
    <TextView
        android:id="@+id/likes"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        app:drawableStartCompat="@drawable/icon_favorite_small"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/views"
        app:layout_constraintTop_toBottomOf="@+id/preview"
        style="@style/Planner5D.TextView.Likes"/>
    <com.planner5d.library.widget.previewtoolbar.PreviewToolbar
        android:id="@+id/menu"
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/open"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/title">
        <com.planner5d.library.widget.previewtoolbar.PreviewToolbarItem
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iconSrc="@drawable/icon_download"/>
        <com.planner5d.library.widget.previewtoolbar.PreviewToolbarItem
            android:id="@+id/share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iconSrc="@drawable/icon_share"/>
        <com.planner5d.library.widget.previewtoolbar.PreviewToolbarItem
            android:id="@+id/favourite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.planner5d.library.widget.previewtoolbar.PreviewToolbar>
    <Button
        android:id="@+id/open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_in_3d"
        app:layout_constraintBottom_toBottomOf="@+id/menu"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/menu"
        app:layout_constraintTop_toTopOf="@+id/menu"
        style="@style/Planner5D.Button.GreenRounded"/>
</androidx.constraintlayout.widget.ConstraintLayout>
