<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="560dp"
            style="@style/Planner5D.ProfileEdit.Content">
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:textColorHint="@color/p5d_grey_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:hint="@string/profile_current_password"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:endIconMode="password_toggle"
                app:errorIconDrawable="@null"
                app:errorTextAppearance="@style/ErrorTextStyle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:theme="@style/Theme.Planner5D.Form.Material"
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/p5d_text"
                    android:id="@+id/profileEditPasswordCurrentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:inputType="textPassword"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
                    app:lineHeight="20dp"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:textColorHint="@color/p5d_grey_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="116dp"
                android:hint="@string/profile_new_password"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:endIconMode="password_toggle"
                app:errorIconDrawable="@null"
                app:errorTextAppearance="@style/ErrorTextStyle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:theme="@style/Theme.Planner5D.Form.Material"
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/p5d_text"
                    android:id="@+id/profileEditPasswordNewInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:inputType="textPassword"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
                    app:lineHeight="20dp"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:textColorHint="@color/p5d_grey_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="204dp"
                android:hint="@string/profile_confirm_password"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:endIconMode="password_toggle"
                app:errorIconDrawable="@null"
                app:errorTextAppearance="@style/ErrorTextStyle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:theme="@style/Theme.Planner5D.Form.Material"
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/p5d_text"
                    android:id="@+id/profileEditPasswordRepeatInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:inputType="textPassword"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
                    app:lineHeight="20dp"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/button_text_default"
                android:gravity="center"
                android:id="@+id/profileEditPasswordButton"
                android:background="@drawable/background_button_default"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_xx_large"
                android:layout_marginTop="304dp"
                android:layout_marginBottom="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/change_password"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/profileEditPasswordPreloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
