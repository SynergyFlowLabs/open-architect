<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/city"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="@color/neutral.text.alpha"
        android:id="@+id/skip"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_rounded_corners"
        android:text="@string/skip"
        android:layout_marginEnd="6dp"
        android:paddingHorizontal="@dimen/p5d_space_x_small"
        android:paddingVertical="@dimen/p5d_space_xx_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Text.Title_Small"/>
    <TextView
        android:textColor="@color/text.alpha"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_large"
        android:text="@string/spaces_onboarding_address_page_title"
        android:letterSpacing="-0.021"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skip"
        style="@style/Planner5D.Text.Headline_Small_W2"/>
    <TextView
        android:textColor="@color/text.beta"
        android:gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/spaces_onboarding_address_page_text"
        android:letterSpacing="-0.001"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        android:lineHeight="@dimen/p5d_space_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Planner5D.Text.Body_Medium"/>
    <com.google.android.material.textfield.TextInputLayout
        android:textColorHint="@color/text.gamma"
        android:id="@+id/address_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:hint="@string/spaces_onboarding_address_search_hint"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:errorIconDrawable="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        style="@style/Planner5D.TextInputLayout.Material.Round">
        <com.planner5d.library.widget.TextInputEditTextCompat
            android:id="@+id/address_input"
            android:paddingTop="@dimen/p5d_space_x_small"
            android:paddingBottom="@dimen/p5d_space_x_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/p5d_space_xx_small"
            android:inputType="text"
            android:drawableStart="@drawable/icon_search_forward"
            android:transitionName="firstTransitionName"
            android:letterSpacing="@dimen/p5d_letter_spacing_default"/>
    </com.google.android.material.textfield.TextInputLayout>
    <View
        android:id="@+id/input_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/address_input_layout"
        app:layout_constraintEnd_toEndOf="@+id/address_input_layout"
        app:layout_constraintStart_toStartOf="@+id/address_input_layout"
        app:layout_constraintTop_toTopOf="@+id/address_input_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
