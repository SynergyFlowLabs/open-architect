<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Authentication.Content">
        <ImageView
            android:id="@+id/authenticationPrivacyIcon"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:layout_marginBottom="@dimen/p5d_space_xx_small"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_privacy"/>
        <TextView
            android:textSize="@dimen/font_size_small"
            android:id="@+id/authenticationPrivacyMessage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            app:layout_constraintTop_toBottomOf="@+id/authenticationPrivacyIcon"/>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:id="@+id/authenticationPrivacyMessage2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            app:layout_constraintTop_toBottomOf="@+id/authenticationPrivacyMessage"/>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:textColor="@color/p5d_error"
            android:gravity="center"
            android:id="@+id/authenticationPrivacyError"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/p5d_space_x_tiny"
            android:text="@string/error_sign_in_label"
            app:layout_constraintBottom_toTopOf="@+id/authenticationPrivacyContinue"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/authenticationPrivacyContinue"
            android:background="@drawable/background_button_default"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_large"
            android:layout_marginTop="@dimen/p5d_space_20"
            android:layout_marginBottom="@dimen/p5d_space_20"
            android:foreground="@drawable/ripple_rounded_corners"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/authenticationPrivacyMessage2"
            app:layout_constraintVertical_bias="1">
            <TextView
                android:textSize="@dimen/font_size_small"
                android:textColor="@android:color/white"
                android:id="@+id/authenticationPrivacyContinueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/i_agree"
                android:textAllCaps="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
            <ProgressBar
                android:theme="@style/progressBarWhite"
                android:id="@+id/authenticationPrivacySpinner"
                android:visibility="invisible"
                android:layout_width="@dimen/p5d_space_x_small"
                android:layout_height="@dimen/p5d_space_x_small"
                android:layout_marginLeft="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/authenticationPrivacyContinueLabel"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
