<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_round"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/p5d_space_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/rate_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_xxx_small"
            android:src="@drawable/img_rate_us"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_close_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:text="@string/rate_us_title"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rate_image"
            style="@style/Planner5D.Title"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:gravity="center"
            android:id="@+id/rate_us_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_xxx_small"
            android:text="@string/rate_us_message"
            android:letterSpacing="@dimen/p5d_letter_spacing_extra"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textColor="@color/button_text_default"
            android:id="@+id/button_save"
            android:background="@drawable/background_button_green_gradient_radius_4"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_xx_large"
            android:layout_marginTop="@dimen/p5d_space_large"
            android:text="@string/rate_us"
            android:textAllCaps="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rate_us_message"
            style="@style/Planner5D.Button.GreenRounded"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
