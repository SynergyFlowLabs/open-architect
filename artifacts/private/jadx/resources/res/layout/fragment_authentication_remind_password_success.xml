<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.Authentication.FullScreenContent">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/authenticationRemindPasswordSuccessImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/authenticationRemindPasswordSuccessTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:srcCompat="@drawable/icon_email_success"/>
            <TextView
                android:textSize="32dp"
                android:textColor="@color/p5d_text"
                android:gravity="center_horizontal"
                android:id="@+id/authenticationRemindPasswordSuccessTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/p5d_space_40"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:layout_marginRight="@dimen/p5d_space_40"
                android:text="@string/forgot_password_new_password_sent"
                app:layout_constraintBottom_toTopOf="@+id/authenticationRemindPasswordSuccessDescription"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationRemindPasswordSuccessImage"
                style="@style/Planner5D.TextView.Bold"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_grey"
                android:gravity="center_horizontal"
                android:id="@+id/authenticationRemindPasswordSuccessDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:layout_marginRight="30dp"
                android:layout_marginBottom="100dp"
                android:maxWidth="350dp"
                android:text="@string/forgot_password_instructions"
                android:lineHeight="22dp"
                app:layout_constraintBottom_toTopOf="@+id/authenticationRemindPasswordSuccessButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationRemindPasswordSuccessTitle"
                style="@style/Planner5D.TextView"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/authenticationRemindPasswordSuccessButton"
                android:background="@drawable/background_button_default"
                android:layout_width="match_parent"
                android:layout_height="@dimen/authentication_button_height"
                android:layout_marginBottom="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/sign_in"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
