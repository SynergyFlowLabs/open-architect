<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_white">
    <com.planner5d.library.widget.RoundedCornersLayout
        android:id="@+id/image_wrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/ripple_rounded_corners_medium"
        app:cornerRadius="@dimen/p5d_corner_radius_medium"
        app:layout_constraintDimensionRatio="32:25"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_grey"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_huge"/>
    </com.planner5d.library.widget.RoundedCornersLayout>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_huge"
        android:singleLine="true"
        android:paddingStart="@dimen/p5d_space_x_small"
        android:paddingEnd="@dimen/p5d_space_x_small"
        android:letterSpacing="@dimen/p5d_letter_spacing_medium"
        app:layout_constraintBottom_toBottomOf="@+id/image_wrapper"
        app:layout_constraintEnd_toStartOf="@+id/favorite"
        app:layout_constraintStart_toStartOf="@+id/image_wrapper"
        style="@style/Planner5D.Font.Medium"/>
    <ImageView
        android:id="@+id/favorite"
        android:background="@drawable/ripple_favorite"
        android:padding="@dimen/p5d_space_x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="@+id/image_wrapper"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <com.planner5d.library.widget.ProfileIconView
        android:id="@+id/avatar"
        android:layout_width="@dimen/gallery_profile_icon_size"
        android:layout_height="@dimen/gallery_profile_icon_size"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:layout_marginBottom="@dimen/p5d_space_tiny"
        app:imageSize="@dimen/gallery_profile_icon_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/author"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_wrapper"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/p5d_text"
        android:ellipsize="end"
        android:id="@+id/author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        android:letterSpacing="@dimen/p5d_letter_spacing_large"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toStartOf="@+id/views"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        style="@style/Planner5D.Font.Medium"/>
    <TextView
        android:id="@+id/views"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        app:drawableStartCompat="@drawable/icon_views"
        app:layout_constraintBaseline_toBaselineOf="@+id/author"
        app:layout_constraintEnd_toStartOf="@+id/likes"
        app:layout_constraintStart_toEndOf="@+id/author"
        style="@style/Planner5D.TextView.Likes"/>
    <TextView
        android:id="@+id/likes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_xxx_small"
        app:drawableStartCompat="@drawable/icon_favorite_small"
        app:layout_constraintBaseline_toBaselineOf="@+id/author"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/views"
        style="@style/Planner5D.TextView.Likes"/>
</androidx.constraintlayout.widget.ConstraintLayout>
