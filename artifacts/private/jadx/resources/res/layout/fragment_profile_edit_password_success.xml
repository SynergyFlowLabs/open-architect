<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:padding="@dimen/p5d_space_20"
        android:layout_width="match_parent"
        android:maxWidth="704dp"
        style="@style/Planner5D.ProfileEdit.SuccessContent">
        <androidx.constraintlayout.helper.widget.Flow
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="passwordChangedImage,passwordChangedText"
            app:flow_verticalGap="@dimen/profile_edit_password_success_title_top_margin"
            app:layout_constraintBottom_toTopOf="@+id/passwordChangedButton"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/passwordChangedImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="2:1"
            app:srcCompat="@drawable/icon_email_success"/>
        <TextView
            android:textSize="32dp"
            android:gravity="center"
            android:id="@+id/passwordChangedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_password_changed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Planner5D.TextView.Bold"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/passwordChangedButton"
            android:background="@drawable/background_button_green"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_xx_large"
            android:foreground="@drawable/ripple_rounded_corners"
            android:text="@string/done"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
