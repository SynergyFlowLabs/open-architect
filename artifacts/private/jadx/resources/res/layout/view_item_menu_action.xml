<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/p5d_space_xx_large"
    android:layout_marginBottom="@dimen/p5d_space_tiny"
    android:paddingStart="@dimen/p5d_space_20"
    android:paddingEnd="@dimen/p5d_space_20">
    <ImageView
        android:id="@+id/bottomSheetItemIcon"
        android:layout_width="@dimen/p5d_space_medium"
        android:layout_height="@dimen/p5d_space_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/neutral.text.alpha"
        android:id="@+id/bottomSheetItemText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bottomSheetItemIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Text.Body_Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
