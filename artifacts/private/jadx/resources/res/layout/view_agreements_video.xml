<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.planner5d.library.widget.VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="642:1388"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/agreements_fade_out"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:layout_marginBottom="@dimen/p5d_space_x_small"
        android:text="@string/new_welcome_title"
        app:layout_constraintBottom_toTopOf="@+id/buttonContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.Agreements.Title"/>
    <com.planner5d.library.widget.RoundedCornersLayout
        android:id="@+id/buttonContinue"
        android:layout_width="@dimen/agreements_button_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:layout_marginBottom="@dimen/agreements_button_bottom_padding"
        android:foreground="@drawable/ripple_rounded_corners"
        android:layout_marginStart="@dimen/agreements_button_padding"
        android:layout_marginEnd="@dimen/agreements_button_padding"
        app:cornerRadius="22dp"
        app:layout_constraintBottom_toTopOf="@+id/agreementsLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/button_text_default"
            android:gravity="center"
            android:id="@+id/buttonText"
            android:background="@drawable/agreements_button_selector"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/welcome_lets_start"
            android:textAllCaps="false"
            style="@style/Planner5D.TextView"/>
    </com.planner5d.library.widget.RoundedCornersLayout>
    <TextView
        android:textColor="@color/p5d_grey_3"
        android:gravity="center_horizontal"
        android:id="@+id/agreementsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/agreements_button_bottom_padding"
        android:text="@string/new_welcome_terms_and_conditions_format"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        android:breakStrategy="simple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.TextView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
