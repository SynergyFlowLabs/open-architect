<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/p5d_space_xx_small"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/font_size_very_very_big"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/room_wizard_decorator_tool_categories_selection_title"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Bold"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/elements_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_xx_small"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:flow_horizontalGap="@dimen/p5d_space_xx_small"
            app:flow_horizontalStyle="packed"
            app:flow_verticalGap="@dimen/p5d_space_xx_small"
            app:flow_wrapMode="chain"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/button_decorate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_large"
            android:layout_marginBottom="@dimen/p5d_space_large"
            android:text="@string/ai_designer_decorator"
            android:drawablePadding="@dimen/p5d_space_tiny"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:icon="@drawable/icon_sparkles"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/elements_list"
            style="@style/Planner5D.UnelevatedButton"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_refresh"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_large"
            android:layout_marginBottom="@dimen/p5d_space_large"
            android:text="@string/refresh"
            android:drawablePadding="@dimen/p5d_space_tiny"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_tiny"
            app:icon="@drawable/icon_refresh_24"
            app:iconGravity="textStart"
            app:iconTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/elements_list"
            style="@style/Planner5D.UnelevatedButton.Neutral"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_large"
            android:layout_marginBottom="@dimen/p5d_space_large"
            android:text="@string/save"
            android:drawablePadding="@dimen/p5d_space_tiny"
            android:layout_marginStart="@dimen/p5d_space_tiny"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:icon="@drawable/icon_check_24"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guideline"
            app:layout_constraintTop_toBottomOf="@+id/elements_list"
            style="@style/Planner5D.UnelevatedButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.planner5d.library.widget.preloader.PreloaderDialogView
        android:id="@+id/preloader_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
