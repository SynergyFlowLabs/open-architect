<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/profileAuthenticationLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="@dimen/profile_action_card_max_width"
    android:paddingStart="@dimen/p5d_space_20"
    android:paddingEnd="@dimen/p5d_space_20">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileAuthenticationFinish"
        android:padding="@dimen/p5d_space_tiny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_large"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/p5d_orange"
            android:gravity="start"
            android:id="@+id/profileAuthenticationPayAttentionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/pay_attention"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            android:layout_marginEnd="@dimen/p5d_space_x_tiny"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/profileAuthenticationIcon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textColor="@color/p5d_grey"
            android:gravity="start"
            android:id="@+id/profileAuthenticationWarningText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_tiny"
            android:text="@string/profile_finish_sing_up"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            android:layout_marginEnd="@dimen/p5d_space_x_tiny"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/profileAuthenticationIcon"
            app:layout_constraintTop_toBottomOf="@+id/profileAuthenticationPayAttentionText"
            style="@style/Planner5D.TextView"/>
        <ImageView
            android:id="@+id/profileAuthenticationIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_warning"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/p5d_orange"
            android:gravity="center"
            android:id="@+id/profileAuthenticationFinishButton"
            android:background="@drawable/background_button_border_orange_rounded"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_xx_large"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:foreground="@drawable/ripple_rounded_corners_huge"
            android:text="@string/finish_registration"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/profileAuthenticationWarningText"
            style="@style/Planner5D.TextView.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.planner5d.library.widget.textview.TextViewWithLine
        android:textColor="@color/p5d_grey"
        android:gravity="center"
        android:id="@+id/profileAuthenticationOr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:text="@string/or"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:capitalizeFirstChar="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileAuthenticationFinish"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_primary"
        android:gravity="center"
        android:id="@+id/profileAuthenticationLoginButton"
        android:background="@drawable/background_button_border_green_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/sign_in"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileAuthenticationOr"
        style="@style/Planner5D.TextView.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
