<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/contestRulesAgreementCancel"
        android:background="@drawable/background_button_white_medium"
        android:layout_width="@dimen/p5d_space_large"
        android:layout_height="@dimen/p5d_space_large"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:foreground="@drawable/ripple_rounded_corners_medium"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_back_32"
        app:tint="@color/p5d_grey_1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contestRulesAgreementDialog"
        android:background="@color/white_75"
        android:paddingBottom="@dimen/p5d_space_x_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:textSize="@dimen/font_size_very_very_very_very_big"
            android:id="@+id/contestRulesAgreementTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/p5d_space_20"
            android:layout_marginTop="17dp"
            android:layout_marginRight="@dimen/p5d_space_medium"
            android:text="@string/desing_contest_editor_title_nice_work"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Bold"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:id="@+id/contestRulesAgreementSubtitle"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_xx_large"
            android:layout_marginTop="10dp"
            android:text="@string/desing_contest_submit_subtitle"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contestRulesAgreementTitle"
            style="@style/Planner5D.TextView"/>
        <ImageView
            android:id="@+id/contestRulesAgreementArrowDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contestRulesAgreementSubtitle"
            app:srcCompat="@drawable/icon_arrow_down_24"/>
        <com.planner5d.library.widget.UrlSwitchCompat
            android:textSize="@dimen/font_size_small"
            android:textColor="@color/p5d_grey"
            android:id="@+id/contestRulesAgreementCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingStart="@dimen/p5d_space_tiny"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contestRulesAgreementArrowDown"
            style="@style/Planner5D.TextView"/>
        <com.planner5d.library.widget.textview.ButtonTextView
            android:textColor="@color/button_text_default"
            android:gravity="center"
            android:id="@+id/contestRulesAgreementContinue"
            android:background="@drawable/background_button_default_gradient"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_xx_large"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="@dimen/p5d_space_x_small"
            android:foreground="@drawable/ripple_rounded_corners_huge"
            android:text="@string/contest_submit"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contestRulesAgreementCheckBox"
            style="@style/Planner5D.TextView.Medium"/>
        <ProgressBar
            android:theme="@style/progressBarWhite"
            android:id="@+id/contestRulesAgreementSpinner"
            android:visibility="invisible"
            android:layout_width="@dimen/p5d_space_x_small"
            android:layout_height="@dimen/p5d_space_x_small"
            app:layout_constraintBottom_toBottomOf="@+id/contestRulesAgreementContinue"
            app:layout_constraintEnd_toEndOf="@+id/contestRulesAgreementContinue"
            app:layout_constraintStart_toStartOf="@+id/contestRulesAgreementContinue"
            app:layout_constraintTop_toTopOf="@+id/contestRulesAgreementContinue"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
