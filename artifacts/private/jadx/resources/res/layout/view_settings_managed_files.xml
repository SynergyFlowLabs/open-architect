<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/managedFilesTitle"
        android:text="@string/files_on_device"
        app:drawableStartCompat="@drawable/icon_chart_donut"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Header.Material"/>
    <TextView
        android:textSize="@dimen/manage_data_text"
        android:id="@+id/download_mode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_20"
        android:lineSpacingExtra="@dimen/manage_data_text_extra_spacing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/managedFilesTitle"
        style="@style/Planner5D.TextView"/>
    <ProgressBar
        android:layout_gravity="top|left"
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:progressDrawable="@drawable/progress_green"
        app:layout_constraintTop_toBottomOf="@+id/download_mode"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="@dimen/manage_data_text_small"
        android:textColor="@color/form_text_color"
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/manage_data_padding_files_size"
        app:layout_constraintTop_toBottomOf="@+id/bar"
        style="@style/Planner5D.TextView.Bold"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/black"
        android:id="@+id/warning_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/status"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/error"
        android:id="@+id/error_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/warning_message"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:textSize="@dimen/manage_data_text_button"
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginTop="@dimen/manage_data_padding_files_download"
        android:text="@string/save"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@+id/error_message"/>
</merge>
