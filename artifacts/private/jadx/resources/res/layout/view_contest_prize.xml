<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <ImageView
        android:id="@+id/contestPrizeImage"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:id="@+id/contestPrizeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5.5dp"
        android:textAlignment="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contestPrizeImage"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/contestPrizeQuantity"
        android:background="@drawable/background_button_yellow_bordered"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginBottom="-2dp"
        android:layout_marginEnd="-2dp"
        android:paddingHorizontal="6.45dp"
        app:layout_constraintBottom_toBottomOf="@+id/contestPrizeImage"
        app:layout_constraintEnd_toEndOf="@+id/contestPrizeImage"
        style="@style/Planner5D.TextView.Bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
