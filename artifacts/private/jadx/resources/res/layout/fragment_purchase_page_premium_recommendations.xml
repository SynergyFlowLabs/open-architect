<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/purchasePremiumScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:paddingBottom="@dimen/p5d_space_medium"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/content_max_width"
        android:paddingStart="@dimen/p5d_space_x_small"
        android:paddingEnd="@dimen/p5d_space_x_small">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/purchase_premium_recommendations_logo_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/purchase_with_cards_top_margin"
            android:src="@drawable/icon_logo_full_black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/purchasePremiumTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_tiny"
            android:text="@string/purchases_card_layout_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo"
            app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"
            style="@style/Planner5D.PurchasePremiumRecommendations.Header"/>
        <TextView
            android:textColor="@color/p5d_eerie_black"
            android:gravity="center"
            android:id="@+id/purchasePremiumComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:layout_marginBottom="@dimen/purchase_premium_recommendations_subtitle_padding"
            android:text="@string/purchases_card_layout_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumTitle"
            app:layout_constraintWidth_max="@dimen/purchase_premium_recommendations_max_width"
            style="@style/Planner5D.PurchasePremiumRecommendations.Comment"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/purchasePremiumProducts"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumComment"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="@dimen/purchase_premium_recommendations_max_width">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/purchasePremiumList"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.planner5d.library.widget.preloader.PreloaderCoverView
                android:id="@+id/purchasePremiumProductListPreloader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/error"
                android:gravity="center"
                android:id="@+id/purchasePremiumErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/p5d_space_medium"
                android:layout_marginEnd="@dimen/p5d_space_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.helper.widget.Flow
            android:orientation="horizontal"
            android:id="@+id/purchaseTermsFlow"
            android:paddingTop="@dimen/purchase_recommendations_terms_margin_top"
            android:paddingBottom="@dimen/purchase_terms_margin_bottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="purchasePremiumTerms,purchasePremiumPrivacy,purchasePremiumRestore"
            app:flow_horizontalStyle="packed"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProducts"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/p5d_grey_2"
            android:id="@+id/purchasePremiumTerms"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy_message_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/purchasePremiumPrivacy"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProducts"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/p5d_grey_2"
            android:id="@+id/purchasePremiumPrivacy"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy_policy"
            app:layout_constraintEnd_toStartOf="@+id/purchasePremiumRestore"
            app:layout_constraintStart_toEndOf="@+id/purchasePremiumTerms"
            app:layout_constraintTop_toTopOf="@+id/purchasePremiumTerms"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/p5d_grey_2"
            android:id="@+id/purchasePremiumRestore"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchases_button_restore"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/purchasePremiumPrivacy"
            app:layout_constraintTop_toTopOf="@+id/purchasePremiumTerms"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
