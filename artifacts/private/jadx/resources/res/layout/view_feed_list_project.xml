<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_feed_list_project_0"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:theme="@style/Theme.Planner5D.MaterialCard.Material"
        android:id="@+id/imageWrapper"
        android:layout_width="@dimen/feed_projects_image_size"
        android:layout_height="@dimen/feed_projects_image_size"
        android:layout_marginTop="@dimen/p5d_space_xxx_small"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginStart="@dimen/p5d_space_xxx_small"
        android:layout_marginEnd="@dimen/p5d_space_xxx_small"
        android:stateListAnimator="@animator/card_press"
        app:cardCornerRadius="@dimen/p5d_corner_radius_large"
        app:cardElevation="@dimen/p5d_elevation_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/image"
            android:layout_width="@dimen/feed_projects_image_size"
            android:layout_height="@dimen/feed_projects_image_size"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:ellipsize="end"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="@+id/imageWrapper"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="@+id/imageWrapper"
        app:layout_constraintTop_toBottomOf="@+id/imageWrapper"
        style="@style/Planner5D.TextView"/>
    <View
        android:id="@+id/blocker"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="@dimen/p5d_elevation_large"
        android:outlineProvider="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Blocker"/>
</androidx.constraintlayout.widget.ConstraintLayout>
