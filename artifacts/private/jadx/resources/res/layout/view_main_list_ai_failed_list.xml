<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/ripple_white">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:padding="@dimen/p5d_border"
        android:layout_width="@dimen/p5d_main_list_button_icon_size"
        android:layout_height="@dimen/p5d_main_list_button_icon_size"
        android:layout_marginTop="@dimen/p5d_space_xxx_small"
        android:layout_marginBottom="@dimen/p5d_space_xxx_small"
        android:foreground="?attr/selectableItemBackground"
        android:src="@drawable/icon_exclamation_triangle"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/Planner5D.ShapeAppearance.Round.Material"
        app:strokeColor="@color/p5d_grey_5"
        app:strokeWidth="@dimen/p5d_border"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ai_recognition_failed"
        android:layout_marginStart="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintEnd_toStartOf="@+id/buttonMenu"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"
        style="@style/Planner5D.TextView.Item"/>
    <TextView
        android:id="@+id/summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Planner5D.TextView.Meta"/>
    <ImageButton
        android:id="@+id/buttonMenu"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="@dimen/p5d_space_large"
        android:layout_height="@dimen/p5d_space_large"
        android:foreground="@drawable/ripple_rounded_corners"
        android:src="@drawable/icon_menu_list"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintBottom_toBottomOf="@+id/summary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:tint="@color/p5d_grey_3"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_x_tiny"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
