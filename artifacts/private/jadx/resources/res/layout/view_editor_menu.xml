<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/editor_toolbar"
        android:background="@drawable/background_editor_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:layout_marginBottom="@dimen/p5d_space_tiny"
        android:divider="@drawable/divider_editor_toolbar"
        android:showDividers="middle"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        android:elevation="@dimen/p5d_elevation_medium"
        android:layout_marginHorizontal="@dimen/p5d_space_tiny"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/additional_buttons"
        android:background="@drawable/background_editor_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:layout_marginBottom="@dimen/p5d_space_tiny"
        android:divider="@drawable/divider_editor_toolbar"
        android:showDividers="middle"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        android:elevation="@dimen/p5d_elevation_medium"
        android:layout_marginHorizontal="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editor_toolbar"/>
    <ImageView
        android:id="@+id/bernard_button"
        android:layout_width="@dimen/p5d_space_x_large"
        android:layout_height="@dimen/p5d_space_x_large"
        android:layout_marginTop="@dimen/p5d_space_xxx_small"
        android:src="@drawable/icon_ai_chat"
        android:contentDescription="@string/ai_chat_im_bernard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editor_toolbar"/>
</merge>
