<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttons"
        android:background="@drawable/background_white_round_large_top"
        android:paddingTop="14dp"
        android:paddingBottom="@dimen/p5d_space_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/p5d_elevation_large"
        android:paddingHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_scrollFlags="noScroll">
        <com.planner5d.library.widget.textview.ButtonTextView
            android:id="@+id/continue_with_pro"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_xx_small"
            android:text="@string/purchases_compare_continue_with_pro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.ButtonGreenGradient"/>
        <com.planner5d.library.widget.textview.ButtonTextView
            android:textSize="@dimen/font_size_very_small"
            android:textColor="@color/white"
            android:id="@+id/most_powerful"
            android:background="@drawable/gradient_pro_most_powerful"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="44dp"
            android:text="@string/purchases_compare_most_powerful"
            android:drawablePadding="4dp"
            android:layout_marginEnd="24dp"
            android:letterSpacing="-0.005"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            app:backgroundCornerRadius="@dimen/p5d_corner_radius_rounded"
            app:drawableStartCompat="@drawable/icon_yellow_stars"
            app:layout_constraintBottom_toBottomOf="@+id/continue_with_pro"
            app:layout_constraintEnd_toEndOf="@+id/continue_with_pro"
            style="@style/Planner5D.TextView.Medium"/>
        <com.planner5d.library.widget.textview.ButtonTextView
            android:textSize="@dimen/font_size_normal"
            android:textColor="@color/button_text_secondary"
            android:gravity="center"
            android:id="@+id/continue_with_premium"
            android:background="@drawable/background_button_light_green"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:layout_marginBottom="@dimen/p5d_space_medium"
            android:foreground="@drawable/ripple_rounded_corners"
            android:text="@string/purchases_compare_continue_with_premium"
            app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/continue_with_pro"
            style="@style/Planner5D.TextView.Medium"/>
        <Space
            android:id="@+id/space"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/continue_with_premium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
