<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.planner5d.library.widget.RoundedCornersLayout
        android:id="@+id/imageSliderLayoutWrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/imageSliderRight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/imageSliderLeft"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <View
            android:id="@+id/line"
            android:layout_width="@dimen/p5d_space_x_tiny"
            android:layout_height="match_parent"/>
    </com.planner5d.library.widget.RoundedCornersLayout>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/seekBar"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxHeight="1000dp"
        android:max="10000"
        android:progress="0"
        android:progressDrawable="@android:color/transparent"
        android:layout_centerVertical="true"
        android:layoutDirection="ltr"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/rightLabel"
        android:background="@drawable/background_button_semi_transparent_2"
        android:paddingTop="@dimen/p5d_space_xx_tiny"
        android:paddingBottom="@dimen/p5d_space_xx_tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/p5d_space_xx_small"
        android:minWidth="50dp"
        android:paddingStart="@dimen/p5d_space_tiny"
        android:paddingEnd="@dimen/p5d_space_tiny"
        android:layout_alignParentEnd="true"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/leftLabel"
        android:background="@drawable/background_button_semi_transparent_2"
        android:paddingTop="@dimen/p5d_space_xx_tiny"
        android:paddingBottom="@dimen/p5d_space_xx_tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/p5d_space_xx_small"
        android:minWidth="50dp"
        android:paddingStart="@dimen/p5d_space_tiny"
        android:paddingEnd="@dimen/p5d_space_tiny"
        android:layout_alignParentStart="true"
        style="@style/Planner5D.TextView.Medium"/>
    <com.planner5d.library.widget.preloader.PreloaderBoxView
        android:id="@+id/preloader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:color="@color/p5d_primary"/>
</merge>
