<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_main_list_new_project_grid_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/ripple_white">
    <androidx.cardview.widget.CardView
        android:id="@+id/imageWrapper"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:foreground="?attr/selectableItemBackground"
        android:stateListAnimator="@animator/card_press"
        app:cardCornerRadius="@dimen/p5d_corner_radius_large"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:background="@drawable/onboarding_green_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/white"
                android:id="@+id/titleCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/p5d_space_tiny"
                android:text="@string/new_project"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_small"
                android:textColor="@color/p5d_transparent_white_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_subtitle_new_project"
                android:layout_below="@+id/titleCard"
                android:layout_marginStart="@dimen/p5d_space_tiny"
                style="@style/Planner5D.TextView"/>
            <ImageView
                android:background="@drawable/icon_feed_projects_new"
                android:layout_width="@dimen/feed_plus_icon_size"
                android:layout_height="@dimen/feed_plus_icon_size"
                android:layout_marginTop="@dimen/p5d_space_tiny"
                android:layout_marginBottom="@dimen/p5d_space_tiny"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/p5d_space_tiny"
                android:layout_marginEnd="@dimen/p5d_space_tiny"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/clickableBack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_list_item_new"
        app:layout_constraintBottom_toBottomOf="@+id/clickableBack"
        app:layout_constraintEnd_toEndOf="@+id/clickableBack"
        app:layout_constraintStart_toStartOf="@+id/clickableBack"
        app:layout_constraintTop_toTopOf="@+id/clickableBack"/>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:text="@string/new_project"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clickableBack"
        style="@style/Planner5D.TextView.Item"/>
    <TextView
        android:id="@+id/summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        android:text="@string/tap_plus_to_get_started"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Planner5D.TextView.Meta"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_tiny"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
