<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/snapshotSetupVariants"
                android:paddingTop="@dimen/p5d_space_20"
                android:paddingBottom="@dimen/p5d_space_xxx_small"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/snapshotSetupCeilingLight"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/p5d_space_40"
                android:layout_marginTop="@dimen/p5d_space_x_tiny"
                android:paddingStart="@dimen/p5d_space_x_small"
                android:paddingEnd="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/snapshotSetupVariants"
                app:trackTint="@drawable/switch_track_color"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:gravity="center_vertical"
                android:id="@+id/snapshotCeiling"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/render_ceiling_lighting"
                android:layout_marginStart="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toStartOf="@+id/snapshotSetupCeilingLight"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/snapshotSetupCeilingLight"
                style="@style/Planner5D.TextView"/>
            <TextView
                android:textSize="@dimen/font_size_small"
                android:textColor="@color/p5d_grey_2"
                android:gravity="center_vertical"
                android:id="@+id/snapshotCeilingDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/render_ceiling_lighting_description"
                android:layout_marginStart="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toStartOf="@+id/snapshotSetupCeilingLight"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/snapshotCeiling"
                style="@style/Planner5D.TextView"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/snapshotSetupNightMode"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/p5d_space_40"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:paddingStart="@dimen/p5d_space_x_small"
                android:paddingEnd="@dimen/p5d_space_x_small"
                android:layout_marginStart="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/snapshotSetupCeilingLight"
                app:trackTint="@drawable/switch_track_color"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:gravity="center_vertical"
                android:id="@+id/snapshotSetupNightModeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xxx_tiny"
                android:text="@string/render_night_mode"
                android:layout_marginStart="@dimen/p5d_space_x_small"
                app:layout_constraintBottom_toTopOf="@+id/snapshotSetupNightModeDescription"
                app:layout_constraintEnd_toStartOf="@+id/snapshotSetupNightMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/snapshotSetupNightMode"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Planner5D.TextView"/>
            <TextView
                android:textSize="@dimen/font_size_small"
                android:textColor="@color/p5d_grey_2"
                android:gravity="center_vertical"
                android:id="@+id/snapshotSetupNightModeDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/render_night_mode_description"
                android:layout_marginStart="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toStartOf="@+id/snapshotSetupNightMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/snapshotSetupNightModeName"
                style="@style/Planner5D.TextView"/>
            <com.planner5d.library.widget.textview.ButtonTextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/snapshotSetupButton"
                android:background="@drawable/gradient_green"
                android:layout_width="320dp"
                android:layout_height="@dimen/p5d_space_xx_large"
                android:layout_margin="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_rounded_corners_huge"
                android:text="@string/upgrade_to_premium"
                app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/snapshotSetupNightMode"
                app:layout_constraintVertical_bias="1"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/preloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
