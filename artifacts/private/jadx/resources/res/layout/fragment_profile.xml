<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.planner5d.library.widget.scrollview.FlingableNestedScrollView
        android:id="@+id/profileScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/content_max_width">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <include
                    android:id="@+id/profileUserCard"
                    layout="@layout/fragment_profile_user_card"/>
                <include
                    android:id="@+id/profileAuthenticationLayout"
                    layout="@layout/fragment_profile_authentication"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/profileRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/p5d_primary"
                    android:gravity="center"
                    android:id="@+id/profileChangeUserButton"
                    android:background="@drawable/background_button_green_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/p5d_space_xx_large"
                    android:layout_marginTop="@dimen/p5d_space_medium"
                    android:foreground="@drawable/ripple_rounded_corners"
                    android:text="@string/change_user"
                    android:layout_marginHorizontal="@dimen/p5d_space_20"
                    style="@style/Planner5D.TextView.Medium"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/p5d_space_20"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.planner5d.library.widget.scrollview.FlingableNestedScrollView>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/profilePreloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
