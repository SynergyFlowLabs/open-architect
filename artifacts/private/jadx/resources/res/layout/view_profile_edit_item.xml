<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/profileEditItemIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/p5d_space_medium"
        app:layout_constraintBottom_toBottomOf="@+id/profileEditItemTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profileEditItemTitle"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:id="@+id/profileEditItemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        app:layout_constraintStart_toEndOf="@+id/profileEditItemIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/p5d_grey"
        android:id="@+id/profileEditItemAdditionalText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        android:maxLines="3"
        android:lines="@null"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/profileEditItemTitle"
        app:layout_constraintTop_toBottomOf="@+id/profileEditItemTitle"
        style="@style/Planner5D.TextView.Ellipsized"/>
    <View
        android:background="@color/p5d_grey_5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_border_small"
        android:layout_marginTop="10dp"
        android:layout_marginStart="@dimen/p5d_space_20"
        app:layout_constraintTop_toBottomOf="@+id/profileEditItemAdditionalText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
