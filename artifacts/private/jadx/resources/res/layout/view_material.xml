<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_gravity="start|bottom"
        android:id="@+id/image_container"
        android:padding="@dimen/p5d_border"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.planner5d.library.widget.editor.popup.properties.view.MaterialImageView
            android:layout_gravity="start|top"
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:layout_gravity="center"
            android:id="@+id/title_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/image_button"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerInside"
            style="?android:attr/borderlessButtonStyle"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/p5d_text"
        android:layout_gravity="start"
        android:id="@+id/title_material"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:maxLines="2"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8dp"
        android:autoSizeMaxTextSize="@dimen/font_size_small"/>
</merge>
