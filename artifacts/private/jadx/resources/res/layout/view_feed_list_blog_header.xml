<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_very_huge"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feed_all_articles"
        android:paddingHorizontal="@dimen/p5d_space_xxx_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Bold"/>
    <HorizontalScrollView
        android:orientation="horizontal"
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/p5d_space_xxx_small"
        android:nestedScrollingEnabled="false"
        android:paddingVertical="@dimen/p5d_space_20"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <CheckedTextView
                android:id="@+id/inspiration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/section_inspiration"
                style="@style/Planner5D.CategorySelector"/>
            <CheckedTextView
                android:id="@+id/for_your_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_for_your_home"
                style="@style/Planner5D.CategorySelector"/>
            <CheckedTextView
                android:id="@+id/tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_tips"
                style="@style/Planner5D.CategorySelector"/>
            <CheckedTextView
                android:id="@+id/videos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_videos"
                style="@style/Planner5D.CategorySelector"/>
        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
