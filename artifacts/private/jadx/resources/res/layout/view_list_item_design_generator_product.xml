<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/paywall_product"
        android:background="@drawable/background_design_generator_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:foreground="@drawable/ripple_rounded_corners_large"
        android:layout_marginHorizontal="@dimen/p5d_space_20">
        <ImageView
            android:id="@+id/paywall_product_check_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/check_mark_design_generator_product"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_size_normal"
            android:id="@+id/paywall_product_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:layout_marginStart="@dimen/p5d_space_tiny"
            app:layout_constraintStart_toEndOf="@+id/paywall_product_check_mark"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Bold"/>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:id="@+id/paywall_product_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_tiny"
            android:layout_marginBottom="@dimen/p5d_space_x_small"
            android:layout_marginStart="@dimen/p5d_space_tiny"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/paywall_product_check_mark"
            app:layout_constraintTop_toBottomOf="@+id/paywall_product_title"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/font_size_normal"
            android:id="@+id/paywall_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/p5d_space_x_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Bold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_very_small"
        android:textColor="@color/white"
        android:layout_gravity="end"
        android:id="@+id/paywall_product_most_popular_tag"
        android:background="@drawable/gradient_green"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/purchase_design_generator_popular"
        android:layout_marginEnd="28dp"
        android:paddingHorizontal="@dimen/p5d_space_xx_small"
        android:paddingVertical="@dimen/p5d_space_x_tiny"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_rounded"
        style="@style/Planner5D.Font.Medium"/>
</FrameLayout>
