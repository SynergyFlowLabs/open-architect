<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/purchasePremiumScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:paddingBottom="@dimen/p5d_space_medium"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/content_max_width"
        android:paddingStart="@dimen/p5d_space_x_small"
        android:paddingEnd="@dimen/p5d_space_x_small">
        <TextView
            android:id="@+id/purchasePremiumTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_large"
            android:text="@string/choose_your_plan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"
            style="@style/Planner5D.PurchasePremium.Header"/>
        <com.planner5d.library.widget.VectorRatingBar
            android:id="@+id/purchasePremiumRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:max="5"
            android:progressDrawable="@drawable/background_ratebar"
            android:rating="5"
            android:isIndicator="true"
            app:iconPadding="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumTitle"
            app:layout_constraintWidth_max="520dp"
            style="@style/Planner5D.PurchasePremium.VectorRatingBar"/>
        <TextView
            android:textColor="@color/p5d_eerie_black"
            android:gravity="center"
            android:id="@+id/purchasePremiumComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:text="@string/purchase_premium_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumRating"
            app:layout_constraintWidth_max="520dp"
            style="@style/Planner5D.PurchasePremium.Comment"/>
        <TextView
            android:gravity="center"
            android:id="@+id/purchasePremiumCommenter"
            android:padding="@dimen/p5d_space_x_tiny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            android:text="@string/purchase_premium_commenter"
            android:fontFamily="@font/roboto_regular_w400"
            app:layout_constraintEnd_toEndOf="@+id/purchasePremiumComment"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumComment"
            style="@style/Planner5D.PurchasePremium.Commenter"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/purchasePremiumProducts"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/purchasePremiumActionButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumCommenter"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/purchasePremiumList"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.planner5d.library.widget.preloader.PreloaderCoverView
                android:id="@+id/purchasePremiumProductListPreloader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/error"
                android:gravity="center"
                android:id="@+id/purchasePremiumErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/p5d_space_medium"
                android:layout_marginEnd="@dimen/p5d_space_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:enabled="false"
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/purchasePremiumActionButton"
            android:background="@drawable/background_button_default"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:foreground="@drawable/ripple_rounded_corners"
            android:text="@string/continue_premium_purchase"
            app:layout_constraintBottom_toTopOf="@+id/purchasePremiumTerms"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProducts"
            app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:id="@+id/purchasePremiumTerms"
            android:paddingTop="@dimen/p5d_space_x_tiny"
            android:paddingBottom="@dimen/p5d_space_x_tiny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ripple_rounded_corners"
            android:text="@string/privacy_message_title"
            android:fontFamily="@font/roboto_regular_w400"
            android:paddingStart="@dimen/p5d_space_xxx_small"
            android:paddingEnd="@dimen/p5d_space_xxx_small"
            app:layout_constraintBottom_toTopOf="@+id/purchasePremiumPrivacy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumActionButton"
            app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"/>
        <TextView
            android:id="@+id/purchasePremiumPrivacy"
            android:paddingTop="@dimen/p5d_space_x_tiny"
            android:paddingBottom="@dimen/p5d_space_x_tiny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ripple_rounded_corners"
            android:text="@string/privacy_policy"
            android:fontFamily="@font/roboto_regular_w400"
            android:paddingStart="@dimen/p5d_space_xxx_small"
            android:paddingEnd="@dimen/p5d_space_xxx_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumTerms"
            app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
