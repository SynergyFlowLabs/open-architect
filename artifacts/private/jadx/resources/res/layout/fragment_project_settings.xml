<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    style="@style/Planner5D.BottomSheetLayout">
    <View
        android:id="@+id/projectSettingsHandle"
        android:background="@drawable/background_grey_3_round"
        android:layout_width="35dp"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/projectSettingsGuideline"
        android:background="@color/p5d_grey_5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/bottom_sheet_peek_height"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/projectSettingsCloseButton"
        android:padding="@dimen/p5d_space_xx_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_round"
        android:src="@drawable/icon_close_light"
        android:contentDescription="@string/close"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toTopOf="@+id/projectSettingsGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/projectSettingsBackButton"
        android:padding="@dimen/p5d_space_tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_round"
        android:src="@drawable/icon_back_32"
        android:contentDescription="@string/back"
        android:layout_marginStart="@dimen/p5d_space_x_tiny"
        app:layout_constraintBottom_toTopOf="@+id/projectSettingsGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:id="@+id/projectSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/projectSettingsGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/projectSettingsHandle"
        style="@style/Planner5D.TextView.Medium"/>
    <ViewFlipper
        android:id="@+id/projectSettingsViewFlipper"
        android:paddingBottom="@dimen/bottom_sheet_peek_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/projectSettingsGuideline">
        <include
            android:id="@+id/projectSettingsMain"
            layout="@layout/fragment_project_settings_main"/>
        <include
            android:id="@+id/projectSettingsBackground"
            layout="@layout/fragment_project_settings_background"/>
        <include
            android:id="@+id/projectSettingsHistory"
            layout="@layout/fragment_project_settings_history"/>
        <include
            android:id="@+id/projectSettingsDisplayOptions"
            layout="@layout/fragment_project_settings_display_options"/>
        <include
            android:id="@+id/projectSettingsGraphics"
            layout="@layout/fragment_project_settings_graphics"/>
        <include
            android:id="@+id/projectSettingsActions"
            layout="@layout/fragment_project_settings_actions"/>
        <include
            android:id="@+id/projectSettingsControls"
            layout="@layout/fragment_project_settings_controls"/>
        <include
            android:id="@+id/projectSettingsGrid"
            layout="@layout/fragment_project_settings_grid"/>
    </ViewFlipper>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/projectSettingsPreloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
