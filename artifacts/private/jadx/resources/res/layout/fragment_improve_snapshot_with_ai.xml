<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/font_size_very_very_very_very_big"
                android:textColor="@color/solid.gray.G100"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/improve_renders_with_ai"
                android:fontFamily="@font/roboto_bold_w700"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                android:letterSpacing="@dimen/p5d_letter_spacing_extra"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap"/>
            <TextView
                android:textSize="@dimen/font_size_very_big"
                android:textColor="@color/text.beta"
                android:gravity="center_horizontal"
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/p5d_space_tiny"
                android:text="@string/a_fast_and_reliable_way_to_post_process_your_renders"
                android:lineSpacingExtra="@dimen/p5d_space_xxx_tiny"
                android:fontFamily="@font/roboto_regular_w400"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                android:letterSpacing="@dimen/p5d_letter_spacing_extra"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"
                app:layout_constraintWidth_default="wrap"/>
            <com.planner5d.library.widget.ImageSlider
                android:id="@+id/slider"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="52dp"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:dividerLineColor="#ff0177c9"
                app:imageSliderCornerRadius="@dimen/p5d_corner_radius_large"
                app:layout_constraintDimensionRatio="16:11.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitle"
                app:layout_constraintWidth_max="@dimen/content_max_width"
                app:leftLabel="@null"
                app:rightLabel="@null"
                app:thumb="@drawable/icon_image_slider_thumb_blue"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/text.beta"
                android:gravity="center_horizontal"
                android:id="@+id/description"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="50dp"
                android:text="@string/we_will_create_new_render_with_ai_improvements"
                android:lineSpacingExtra="@dimen/p5d_space_xx_tiny"
                android:fontFamily="@font/roboto_regular_w400"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                android:letterSpacing="@dimen/p5d_letter_spacing_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/slider"
                app:layout_constraintWidth_default="wrap"/>
            <com.planner5d.library.widget.textview.ButtonTextView
                android:gravity="center_vertical"
                android:id="@+id/action"
                android:background="@drawable/gradient_pro"
                android:layout_width="0dp"
                android:layout_height="@dimen/action_button_height"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_rounded_corners_huge"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/description"
                app:layout_constraintWidth_max="@dimen/content_max_width"/>
            <ImageView
                android:id="@+id/action_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_sparkles"
                android:layout_marginEnd="@dimen/p5d_space_tiny"
                app:layout_constraintBottom_toBottomOf="@+id/action"
                app:layout_constraintEnd_toStartOf="@+id/action_title"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/action"
                app:layout_constraintTop_toTopOf="@+id/action"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/white"
                android:id="@+id/action_title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/improve_render_with_ai"
                android:maxLines="1"
                android:fontFamily="@font/roboto_medium_w500"
                android:layout_marginEnd="@dimen/p5d_space_tiny"
                android:letterSpacing="@dimen/p5d_letter_spacing_minus_extra"
                app:layout_constraintBaseline_toBaselineOf="@+id/action"
                app:layout_constraintEnd_toEndOf="@+id/action"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintStart_toEndOf="@+id/action_icon"
                app:layout_constraintWidth_default="wrap"/>
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/action_preloader"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:indeterminate="true"
                app:indicatorColor="@color/absolute.white.W100"
                app:indicatorSize="22dp"
                app:layout_constraintBottom_toBottomOf="@+id/action"
                app:layout_constraintEnd_toEndOf="@+id/action"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintStart_toStartOf="@+id/action"
                app:layout_constraintTop_toTopOf="@+id/action"
                app:layout_constraintWidth_default="wrap"
                app:trackColor="@color/absolute.white.W30"
                app:trackThickness="@dimen/p5d_border_medium"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/action"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <include layout="@layout/view_back_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
