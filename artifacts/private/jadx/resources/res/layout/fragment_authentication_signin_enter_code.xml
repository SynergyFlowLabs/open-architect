<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="520dp"
        app:layout_constraintWidth_min="320dp">
        <TextView
            android:textSize="@dimen/font_size_very_very_very_very_big"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:text="@string/profile_signin_code_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:gravity="center_horizontal"
            android:id="@+id/description"
            android:paddingBottom="@dimen/p5d_space_x_small_perfect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny_perfect"
            android:text="@string/profile_signin_code_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/Planner5D.TextView"/>
        <EditText
            android:id="@+id/code1"
            app:layout_constraintEnd_toStartOf="@+id/code2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/description"
            style="@style/Planner5D.Code">
            <requestFocus/>
        </EditText>
        <EditText
            android:id="@+id/code2"
            app:layout_constraintEnd_toStartOf="@+id/code3"
            app:layout_constraintStart_toEndOf="@+id/code1"
            app:layout_constraintTop_toBottomOf="@+id/description"
            style="@style/Planner5D.Code"/>
        <EditText
            android:id="@+id/code3"
            app:layout_constraintEnd_toStartOf="@+id/code4"
            app:layout_constraintStart_toEndOf="@+id/code2"
            app:layout_constraintTop_toBottomOf="@+id/description"
            style="@style/Planner5D.Code"/>
        <EditText
            android:id="@+id/code4"
            app:layout_constraintEnd_toStartOf="@+id/code5"
            app:layout_constraintStart_toEndOf="@+id/code3"
            app:layout_constraintTop_toBottomOf="@+id/description"
            style="@style/Planner5D.Code"/>
        <EditText
            android:id="@+id/code5"
            app:layout_constraintEnd_toStartOf="@+id/code6"
            app:layout_constraintStart_toEndOf="@+id/code4"
            app:layout_constraintTop_toBottomOf="@+id/description"
            style="@style/Planner5D.Code"/>
        <EditText
            android:id="@+id/code6"
            android:layout_marginEnd="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/code5"
            app:layout_constraintTop_toBottomOf="@+id/description"
            style="@style/Planner5D.Code"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/text.beta"
            android:id="@+id/label_resend_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small_perfect"
            android:text="@string/profile_signin_code_timer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/link.alpha"
            android:id="@+id/button_resend_code"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small_perfect"
            android:text="@string/profile_signin_resend_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/error.fill.beta"
            android:id="@+id/error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small_perfect"
            android:text="@string/profile_signin_incorrect_code"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/code1"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/text.beta"
            android:gravity="center_horizontal"
            android:id="@+id/support"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small_perfect"
            android:text="@string/profile_signin_contact_support"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            style="@style/Planner5D.TextView"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="code1,error"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="code1,label_resend_code,button_resend_code,support"/>
        <ProgressBar
            android:theme="@style/progressBarPrimary"
            android:id="@+id/authenticationSignInSpinner"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_progress"/>
        <View
            android:id="@+id/defocus"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
