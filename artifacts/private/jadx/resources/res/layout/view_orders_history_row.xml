<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/orders_history_row_margin"
        android:layout_marginBottom="@dimen/orders_history_row_margin"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:cardCornerRadius="@dimen/p5d_corner_radius"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="704dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardBackground"
            android:background="@color/p5d_primary_5"
            android:paddingTop="@dimen/p5d_space_20"
            android:paddingBottom="@dimen/p5d_space_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/p5d_space_medium"
            android:paddingEnd="@dimen/p5d_space_medium"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:id="@+id/ordersHistoryRowDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView"/>
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:textColor="@color/p5d_grey"
                android:id="@+id/ordersHistoryRowTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_tiny"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ordersHistoryRowDate"
                style="@style/Planner5D.TextView"/>
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:id="@+id/ordersHistoryRowSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ordersHistoryRowTime"
                style="@style/Planner5D.TextView"/>
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:textColor="@color/p5d_grey"
                android:id="@+id/ordersHistoryRowNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_tiny"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ordersHistoryRowSource"
                style="@style/Planner5D.TextView"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/ordersHistoryRowGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.6"/>
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:id="@+id/ordersHistoryRowOrderedItem"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ordersHistoryRowGuideline"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView.Ellipsized"/>
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:textColor="@color/p5d_grey"
                android:id="@+id/ordersHistoryRowOrderedItemExplanation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_tiny"
                android:text="@string/android_only"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ordersHistoryRowGuideline"
                app:layout_constraintTop_toBottomOf="@+id/ordersHistoryRowOrderedItem"
                style="@style/Planner5D.TextView.Ellipsized"/>
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:id="@+id/ordersHistoryRowStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ordersHistoryRowGuideline"
                app:layout_constraintTop_toTopOf="@+id/ordersHistoryRowSource"
                style="@style/Planner5D.TextView.Ellipsized"/>
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:textColor="@color/p5d_grey"
                android:id="@+id/ordersHistoryRowStatusExplanation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_tiny"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ordersHistoryRowGuideline"
                app:layout_constraintTop_toBottomOf="@+id/ordersHistoryRowStatus"
                style="@style/Planner5D.TextView.Ellipsized"/>
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:id="@+id/ordersHistoryUserTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:text="Owned by User with Id"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ordersHistoryRowNumber"
                style="@style/Planner5D.TextView"/>
            <TextView
                android:textSize="@dimen/orders_history_text"
                android:textColor="@color/p5d_grey"
                android:id="@+id/ordersHistoryUserId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_tiny"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ordersHistoryUserTitle"
                style="@style/Planner5D.TextView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
