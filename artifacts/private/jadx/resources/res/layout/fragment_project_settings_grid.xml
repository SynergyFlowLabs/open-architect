<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/p5d_space_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsGridSize"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:text="@string/grid_size"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/projectSettingsGridSizeInputBackground"
            android:background="@drawable/background_grey_5_round_medium"
            android:layout_width="80dp"
            android:layout_height="32dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintBottom_toBottomOf="@+id/projectSettingsGridSize"
            app:layout_constraintEnd_toEndOf="@+id/projectSettingsGridSize"
            app:layout_constraintTop_toTopOf="@+id/projectSettingsGridSize"/>
        <com.planner5d.library.widget.TextInputEditTextCompat
            android:textSize="@dimen/font_size_big"
            android:id="@+id/projectSettingsGridSizeInput"
            android:background="@android:color/transparent"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:selectAllOnFocus="true"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/projectSettingsGridSize"
            app:layout_constraintStart_toStartOf="@+id/projectSettingsGridSizeInputBackground"
            app:layout_constraintTop_toTopOf="@+id/projectSettingsGridSize"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:gravity="center"
            android:id="@+id/projectSettingsGridSliderMinus"
            android:layout_width="@dimen/p5d_space_x_large"
            android:layout_height="@dimen/p5d_space_x_large"
            android:foreground="@drawable/ripple_round"
            android:text="-"
            android:layout_marginStart="@dimen/p5d_space_tiny"
            app:layout_constraintBottom_toBottomOf="@+id/projectSettingsGridSlider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/projectSettingsGridSlider"
            style="@style/Planner5D.TextView"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/projectSettingsGridSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="50"
            app:layout_constraintEnd_toStartOf="@+id/projectSettingsGridSliderPlus"
            app:layout_constraintStart_toEndOf="@+id/projectSettingsGridSliderMinus"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsGridSize"
            style="@style/Planner5D.Slider"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:gravity="center"
            android:id="@+id/projectSettingsGridSliderPlus"
            android:layout_width="@dimen/p5d_space_x_large"
            android:layout_height="@dimen/p5d_space_x_large"
            android:foreground="@drawable/ripple_round"
            android:text="+"
            android:layout_marginEnd="@dimen/p5d_space_tiny"
            app:layout_constraintBottom_toBottomOf="@+id/projectSettingsGridSlider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/projectSettingsGridSlider"
            style="@style/Planner5D.TextView"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsSnapToGridSwitch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/snap_to_grid"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsGridSlider"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:background="@color/p5d_grey_5"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsSnapToGridSwitch"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsShowGridSwitch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/show_grid"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsSnapToGridSwitch"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:background="@color/p5d_grey_5"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsShowGridSwitch"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
