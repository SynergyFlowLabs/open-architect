<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_medium">
        <com.google.android.material.textfield.TextInputLayout
            android:theme="@style/Theme.Planner5D.Form.Material"
            android:id="@+id/inputTitleContainer"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:hint="@string/project_title"
            android:layout_marginStart="@dimen/p5d_space_medium"
            android:layout_marginEnd="@dimen/p5d_space_medium"
            app:hintTextAppearance="@style/HintTextAppearance">
            <com.planner5d.library.widget.TextInputEditTextCompat
                android:textSize="@dimen/font_size_normal"
                android:id="@+id/inputTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="text"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionNext"
                android:nextFocusForward="@+id/inputDescription"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:theme="@style/Theme.Planner5D.Form.Material"
            android:id="@+id/descriptionLabel"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gallery_send_to_gallery_description"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:layout_marginStart="@dimen/p5d_space_medium"
            android:layout_marginEnd="@dimen/p5d_space_medium"
            app:hintTextAppearance="@style/HintTextAppearance">
            <com.planner5d.library.widget.TextInputEditTextCompat
                android:textSize="@dimen/font_size_normal"
                android:gravity="top"
                android:id="@+id/inputDescription"
                android:paddingTop="@dimen/p5d_space_x_small"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="textMultiLine"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
                android:nextFocusForward="@+id/selectTagsInput"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:theme="@style/Theme.Planner5D.Form.Material"
            android:id="@+id/selectTagsLabel"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:layout_marginBottom="@dimen/p5d_space_medium"
            android:hint="@string/select_tags"
            android:layout_marginStart="@dimen/p5d_space_medium"
            android:layout_marginEnd="@dimen/p5d_space_medium"
            app:hintTextAppearance="@style/HintTextAppearance">
            <com.planner5d.library.widget.TextInputEditTextCompat
                android:textSize="@dimen/font_size_normal"
                android:id="@+id/selectTagsInput"
                android:paddingTop="@dimen/p5d_space_x_small"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cursorVisible="false"
                android:inputType="none"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
                app:drawableEndCompat="@drawable/icon_forward_grey_2"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/tagSelectContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/p5d_space_x_small">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/tagGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</FrameLayout>
