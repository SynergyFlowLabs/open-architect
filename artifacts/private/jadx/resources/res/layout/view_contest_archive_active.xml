<?xml version="1.0" encoding="utf-8"?>
<com.planner5d.library.contest.view.archive.ContestActiveView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_round_with_border"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/contest_archive_margin_bottom">
    <View
        android:background="@drawable/background_button_light_green_bottom"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contestInfo"
        android:background="@drawable/background_grey_round_with_light_border"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_medium"
        android:layout_marginRight="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/view_contest_archive_info"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:textColor="@color/p5d_text"
        android:id="@+id/contestName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/p5d_space_xx_small"
        android:layout_marginTop="@dimen/p5d_space_medium"
        android:layout_marginRight="@dimen/p5d_space_xx_small"
        android:layout_marginBottom="@dimen/p5d_space_tiny"
        android:minWidth="140dp"
        android:minHeight="@dimen/font_size_normal"
        android:layout_marginStart="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/contestInfo"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/p5d_eerie_black_50"
        android:id="@+id/contestRequirements"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/p5d_space_xx_small"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:layout_marginRight="@dimen/p5d_space_xx_small"
        android:minWidth="140dp"
        android:minHeight="@dimen/p5d_space_medium"
        android:layout_marginStart="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/contestInfo"
        app:layout_constraintTop_toBottomOf="@+id/contestName"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:gravity="center"
        android:id="@+id/contestButtonParticipate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_space_large"
        android:layout_marginLeft="@dimen/p5d_space_xx_small"
        android:layout_marginTop="20dp"
        android:layout_marginRight="@dimen/p5d_space_xx_small"
        app:layout_constraintTop_toBottomOf="@+id/contestRequirements"
        style="@style/Planner5D.ButtonTextView.Green"/>
    <TextView
        android:textSize="@dimen/font_size_very_small"
        android:textColor="@color/p5d_eerie_black_50"
        android:id="@+id/contestJoinInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/p5d_space_x_small"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:layout_marginRight="@dimen/p5d_space_x_small"
        android:layout_marginBottom="@dimen/p5d_space_xx_small"
        android:textAllCaps="true"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contestButtonParticipate"
        style="@style/Planner5D.TextView.Medium"/>
</com.planner5d.library.contest.view.archive.ContestActiveView>
