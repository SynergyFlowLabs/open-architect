<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/white_dialog_background"
    android:paddingBottom="@dimen/p5d_space_large"
    android:layout_width="320dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textColor="@color/p5d_grey_1"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingTop="17dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ai_csi_rate_result_title"
        android:layout_marginHorizontal="@dimen/p5d_space_x_huge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <ImageView
        android:id="@+id/buttonClose"
        android:padding="@dimen/p5d_space_x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_close_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/rate1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_large"
        android:src="@drawable/icon_satisfaction_1"
        android:layout_marginStart="@dimen/p5d_space_xxx_small"
        app:layout_constraintEnd_toStartOf="@+id/rate2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ImageView
        android:id="@+id/rate2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_satisfaction_2"
        app:layout_constraintEnd_toStartOf="@+id/rate3"
        app:layout_constraintStart_toEndOf="@+id/rate1"
        app:layout_constraintTop_toTopOf="@+id/rate1"/>
    <ImageView
        android:id="@+id/rate3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_satisfaction_3"
        app:layout_constraintEnd_toStartOf="@+id/rate4"
        app:layout_constraintStart_toEndOf="@+id/rate2"
        app:layout_constraintTop_toTopOf="@+id/rate1"/>
    <ImageView
        android:id="@+id/rate4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_satisfaction_4"
        app:layout_constraintEnd_toStartOf="@+id/rate5"
        app:layout_constraintStart_toEndOf="@+id/rate3"
        app:layout_constraintTop_toTopOf="@+id/rate1"/>
    <ImageView
        android:id="@+id/rate5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_satisfaction_5"
        android:layout_marginEnd="@dimen/p5d_space_xxx_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rate4"
        app:layout_constraintTop_toTopOf="@+id/rate1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
