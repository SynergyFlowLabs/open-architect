<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_gravity="start"
        android:id="@+id/catalogDrawerCoordinator"
        android:layout_height="match_parent"
        style="@style/Planner5D.BottomSheetLayout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/catalogDrawerBottomSheet"
            android:background="@drawable/background_editor_catalog_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:behavior_fitToContents="false"
            app:behavior_halfExpandedRatio="0.5"
            app:behavior_hideable="false"
            app:layout_behavior="com.google.android.material.bottomsheet.AdvancedBottomSheetBehavior">
            <FrameLayout
                android:id="@+id/catalogDrawerHandle"
                android:layout_width="match_parent"
                android:layout_height="21dp"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/background_grey_3_round"
                    android:layout_width="35dp"
                    android:layout_height="5dp"/>
            </FrameLayout>
            <com.planner5d.library.widget.TabLayout
                android:id="@+id/editorCatalogTabs"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/catalogDrawerHandle"
                app:tabIconTint="@color/editor_catalog_tab_icon"
                app:tabIndicatorHeight="0dp"
                app:tabPaddingBottom="@dimen/p5d_space_x_tiny"
                app:tabRippleColor="@color/white"
                app:tabSelectedTextColor="@color/p5d_primary"
                app:tabTextAppearance="@style/Planner5D.TabLayout.Editor.CatalogDrawer"
                app:tabTextColor="@color/p5d_grey_1"
                app:tabUnboundedRipple="true"/>
            <com.planner5d.library.widget.preloader.PreloaderSimpleV2View
                android:id="@+id/editorCatalogTabsPreloader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/editorCatalogTabs"
                app:layout_constraintEnd_toEndOf="@+id/editorCatalogTabs"
                app:layout_constraintStart_toStartOf="@+id/editorCatalogTabs"
                app:layout_constraintTop_toTopOf="@+id/editorCatalogTabs"/>
            <ImageView
                android:id="@+id/editorCatalogTitleBack"
                android:padding="@dimen/p5d_space_xxx_small"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/ripple_round"
                android:src="@drawable/icon_back_32"
                android:layout_marginStart="@dimen/p5d_space_x_tiny"
                app:layout_constraintBottom_toTopOf="@+id/catalogDrawerGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/p5d_grey_1"/>
            <TextView
                android:id="@+id/editorCatalogTitle"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/catalogDrawerGuideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
            <ImageView
                android:id="@+id/editorCatalogTitleClose"
                android:padding="@dimen/p5d_space_xx_small"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/ripple_round"
                android:src="@drawable/icon_close_button"
                android:layout_marginEnd="@dimen/p5d_space_tiny"
                app:layout_constraintBottom_toTopOf="@+id/catalogDrawerGuideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/catalogDrawerGuideline"
                android:background="@color/p5d_grey_5"
                android:layout_width="match_parent"
                android:layout_height="@dimen/p5d_border_small"
                android:layout_marginTop="@dimen/bottom_sheet_peek_height"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.planner5d.library.widget.editor.catalog.UnlockCountdownBannerView
                android:id="@+id/unlock_catalog_banner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/catalogDrawerGuideline"/>
            <com.planner5d.library.widget.ViewPagerCompat
                android:id="@+id/editorCatalogContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="true"
                app:layout_constraintTop_toBottomOf="@+id/unlock_catalog_banner"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/editorCatalogCategoriesPreloader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:hideAnimationBehavior="outward"
                app:layout_constraintTop_toTopOf="@+id/editorCatalogContent"
                app:showAnimationBehavior="inward"
                app:trackColor="@color/transparent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/editorCatalogAnchor"
        android:layout_width="1dp"
        android:layout_height="0dp"/>
</merge>
