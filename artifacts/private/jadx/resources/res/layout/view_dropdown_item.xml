<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/p5d_space_x_huge">
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_text"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/dropdown_text"
        android:paddingLeft="@dimen/p5d_space_medium"
        android:paddingTop="10dp"
        android:paddingRight="@dimen/p5d_space_medium"
        android:paddingBottom="10dp"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <RadioButton
        android:id="@+id/dropdown_radio_button"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
