<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/back_button"
        android:padding="@dimen/p5d_space_x_tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        android:layout_marginBottom="@dimen/p5d_space_x_tiny"
        android:foreground="@drawable/ripple_rounded_corners_medium"
        android:src="@drawable/icon_back_32"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/border"
        android:background="@color/border.gamma"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_border"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        app:layout_constraintTop_toBottomOf="@+id/back_button"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:hideAnimationBehavior="outward"
        app:indicatorColor="@color/solid.primary.P10"
        app:layout_constraintTop_toTopOf="@+id/border"
        app:showAnimationBehavior="inward"
        app:trackColor="@color/primary.fill.beta"/>
    <com.google.android.material.textfield.TextInputLayout
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:id="@+id/address_input_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:endIconMode="clear_text"
        app:errorIconDrawable="@null"
        app:hintEnabled="false"
        app:layout_constraintBottom_toBottomOf="@+id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back_button"
        app:layout_constraintTop_toTopOf="@+id/back_button"
        style="@style/Planner5D.TextInputLayout.Material.Ghost">
        <com.planner5d.library.widget.TextInputEditTextCompat
            android:id="@+id/address_input"
            android:padding="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/spaces_onboarding_address_search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:transitionName="secondTransitionName"/>
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/address_result_list"
        android:paddingTop="@dimen/p5d_space_xx_small"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/border"/>
</androidx.constraintlayout.widget.ConstraintLayout>
