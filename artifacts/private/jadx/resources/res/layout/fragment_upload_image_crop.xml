<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/blackBar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/buttonRotate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/rotate_action"
            android:paddingHorizontal="@dimen/p5d_space_x_small"
            style="@style/Planner5D.TextView.Medium"/>
    </FrameLayout>
    <View
        android:background="@color/p5d_grey_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blackBar"/>
    <com.canhub.cropper.core.CropImageView
        android:id="@+id/crop_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:layout_marginBottom="116dp"
        android:layout_marginHorizontal="@dimen/p5d_space_medium"
        app:cropAutoZoomEnabled="false"
        app:cropBorderCornerColor="@color/yellow_border"
        app:cropBorderCornerOffset="-1dp"
        app:cropBorderCornerThickness="2dp"
        app:cropBorderLineColor="@color/yellow_border"
        app:cropBorderLineThickness="1dp"
        app:cropGuidelinesColor="@color/yellow_border"
        app:cropInitialCropWindowPaddingRatio="0"
        app:cropProgressBarColor="@color/p5d_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blackBar"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/buttonCancel"
        android:layout_width="@dimen/p5d_space_xx_large"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_margin="24dp"
        android:src="@drawable/icon_close"
        app:fabCustomSize="@dimen/p5d_space_xx_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.FloatingActionButton.ImageCrop"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/buttonNext"
        android:background="@drawable/gradient_green"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/next"
        android:layout_marginEnd="@dimen/p5d_space_medium"
        android:paddingHorizontal="@dimen/p5d_space_medium"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintBottom_toBottomOf="@+id/buttonCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/buttonCancel"
        style="@style/Planner5D.TextView.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
