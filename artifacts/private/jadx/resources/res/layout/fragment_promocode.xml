<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="560dp"
            style="@style/Planner5D.Content">
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:id="@+id/promocodeInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/p5d_space_20"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:layout_marginRight="@dimen/p5d_space_20"
                android:hint="@string/enter_promo_code_here"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:errorTextAppearance="@style/ErrorTextStyle"
                app:helperText=" "
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/promocodeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/promocodeSubmit"
                android:background="@drawable/background_button_default"
                android:layout_width="0dp"
                android:layout_height="@dimen/authentication_button_height"
                android:layout_marginTop="@dimen/promocode_submit_top_margin"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/use_promo_code"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/promocodeInputLayout"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/promocodePreloader"
        android:background="@color/white_50"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/p5d_eerie_black"
            app:trackCornerRadius="@dimen/p5d_corner_radius"/>
    </FrameLayout>
</FrameLayout>
