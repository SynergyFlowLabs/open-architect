<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/contestSwipeRefresh"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/contestImage"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintDimensionRatio="360:313"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/font_size_small"
                    android:textColor="@color/absolute.white.W100"
                    android:gravity="center_vertical"
                    android:id="@+id/contestRemainingTime"
                    android:background="@drawable/background_button_primary_label_beta_rounded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/p5d_space_20"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:drawablePadding="@dimen/p5d_space_x_tiny"
                    android:paddingEnd="@dimen/p5d_space_tiny"
                    android:layout_marginStart="@dimen/contest_contents_margin"
                    app:drawableStartCompat="@drawable/icon_clock"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/contestImage"
                    style="@style/Planner5D.Font.Medium"/>
                <TextView
                    android:textSize="@dimen/font_size_very_very_very_big"
                    android:textColor="@color/p5d_text"
                    android:ellipsize="end"
                    android:id="@+id/contestName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/p5d_space_xx_small"
                    android:maxLines="2"
                    android:layout_marginStart="@dimen/contest_contents_margin"
                    android:layout_marginEnd="@dimen/contest_contents_margin"
                    android:letterSpacing="@dimen/p5d_letter_spacing_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/contestRemainingTime"
                    style="@style/Planner5D.Font.Bold"/>
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/p5d_grey_2"
                    android:ellipsize="end"
                    android:id="@+id/contestRequirements"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:maxLines="4"
                    android:lineSpacingExtra="3dp"
                    app:layout_constraintEnd_toEndOf="@+id/contestName"
                    app:layout_constraintStart_toStartOf="@+id/contestName"
                    app:layout_constraintTop_toBottomOf="@+id/contestName"
                    style="@style/Planner5D.TextView"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/contestPrizePrizes"
                    android:paddingBottom="140dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/contestRequirements"
                    app:layout_constraintWidth_max="358dp"
                    app:spanCount="3"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/onboarding_fade_out"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/primary.label.alpha"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/contestShareExplanation"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:text="@string/design_battle_share_explain"
            android:maxLines="1"
            android:lineSpacingExtra="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Bold"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/contestButtonParticipate"
            android:background="@drawable/background_button_primary_fill_beta_rounded"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_huge"
            android:layout_marginTop="@dimen/p5d_space_huge"
            android:foreground="@drawable/ripple_rounded_corners"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Bold"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/contestButtonVote"
            android:background="@drawable/background_button_orange_rounded"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_huge"
            android:layout_marginTop="@dimen/p5d_space_xx_small"
            android:layout_marginBottom="@dimen/p5d_space_20"
            android:foreground="@drawable/ripple_rounded_corners"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contestButtonParticipate"
            style="@style/Planner5D.TextView.Bold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/backWrapper"
        android:layout_width="?attr/actionBarSize"
        android:layout_height="?attr/actionBarSize">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/back"
            android:background="@drawable/ripple_round"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="?attr/homeAsUpIndicator"
            android:scaleType="centerInside"
            app:tint="@color/white"/>
    </FrameLayout>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/contestPreloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
