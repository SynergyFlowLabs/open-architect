<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/promocodeSuccessImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/promocodeSuccessText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:srcCompat="@drawable/icon_check_65"/>
        <TextView
            android:textSize="32dp"
            android:gravity="center_horizontal"
            android:id="@+id/promocodeSuccessText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_xx_small"
            android:text="@string/promo_code_success"
            android:layout_marginStart="@dimen/p5d_space_40"
            android:layout_marginEnd="@dimen/p5d_space_40"
            app:layout_constraintBottom_toTopOf="@+id/promocodeSuccessDone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/promocodeSuccessImage"
            style="@style/Planner5D.TextView.Bold"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/promocodeSuccessDone"
            android:background="@drawable/background_button_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/authentication_button_height"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:layout_marginBottom="@dimen/p5d_space_20"
            android:foreground="@drawable/ripple_rounded_corners"
            android:text="@string/done"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
