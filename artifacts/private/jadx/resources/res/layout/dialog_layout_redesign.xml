<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_surface_gamma_rounded"
    android:paddingTop="@dimen/p5d_space_medium"
    android:paddingBottom="@dimen/p5d_space_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="@dimen/modal_form_width"
    android:paddingHorizontal="@dimen/p5d_space_medium">
    <TextView
        android:textColor="@color/text.alpha"
        android:gravity="start|center_vertical"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:lineHeight="@dimen/font_size_very_very_very_very_very_big"
        style="@style/Planner5D.Text.Title_Large"/>
    <FrameLayout
        android:id="@+id/content"
        android:paddingTop="@dimen/p5d_space_x_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/button_container"
        android:paddingTop="@dimen/p5d_space_medium_rare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_20"
        app:layout_constraintTop_toBottomOf="@+id/content">
        <TextView
            android:textColor="@color/p5d_text"
            android:id="@+id/button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Cancel"
            android:layout_marginEnd="@dimen/p5d_space_xx_small"
            android:paddingHorizontal="@dimen/p5d_space_20"
            android:paddingVertical="@dimen/p5d_space_xxx_small"
            style="@style/Planner5D.Text.Title_ExtraSmall"/>
        <TextView
            android:textColor="@color/main_theme_color"
            android:id="@+id/button_middle"
            android:background="@drawable/background_button_grey"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/p5d_space_x_large"
            android:layout_marginEnd="@dimen/p5d_space_xx_small"
            style="@style/Planner5D.Button"/>
        <TextView
            android:textColor="@color/primary.text.on.fill"
            android:id="@+id/button_save"
            android:background="@drawable/background_error_beta_round"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:paddingHorizontal="@dimen/p5d_space_20"
            android:paddingVertical="@dimen/p5d_space_xxx_small"
            style="@style/Planner5D.Text.Title_ExtraSmall"/>
    </LinearLayout>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/preloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
