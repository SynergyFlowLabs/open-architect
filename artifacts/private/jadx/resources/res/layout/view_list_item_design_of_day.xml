<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.Planner5D.MaterialCard.Material"
    android:id="@+id/imageWrapper"
    android:tag="layout/view_list_item_design_of_day_0"
    android:layout_width="@dimen/feed_blog_card_width"
    android:layout_height="@dimen/feed_blog_card_width"
    android:layout_marginTop="@dimen/p5d_space_xxx_small"
    android:layout_marginBottom="@dimen/p5d_space_medium"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginStart="@dimen/p5d_space_xxx_small"
    android:layout_marginEnd="@dimen/p5d_space_xxx_small"
    android:stateListAnimator="@animator/card_press"
    app:cardCornerRadius="@dimen/p5d_corner_radius_large"
    app:cardElevation="@dimen/p5d_elevation_large">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:scaleX="1.1"
            android:scaleY="1.1"/>
        <View
            android:background="@drawable/designs_of_the_day_fade_out"
            android:layout_width="0dp"
            android:layout_height="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.planner5d.library.widget.ProfileIconView
            android:id="@+id/avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="@dimen/p5d_space_x_small"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            app:imageBackgroundColor="@color/white"
            app:imageBorderColor="@color/white"
            app:imageBorderWidth="1dp"
            app:imageSize="@dimen/p5d_space_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/favorite"
            android:tag="binding_1"
            android:padding="@dimen/p5d_space_x_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ripple_favorite"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/avatar"/>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/title"
            android:tag="binding_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:textAllCaps="true"
            android:layout_marginHorizontal="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toStartOf="@+id/favorite"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="@+id/avatar"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/font_size_normal"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/author"
            android:tag="binding_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginHorizontal="@dimen/p5d_space_tiny"
            app:layout_constraintEnd_toStartOf="@+id/favorite"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/Planner5D.TextView.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
