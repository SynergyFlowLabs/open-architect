<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    style="@style/Planner5D.Contest.Dialog">
    <ScrollView
        android:background="@drawable/background_dialog_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/contestSubmittedCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:foreground="@drawable/ripple_round"
                android:layout_marginEnd="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/icon_close_button"/>
            <TextView
                android:textSize="@dimen/font_size_huge"
                android:gravity="center"
                android:id="@+id/contestSubmittedTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_small"
                android:text="@string/design_contest_project_submitted_title"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSubmittedCancel"
                style="@style/Planner5D.TextView.Bold"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:gravity="center"
                android:id="@+id/contestSubmittedSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_small"
                android:text="@string/design_contest_project_submitted_subtitle"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toTopOf="@+id/contestSubmittedImage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSubmittedTitle"
                app:layout_constraintVertical_chainStyle="spread_inside"
                style="@style/Planner5D.TextView"/>
            <ImageView
                android:id="@+id/contestSubmittedImage"
                android:layout_width="280dp"
                android:layout_height="200dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/waiting"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toTopOf="@+id/contestSubmittedVote"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSubmittedSubtitle"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_grey_2"
                android:gravity="center"
                android:id="@+id/contestSubmittedVote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:text="@string/design_contest_project_submitted_vote"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toTopOf="@+id/contestSubmittedOk"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSubmittedImage"
                style="@style/Planner5D.TextView"/>
            <com.planner5d.library.widget.textview.ButtonTextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/contestSubmittedOk"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_xx_large"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:layout_marginBottom="@dimen/p5d_space_x_small"
                android:foreground="@drawable/ripple_rounded_corners_huge"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSubmittedVote"
                app:layout_constraintVertical_bias="1"
                style="@style/Planner5D.TextView.Medium"/>
            <com.planner5d.library.widget.preloader.PreloaderSimpleV2View
                android:id="@+id/contestSubmittedPreloader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/contestSubmittedVote"
                app:layout_constraintEnd_toEndOf="@+id/contestSubmittedVote"
                app:layout_constraintStart_toStartOf="@+id/contestSubmittedVote"
                app:layout_constraintTop_toTopOf="@+id/contestSubmittedVote"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
