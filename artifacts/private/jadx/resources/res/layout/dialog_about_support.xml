<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <Spinner
        android:id="@+id/dropdown"
        android:background="@null"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusUp="@+id/button_send"
        android:nextFocusDown="@+id/email"
        android:layout_width="match_parent"
        android:layout_height="39dp"/>
    <View
        android:background="#ffcccccc"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.planner5d.library.widget.EditTextWithValidator
        android:textSize="@dimen/font_size_normal"
        android:textColorHint="#ff9e9e9e"
        android:gravity="start|top"
        android:id="@+id/email"
        android:paddingLeft="@dimen/p5d_space_x_small"
        android:paddingRight="@dimen/p5d_space_x_small"
        android:nextFocusUp="@+id/dropdown"
        android:nextFocusDown="@+id/description"
        android:layout_height="39dp"
        android:hint="@string/e_mail"
        android:singleLine="true"
        android:inputType="textEmailAddress"
        style="@style/Planner5D.Settings.EditText"/>
    <com.planner5d.library.widget.EditTextWithValidator
        android:textSize="@dimen/font_size_normal"
        android:textColorHint="#ff9e9e9e"
        android:gravity="start|top"
        android:id="@+id/description"
        android:padding="@dimen/p5d_space_x_small"
        android:nextFocusUp="@+id/email"
        android:nextFocusDown="@+id/button_send"
        android:layout_height="70dp"
        android:hint="@string/placeholder_problem_description"
        android:singleLine="false"
        android:inputType="textMultiLine"
        android:textAlignment="viewStart"
        style="@style/Planner5D.Settings.EditText"/>
    <com.planner5d.library.widget.editor.projectsettings.ProjectSettingCheckboxView
        android:id="@+id/attach_projects"
        android:layout_width="match_parent"
        android:layout_height="39dp"/>
    <View
        android:background="#ffcccccc"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <Button
        android:textSize="@dimen/font_size_big"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/button_send"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:nextFocusUp="@+id/description"
        android:nextFocusDown="@+id/dropdown"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/send"
        android:textAllCaps="true"
        style="?android:attr/borderlessButtonStyle"/>
</merge>
