<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/purchasesPremiumScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/p5d_space_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <com.planner5d.library.widget.carousel.ViewPagerCarouselView
            android:id="@+id/purchasesPremiumImageCarousel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            android:layout_marginEnd="@dimen/purchase_content_horizontal_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toTopOf="parent">
            <HorizontalScrollView
                android:id="@+id/purchasePremiumProducts"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/purchase_premium_products_height"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/purchasePremiumList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Planner5D.Purchase.ProductList"/>
            </HorizontalScrollView>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/purchasesPremiumBenefits"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_small"
                android:layout_marginStart="@dimen/p5d_space_xx_small"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProducts"
                app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"/>
            <com.planner5d.library.widget.preloader.PreloaderCoverView
                android:id="@+id/purchasePremiumProductListPreloader"
                android:layout_width="0dp"
                android:layout_height="@dimen/purchase_premium_products_height"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/error"
                android:gravity="center"
                android:id="@+id/purchasePremiumErrorMessage"
                android:layout_width="0dp"
                android:layout_height="@dimen/purchase_premium_products_height"
                android:layout_marginStart="@dimen/p5d_space_medium"
                android:layout_marginEnd="@dimen/p5d_space_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"/>
            <TextView
                android:id="@+id/purchasePremiumTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_message_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/purchasesPremiumBenefits"
                app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"
                style="@style/Planner5D.PurchasePremiumLink"/>
            <TextView
                android:id="@+id/purchasePremiumPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/purchasePremiumTerms"
                app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"
                style="@style/Planner5D.PurchasePremiumLink"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
