<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#fff0f0f0"
    android:paddingLeft="@dimen/p5d_space_x_small"
    android:paddingTop="@dimen/p5d_space_tiny"
    android:paddingRight="@dimen/p5d_space_x_small"
    android:paddingBottom="@dimen/p5d_space_tiny"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/list_order_text"
        android:gravity="start|top"
        android:id="@+id/column0"
        android:layout_width="152dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/list_order_text"
        android:gravity="start|top"
        android:id="@+id/column1"
        android:layout_width="152dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/column0"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_very_small"
        android:textColor="#6b757575"
        android:gravity="start|top"
        android:id="@+id/column2"
        android:layout_width="152dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/column1"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
