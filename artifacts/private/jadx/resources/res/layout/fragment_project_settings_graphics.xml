<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/p5d_space_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/p5d_space_20"
        android:paddingEnd="@dimen/p5d_space_20">
        <TextView
            android:textColor="@color/p5d_grey_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:text="@string/project_settings_graphics_quality_explanation"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textColor="@color/p5d_grey_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:text="@string/project_settings_graphics_quality_shadows"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/projectSettingsShadowQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Planner5D.Settings.Dropdown">
            <AutoCompleteTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                style="@style/Planner5D.Settings.Dropdown.Input"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textColor="@color/p5d_grey_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:text="@string/project_settings_graphics_quality_textures"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/projectSettingsTextureQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Planner5D.Settings.Dropdown">
            <AutoCompleteTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                style="@style/Planner5D.Settings.Dropdown.Input"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
