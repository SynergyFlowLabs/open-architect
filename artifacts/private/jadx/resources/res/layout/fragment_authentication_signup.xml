<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.Authentication.Content">
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:id="@+id/authenticationSignUpEmailLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:hint="@string/email"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:helperText=" "
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/authenticationSignUpEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionNext"
                    android:nextFocusForward="@+id/authenticationSignUpPassword"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:id="@+id/authenticationSignUpPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_tiny"
                android:hint="@string/password"
                app:endIconMode="password_toggle"
                app:errorIconDrawable="@null"
                app:helperText=" "
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationSignUpEmailLayout">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/authenticationSignUpPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
                    android:nextFocusForward="@+id/authenticationSignUpContinue"/>
            </com.google.android.material.textfield.TextInputLayout>
            <CheckBox
                android:theme="@style/Planner5D.CheckBox"
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_grey_1"
                android:gravity="top"
                android:id="@+id/agreementsCheckBoxMarketing"
                android:paddingLeft="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_large"
                android:checked="false"
                android:text="@string/newsletter_agreement_agree_emails"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationSignUpPasswordLayout"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/authenticationSignUpContinue"
                android:background="@drawable/background_button_default"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/authentication_button_height"
                android:layout_marginTop="@dimen/p5d_space_40"
                android:layout_marginBottom="@dimen/p5d_space_40"
                android:foreground="@drawable/ripple_rounded_corners"
                android:imeOptions="actionDone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/agreementsCheckBoxMarketing"
                app:layout_constraintVertical_bias="1">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@android:color/white"
                    android:id="@+id/authenticationSignUpContinueLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_up"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Planner5D.TextView.Medium"/>
                <ProgressBar
                    android:theme="@style/progressBarWhite"
                    android:id="@+id/authenticationSignUpSpinner"
                    android:visibility="invisible"
                    android:layout_width="@dimen/p5d_space_x_small"
                    android:layout_height="@dimen/p5d_space_x_small"
                    android:layout_marginLeft="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/authenticationSignUpContinueLabel"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
