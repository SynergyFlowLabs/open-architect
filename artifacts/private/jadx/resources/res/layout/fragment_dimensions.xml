<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.planner5d.library.widget.editor.editor2d.Editor2D
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/p5d_space_medium"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/dimensions_list"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_min="400dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/dimensions_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/smart_wizard_dimensions_space_for_bottom_button"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <com.planner5d.library.widget.textview.ButtonTextView
            android:layout_gravity="bottom"
            android:id="@+id/next_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/smart_wizard_next_button_height"
            android:layout_marginBottom="@dimen/p5d_space_large"
            android:text="@string/next"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:backgroundCornerRadius="@dimen/p5d_corner_radius_rounded"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/Planner5D.ButtonTextView.Green"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textColor="@color/p5d_primary"
        android:layout_gravity="end|top"
        android:id="@+id/measurement_button"
        android:background="@color/white"
        android:padding="0dp"
        android:layout_width="@dimen/smart_wizard_floating_button_size"
        android:layout_height="@dimen/smart_wizard_floating_button_size"
        android:layout_marginTop="@dimen/p5d_space_large"
        android:lines="1"
        android:textAllCaps="false"
        android:elevation="@dimen/p5d_elevation_large"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_rounded"
        style="@style/Planner5D.ButtonTextView.Green"/>
</FrameLayout>
