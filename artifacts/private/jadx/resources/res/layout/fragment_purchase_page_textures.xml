<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/purchaseRendersScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/purchase_title_top_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:id="@+id/purchaseTexturesProducts"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/purchase_default_product_height"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/purchaseTexturesList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Planner5D.Purchase.ProductList"/>
        </HorizontalScrollView>
        <com.planner5d.library.widget.preloader.PreloaderCoverView
            android:id="@+id/purchaseTexturesListPreloader"
            android:layout_width="0dp"
            android:layout_height="@dimen/purchase_default_product_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/error"
            android:gravity="center"
            android:id="@+id/purchaseTexturesErrorMessage"
            android:layout_width="0dp"
            android:layout_height="@dimen/purchase_default_product_height"
            android:layout_marginLeft="@dimen/p5d_space_medium"
            android:layout_marginRight="@dimen/p5d_space_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/purchaseTexturesImage"
            android:layout_width="@dimen/purchase_texture_image_size"
            android:layout_height="@dimen/purchase_texture_image_size"
            android:layout_marginLeft="@dimen/p5d_space_20"
            android:layout_marginTop="@dimen/purchase_texture_image_vertical_margin"
            android:layout_marginRight="@dimen/p5d_space_20"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchaseTexturesProducts"
            app:srcCompat="@drawable/icon_purchase_textures"/>
        <LinearLayout
            android:id="@+id/purchaseTexturesBenefits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/purchase_texture_image_vertical_margin"
            android:layout_marginBottom="@dimen/p5d_space_x_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchaseTexturesImage"
            app:layout_constraintWidth_max="@dimen/content_max_width"
            style="@style/Planner5D.Purchase.TextureBenefits"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
