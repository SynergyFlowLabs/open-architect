<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/background_dialog_white"
    style="@style/Planner5D.Contest.Dialog">
    <com.planner5d.library.widget.AppBarLayout
        android:id="@+id/appBarLayout"
        android:background="@drawable/background_dialog_white_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/contestRulesCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:layout_marginBottom="@dimen/p5d_space_x_small"
            android:src="@drawable/icon_close_button"
            android:contentDescription="@string/close"
            android:layout_marginEnd="@dimen/p5d_space_x_small"/>
    </com.planner5d.library.widget.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:behavior_appBarLayoutId="@+id/appBarLayout"
        app:layout_behavior="com.planner5d.library.widget.toolbar.ToolbarShadowOnScrollBehavior">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="360dp"
            android:layout_height="wrap_content">
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/font_size_very_very_very_very_big"
                android:id="@+id/contestPrizesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:text="@string/contest_awards_prizes"
                android:layout_marginStart="@dimen/p5d_space_20"
                style="@style/Planner5D.TextView.Bold"/>
            <com.planner5d.library.widget.preloader.PreloaderSimpleV2View
                android:layout_gravity="center_horizontal"
                android:id="@+id/contestPrizesPreloader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:layout_marginBottom="@dimen/p5d_space_medium"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/prizes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
