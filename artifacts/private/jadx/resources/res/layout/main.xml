<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_content"
    android:background="@color/theme_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainCoordinator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/contentBackground"
            android:background="@null"
            android:visibility="visible"
            android:fitsSystemWindows="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.planner5d.library.widget.AppBarLayout
            android:id="@+id/main_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.planner5d.library.widget.Toolbar
                android:theme="@style/Theme.Planner5D.Toolbar"
                android:id="@+id/toolbar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/p5d_toolbar_height"
                style="@style/Planner5D.Toolbar"/>
            <com.planner5d.library.widget.ScalableTabLayout
                android:theme="@style/Theme.Planner5D.TabLayout.Material"
                android:id="@+id/toolbar_tabs"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabContentStart="0dp"
                app:tabIndicator="@drawable/tab_indicator_rounded"
                app:tabIndicatorFullWidth="false"
                app:tabMaxWidth="0dp"
                app:tabMinWidth="96dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="@dimen/p5d_space_xxx_small"
                app:tabPaddingStart="@dimen/p5d_space_xxx_small"
                app:tabTextAppearance="@style/Planner5D.TabLayout.TextAppearance.Material"
                app:tabTextColor="@color/tab_text"/>
        </com.planner5d.library.widget.AppBarLayout>
        <FrameLayout
            android:id="@+id/content"
            android:tag="content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:behavior_appBarLayoutId="@+id/main_app_bar"
            app:behavior_scrollableToolbarId="@+id/toolbar"
            app:layout_behavior="com.planner5d.library.widget.toolbar.ToolbarShadowOnScrollBehavior"/>
        <FrameLayout
            android:id="@+id/contentCover"
            android:tag="contentCover"
            android:background="@color/p5d_primary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:fitsSystemWindows="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/mainContentBlocker"
            android:background="@color/white_50"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:behavior_appBarLayoutId="@+id/main_app_bar"
            app:behavior_scrollableToolbarId="@+id/toolbar"
            app:layout_behavior="com.planner5d.library.widget.toolbar.ToolbarShadowOnScrollBehavior"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/mainListProgressIndicator"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border_thick"
            android:indeterminate="true"
            app:behavior_appBarLayoutId="@+id/main_app_bar"
            app:hideAnimationBehavior="outward"
            app:indicatorColor="@color/primary.fill.beta"
            app:layout_behavior="com.planner5d.library.widget.toolbar.ToolbarShadowOnScrollBehavior"
            app:showAnimationBehavior="inward"
            app:trackColor="@color/neutral.fill.gamma"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.planner5d.library.widget.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:elevation="@dimen/p5d_elevation_small"
        app:itemIconTint="@color/bottom_navigation_tab"
        app:itemTextAppearanceActive="@style/Planner5D.BottomNavigationView.ItemText"
        app:itemTextAppearanceInactive="@style/Planner5D.BottomNavigationView.ItemText"
        app:itemTextColor="@color/bottom_navigation_tab"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_navigation"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_message_coordinator"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/main_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:behavior_fitToContents="false"
            app:behavior_hideable="true"
            app:behavior_peekHeight="36dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <FrameLayout
        android:id="@+id/chat_bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.planner5d.library.widget.TooltipListenerView
        android:id="@+id/tooltip_touch_listener"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
