<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_round_large"
    android:layout_width="360dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/message_picture"
        android:layout_width="290dp"
        android:layout_height="164dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/message_close_button"
        android:background="@drawable/ripple_round"
        android:padding="@dimen/p5d_space_x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_close_button"/>
    <TextView
        android:textSize="@dimen/font_size_very_very_big"
        android:gravity="center_horizontal"
        android:id="@+id/message_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:layout_marginHorizontal="@dimen/p5d_space_medium"
        app:layout_constraintBottom_toTopOf="@+id/message_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_picture"
        style="@style/Planner5D.TextView.Bold"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_grey_1"
        android:gravity="center"
        android:id="@+id/message_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:letterSpacing="@dimen/p5d_letter_spacing_large"
        android:layout_marginHorizontal="@dimen/p5d_space_medium"
        app:layout_constraintBottom_toTopOf="@+id/message_ok_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_title"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/message_ok_button"
        android:background="@drawable/gradient_green"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginTop="@dimen/p5d_space_large"
        android:layout_marginBottom="@dimen/p5d_space_medium"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:layout_marginHorizontal="@dimen/p5d_space_medium"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_text"
        style="@style/Planner5D.TextView.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
