<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_black_round"
    android:padding="@dimen/p5d_space_20"
    android:layout_width="320dp"
    android:layout_height="340dp">
    <com.planner5d.library.widget.AnimatedImageView
        android:id="@+id/contestVotingCongratsAnimation"
        android:layout_width="170dp"
        android:layout_height="160dp"
        app:layout_constraintBottom_toTopOf="@+id/contestVotingCongratulationsText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_very_very_very_very_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/contestVotingCongratulationsText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_x_tiny"
        android:text="@string/desing_contest_voting_congrats_title"
        app:layout_constraintBottom_toTopOf="@+id/contestVotingCongratulationsSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.TextView.Bold"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_grey_2"
        android:gravity="center"
        android:id="@+id/contestVotingCongratulationsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_medium"
        android:text="@string/desing_contest_voting_congrats_subtitle"
        android:textAllCaps="false"
        app:layout_constraintBottom_toTopOf="@+id/contestVotingCongratulationsProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.TextView"/>
    <com.planner5d.library.contest.view.voting.ContestVotingProgressView
        android:id="@+id/contestVotingCongratulationsProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
