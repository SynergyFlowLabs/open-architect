<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="520dp"
            android:minWidth="320dp">
            <TextView
                android:textSize="@dimen/font_size_very_very_very_very_big"
                android:id="@+id/authenticationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_account_now"
                android:layout_marginStart="@dimen/p5d_space_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView.Bold"/>
            <TextView
                android:id="@+id/authenticationReason1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/authentication_reason_title_2"
                app:layout_constraintTop_toBottomOf="@+id/authenticationTitle"
                style="@style/Planner5D.Login.Reason"/>
            <TextView
                android:id="@+id/authenticationReason2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/authentication_reason_title_3"
                app:layout_constraintTop_toBottomOf="@+id/authenticationReason1"
                style="@style/Planner5D.Login.Reason"/>
            <TextView
                android:id="@+id/authenticationReason3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/authentication_reason_title_4"
                app:layout_constraintTop_toBottomOf="@+id/authenticationReason2"
                style="@style/Planner5D.Login.Reason"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/authenticationEmail"
                android:background="@drawable/background_button_default"
                android:layout_width="0dp"
                android:layout_height="@dimen/authentication_button_height"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/welcome_sign_up"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationReason3"
                style="@style/Planner5D.TextView.Medium"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/p5d_space_xxx_small"
                app:layout_constraintBottom_toBottomOf="@+id/authenticationEmail"
                app:layout_constraintStart_toStartOf="@+id/authenticationEmail"
                app:layout_constraintTop_toTopOf="@+id/authenticationEmail"
                app:srcCompat="@drawable/icon_email_filled_24"/>
            <com.planner5d.library.widget.textview.TextViewWithLine
                android:textColor="@color/p5d_grey"
                android:gravity="center"
                android:id="@+id/authenticationOrLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:text="@string/or_sign_up_with"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationEmail"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:gravity="center"
                android:id="@+id/authenticationGoogle"
                android:background="@drawable/background_button_secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/authentication_button_height"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/welcome_google"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationOrLabel"
                style="@style/Planner5D.TextView.Medium"/>
            <ImageView
                android:id="@+id/authenticationGoogleIcon"
                android:layout_width="@dimen/p5d_space_medium"
                android:layout_height="@dimen/p5d_space_medium"
                android:layout_marginStart="@dimen/p5d_space_xx_small"
                app:layout_constraintBottom_toBottomOf="@+id/authenticationGoogle"
                app:layout_constraintStart_toStartOf="@+id/authenticationGoogle"
                app:layout_constraintTop_toTopOf="@+id/authenticationGoogle"
                app:srcCompat="@drawable/icon_google_20"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:gravity="center"
                android:id="@+id/authenticationFacebook"
                android:background="@drawable/background_button_secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/authentication_button_height"
                android:layout_marginTop="@dimen/p5d_space_xx_small"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/welcome_facebook"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationGoogle"
                style="@style/Planner5D.TextView.Medium"/>
            <ImageView
                android:id="@+id/authenticationFacebookIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/p5d_space_xx_small"
                app:layout_constraintBottom_toBottomOf="@+id/authenticationFacebook"
                app:layout_constraintStart_toStartOf="@+id/authenticationFacebook"
                app:layout_constraintTop_toTopOf="@+id/authenticationFacebook"
                app:srcCompat="@drawable/icon_fb_24"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/p5d_grey_2"
                android:id="@+id/authenticationQuestion"
                android:background="@drawable/ripple_rounded_corners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:text="@string/already_have_an_account_question"
                android:layout_marginEnd="@dimen/p5d_space_tiny"
                app:layout_constraintBottom_toTopOf="@+id/authenticationAgreement"
                app:layout_constraintEnd_toStartOf="@+id/authenticationSignIn"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationFacebook"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/p5d_primary"
                android:id="@+id/authenticationSignIn"
                android:background="@drawable/ripple_rounded_corners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:layout_marginBottom="@dimen/p5d_space_medium"
                android:text="@string/sign_in"
                app:layout_constraintBottom_toTopOf="@+id/authenticationAgreement"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/authenticationQuestion"
                app:layout_constraintTop_toBottomOf="@+id/authenticationFacebook"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/p5d_grey_2"
                android:id="@+id/authenticationAgreement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:layout_marginBottom="@dimen/p5d_space_medium"
                android:textAlignment="center"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationQuestion"
                style="@style/Planner5D.TextView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
