<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/white_dialog_background"
    android:paddingBottom="@dimen/p5d_space_20"
    android:layout_width="320dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textColor="@color/p5d_grey_1"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingTop="17dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ai_tell_us_more"
        android:layout_marginHorizontal="@dimen/p5d_space_x_huge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <ImageView
        android:id="@+id/buttonClose"
        android:padding="@dimen/p5d_space_x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_close_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_text"
        android:textColorHint="@color/p5d_grey_3"
        android:gravity="top"
        android:id="@+id/edit"
        android:background="@drawable/ai_edit_background"
        android:layout_width="0dp"
        android:layout_height="158dp"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:hint="@string/ai_enter_your_comment"
        android:inputType="textMultiLine"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:enabled="false"
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/buttonRate"
        android:background="@drawable/green_button_background"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/rate_us"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit"
        style="@style/Planner5D.TextView.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
