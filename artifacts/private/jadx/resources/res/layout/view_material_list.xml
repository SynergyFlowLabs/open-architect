<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/materialsRecycler"
        android:paddingBottom="@dimen/p5d_space_medium"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.planner5d.library.widget.preloader.PreloaderCoverView
        android:id="@+id/materialsPreloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/materialsPlaceholder"
        android:paddingTop="@dimen/p5d_space_large"
        android:paddingBottom="@dimen/p5d_space_xx_huge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/p5d_space_large">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/materialsPlaceholderImage"
            android:layout_width="@dimen/placeholder_image_size"
            android:layout_height="@dimen/placeholder_image_size"
            android:src="@drawable/material_list_placeholder"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/materialsPlaceholderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_large"
            style="@style/Planner5D.TextView.Big.Grey.Medium"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/materialsPlaceholderMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            style="@style/Planner5D.TextView.Big.Grey"/>
    </LinearLayout>
</merge>
