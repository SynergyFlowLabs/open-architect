<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/buttonBack"
        android:padding="@dimen/p5d_space_xx_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/icon_back_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/neutral.text.alpha"
        android:id="@+id/buttonSkip"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_rounded_corners"
        android:text="@string/skip"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        android:paddingHorizontal="@dimen/p5d_space_x_small"
        android:paddingVertical="@dimen/p5d_space_xx_small"
        app:layout_constraintBottom_toBottomOf="@+id/buttonBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/buttonBack"
        style="@style/Planner5D.Text.Title_Small"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:paddingTop="@dimen/p5d_space_40"
        android:paddingBottom="@dimen/p5d_space_40"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineRecycler"
        app:layout_constraintWidth_max="@dimen/onboarding_recycler_max_width"/>
    <View
        android:background="@drawable/onboarding_fade_out"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_space_x_huge"
        android:rotation="180"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guidelineRecycler"/>
    <TextView
        android:textSize="@dimen/onboarding_title_font_size"
        android:textColor="@color/text.alpha"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_huge"
        android:letterSpacing="-0.021"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guidelineTitle"
        style="@style/Planner5D.Text.Headline_Small_W2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:background="@drawable/onboarding_fade_out"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_40"
            app:layout_constraintBottom_toTopOf="@+id/whiteMask"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/whiteMask"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/buttonContinue"/>
        <com.planner5d.library.widget.RoundedCornersLayout
            android:enabled="false"
            android:id="@+id/buttonContinue"
            android:layout_width="@dimen/onboarding_button_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            android:layout_marginBottom="@dimen/onboarding_button_bottom_margin"
            android:foreground="@drawable/ripple_rounded_corners"
            android:layout_marginStart="@dimen/onboarding_button_padding"
            android:layout_marginEnd="@dimen/onboarding_button_padding"
            app:cornerRadius="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:enabled="false"
                android:textColor="@color/button_text_default"
                android:gravity="center"
                android:id="@+id/buttonText"
                android:background="@drawable/onboarding_button_selector"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/continue_premium_purchase"
                android:textAllCaps="false"
                style="@style/Planner5D.TextView"/>
        </com.planner5d.library.widget.RoundedCornersLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/onboarding_title_top_margin"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineRecycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/onboarding_recycler_top_margin"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
