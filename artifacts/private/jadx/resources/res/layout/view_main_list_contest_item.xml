<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_main_list_contest_item_0"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:theme="@style/Theme.Planner5D.MaterialCard.Material"
        android:id="@+id/cardView"
        android:layout_width="@dimen/feed_long_card_width"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:stateListAnimator="@animator/card_press"
        app:cardCornerRadius="@dimen/p5d_corner_radius_large"
        app:cardElevation="@dimen/p5d_elevation_large">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/preview"
                android:layout_width="@dimen/main_list_card_height"
                android:layout_height="@dimen/main_list_card_height"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/success"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_small"
                android:src="@drawable/icon_success"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/p5d_space_xx_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/main_list_contest_item_title_text_size"
                android:textColor="@color/p5d_text"
                android:ellipsize="end"
                android:id="@+id/title"
                android:tag="binding_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_small"
                android:maxLines="2"
                android:layout_marginStart="@dimen/p5d_space_xx_small"
                android:layout_marginEnd="@dimen/p5d_space_xx_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/preview"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_small"
                android:textColor="@color/p5d_grey"
                android:ellipsize="end"
                android:id="@+id/subtitle"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_tiny"
                android:maxLines="2"
                android:layout_marginStart="@dimen/p5d_space_xx_small"
                android:layout_marginEnd="@dimen/p5d_space_xx_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/preview"
                app:layout_constraintTop_toBottomOf="@+id/title"
                style="@style/Planner5D.TextView"/>
            <com.planner5d.library.widget.textview.ButtonTextView
                android:textSize="@dimen/font_size_small"
                android:textColor="@color/white"
                android:id="@+id/vote"
                android:background="@drawable/gradient_green"
                android:paddingTop="@dimen/p5d_space_x_tiny"
                android:paddingBottom="@dimen/p5d_space_x_tiny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/p5d_space_xx_small"
                android:foreground="@drawable/ripple_rounded"
                android:paddingStart="@dimen/p5d_space_x_small"
                android:paddingEnd="@dimen/p5d_space_x_small"
                android:layout_marginEnd="@dimen/p5d_space_xx_small"
                app:backgroundCornerRadius="@dimen/p5d_corner_radius_large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
