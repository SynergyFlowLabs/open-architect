<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/p5d_space_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_size_very_very_big"
            android:id="@+id/projectSettingsMainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/project_settings"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textColor="@color/p5d_grey_1"
            android:id="@+id/projectSettingsTitleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:text="@string/project_title"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsMainTitle"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <com.google.android.material.textfield.TextInputLayout
            android:theme="@style/Theme.Planner5D.Form.Material"
            android:id="@+id/projectSettingsTitleInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:endIconMode="custom"
            app:errorIconDrawable="@null"
            app:helperText=" "
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsTitleLabel">
            <com.planner5d.library.widget.TextInputEditTextCompat
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_text"
                android:id="@+id/projectSettingsTitleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
                android:nextFocusForward="@+id/authenticationSignInPassword"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsBackgroundButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/background"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            app:drawableEndCompat="@drawable/icon_arrow_right_22"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsTitleInputLayout"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/projectSettingsBackgroundPreview"
            android:padding="@dimen/p5d_border"
            android:layout_width="72dp"
            android:layout_height="@dimen/p5d_space_large"
            android:scaleType="centerCrop"
            android:layout_marginEnd="@dimen/p5d_space_xx_large"
            app:layout_constraintBottom_toBottomOf="@+id/projectSettingsBackgroundButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/projectSettingsBackgroundButton"
            app:shapeAppearanceOverlay="@style/Planner5D.RoundedImageView"
            app:strokeColor="@color/p5d_grey_6"
            app:strokeWidth="@dimen/p5d_border"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsMeasurements"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:text="@string/view_option_measurements"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsBackgroundButton"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <TextView
            android:textColor="@color/button_text"
            android:gravity="center"
            android:id="@+id/projectSettingsMeasurementsMeter"
            android:background="@drawable/background_settings_measurements_left"
            android:layout_width="80dp"
            android:layout_height="@dimen/p5d_space_large"
            android:foreground="@drawable/ripple_rounded_corners"
            android:text="M, cm"
            app:layout_constraintBottom_toBottomOf="@+id/projectSettingsMeasurements"
            app:layout_constraintEnd_toStartOf="@+id/projectSettingsMeasurementsFoot"
            app:layout_constraintTop_toTopOf="@+id/projectSettingsMeasurements"/>
        <TextView
            android:textColor="@color/button_text"
            android:gravity="center"
            android:id="@+id/projectSettingsMeasurementsFoot"
            android:background="@drawable/background_settings_measurements_right"
            android:layout_width="80dp"
            android:layout_height="@dimen/p5d_space_large"
            android:foreground="@drawable/ripple_rounded_corners"
            android:text="F, inch"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintBottom_toBottomOf="@+id/projectSettingsMeasurements"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/projectSettingsMeasurements"/>
        <include
            android:id="@+id/projectSettingsHistoryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsMeasurements"
            layout="@layout/fragment_project_settings_main_history"/>
        <TextView
            android:textSize="@dimen/font_size_very_very_big"
            android:id="@+id/projectSettingsAdvancedSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/advanced_settings"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsHistoryButton"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsDisplayOptionsButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/project_settings_display_options"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            app:drawableEndCompat="@drawable/icon_arrow_right_22"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsAdvancedSettings"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:background="@color/p5d_grey_5"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsDisplayOptionsButton"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsGraphicsButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/graphics"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            app:drawableEndCompat="@drawable/icon_arrow_right_22"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsDisplayOptionsButton"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:background="@color/p5d_grey_5"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsGraphicsButton"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsActionsButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/actions"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            app:drawableEndCompat="@drawable/icon_arrow_right_22"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsGraphicsButton"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:background="@color/p5d_grey_5"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsActionsButton"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsControlsButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/controls_navigation"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            app:drawableEndCompat="@drawable/icon_arrow_right_22"
            app:layout_constraintTop_toBottomOf="@+id/projectSettingsActionsButton"
            style="@style/Planner5D.TextView.Big.Grey"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
