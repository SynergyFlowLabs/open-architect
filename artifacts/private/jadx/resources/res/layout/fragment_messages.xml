<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp"
    android:clickable="true"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:elevation="@dimen/p5d_elevation_medium">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:textColor="@color/form_text_color"
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:id="@+id/buttonPrimary"
        android:layout_width="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/buttonSecondary"
        app:layout_constraintRight_toRightOf="@+id/message"
        app:layout_constraintTop_toBottomOf="@+id/message"
        style="@style/Planner5D.Dialog.Button.Theme"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:id="@+id/buttonSecondary"
        android:layout_width="wrap_content"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/buttonPrimary"
        app:layout_constraintTop_toTopOf="@+id/buttonPrimary"
        style="@style/Planner5D.Dialog.Button"/>
    <TextView
        android:textSize="@dimen/font_size_very_small"
        android:textColor="@color/form_text_color_bright"
        android:ellipsize="end"
        android:id="@+id/messageCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:maxLines="3"
        app:layout_constraintBottom_toBottomOf="@+id/buttonPrimary"
        app:layout_constraintLeft_toLeftOf="@+id/message"
        app:layout_constraintRight_toLeftOf="@+id/buttonSecondary"
        app:layout_constraintTop_toTopOf="@+id/buttonPrimary"/>
    <View
        android:id="@+id/buttonExpand"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonPrimary"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
