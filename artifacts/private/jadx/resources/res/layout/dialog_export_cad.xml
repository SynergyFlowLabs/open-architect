<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textColor="@color/p5d_text"
        android:gravity="center_vertical"
        android:id="@+id/bottomSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_space_huge"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:text="@string/editor_export_to_cad_title"
        android:drawablePadding="@dimen/p5d_space_xx_small"
        android:paddingStart="@dimen/p5d_space_20"
        android:paddingEnd="@dimen/p5d_space_medium"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <ImageView
        android:id="@+id/buttonClose"
        android:padding="@dimen/p5d_space_xx_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_close_bottom_sheet"
        android:contentDescription="@string/close"
        app:layout_constraintBottom_toBottomOf="@+id/bottomSheetTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomSheetTitle"/>
    <View
        android:id="@+id/bottomSheetDivider"
        android:background="@color/p5d_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_border"
        app:layout_constraintTop_toBottomOf="@+id/bottomSheetTitle"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:id="@+id/exportDxf"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_space_huge"
        android:text="@string/editor_export_to_cad_dxf"
        android:drawablePadding="@dimen/p5d_space_xx_small"
        android:paddingHorizontal="@dimen/p5d_space_xx_small"
        app:drawableStartCompat="@drawable/icon_export_dxf"
        app:layout_constraintTop_toBottomOf="@+id/bottomSheetDivider"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:id="@+id/exportDwg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_space_huge"
        android:text="@string/editor_export_to_cad_dwg"
        android:drawablePadding="@dimen/p5d_space_xx_small"
        android:paddingHorizontal="@dimen/p5d_space_xx_small"
        app:drawableStartCompat="@drawable/icon_export_dwg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exportDxf"/>
</androidx.constraintlayout.widget.ConstraintLayout>
