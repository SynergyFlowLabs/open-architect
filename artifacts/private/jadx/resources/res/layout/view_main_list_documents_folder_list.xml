<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_main_list_documents_folder_list_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/ripple_white">
    <View
        android:tag="binding_1"
        android:background="@drawable/background_item_selected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/p5d_space_x_tiny"
        android:layout_marginVertical="@dimen/p5d_space_xx_tiny"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatToggleButton
        android:id="@+id/selection_tag"
        android:tag="binding_2"
        android:background="@null"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:button="@drawable/icon_selection_tag"
        android:layout_marginStart="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/spaceImage"
        android:layout_width="@dimen/p5d_main_list_button_icon_size"
        android:layout_height="@dimen/p5d_main_list_button_icon_size"
        android:layout_marginTop="@dimen/p5d_space_xxx_small"
        android:layout_marginBottom="@dimen/p5d_space_xxx_small"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/selection_tag"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageFolder"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_folder"
        android:src="@drawable/icon_folder_white"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:tintMode="multiply"
        app:layout_constraintBottom_toBottomOf="@+id/spaceImage"
        app:layout_constraintEnd_toEndOf="@+id/spaceImage"
        app:layout_constraintStart_toStartOf="@+id/spaceImage"
        app:layout_constraintTop_toTopOf="@+id/spaceImage"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:id="@+id/title"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_xx_small"
        app:layout_constraintBottom_toTopOf="@+id/summary"
        app:layout_constraintEnd_toStartOf="@+id/buttonMenu"
        app:layout_constraintStart_toEndOf="@+id/spaceImage"
        app:layout_constraintTop_toTopOf="@+id/spaceImage"
        style="@style/Planner5D.TextView.Item"/>
    <TextView
        android:id="@+id/summary"
        android:tag="binding_5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        app:layout_constraintBottom_toBottomOf="@+id/spaceImage"
        app:layout_constraintEnd_toStartOf="@+id/buttonMenu"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Planner5D.TextView.Meta"/>
    <ImageButton
        android:id="@+id/buttonMenu"
        android:tag="binding_6"
        android:background="@null"
        android:layout_width="@dimen/p5d_space_large"
        android:layout_height="@dimen/p5d_space_large"
        android:foreground="@drawable/ripple_rounded_corners"
        android:src="@drawable/icon_menu_list"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintBottom_toBottomOf="@+id/summary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:tint="@color/p5d_grey_3"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_x_tiny"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
