<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheet"
    android:background="@drawable/background_surface_beta_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/dragHandle"
        android:background="@drawable/background_grey_round"
        android:layout_width="@dimen/bottom_sheet_drag_handle_width"
        android:layout_height="@dimen/bottom_sheet_drag_handle_height"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:layout_marginBottom="@dimen/p5d_space_x_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/titleContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:minHeight="@dimen/p5d_space_x_huge"
        app:layout_constraintTop_toBottomOf="@+id/dragHandle">
        <TextView
            android:textColor="@color/text.alpha"
            android:gravity="center_vertical"
            android:id="@+id/bottomSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:drawablePadding="@dimen/p5d_space_xx_small"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_medium"
            style="@style/Planner5D.Text.Title_Large"/>
        <TextView
            android:textColor="@color/text.gamma"
            android:gravity="center_vertical"
            android:id="@+id/bottomSheetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_medium"
            android:drawablePadding="@dimen/p5d_space_xx_small"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_medium"
            style="@style/Planner5D.Text.Body_Medium"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bottomSheetList"
        android:paddingBottom="@dimen/p5d_space_20"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toBottomOf="@+id/titleContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
