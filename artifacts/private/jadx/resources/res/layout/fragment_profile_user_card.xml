<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/profileUserCard"
    android:background="@drawable/background_white_round_large"
    android:paddingBottom="@dimen/p5d_space_x_small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/p5d_space_20"
    android:maxWidth="@dimen/profile_action_card_max_width"
    android:layout_marginStart="@dimen/p5d_space_20"
    android:layout_marginEnd="@dimen/p5d_space_20"
    android:elevation="@dimen/p5d_elevation_large">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/profile_action_card_max_width">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small">
            <com.planner5d.library.widget.ProfileIconView
                android:layout_gravity="center"
                android:id="@+id/profileImage"
                android:layout_width="@dimen/profile_image_size"
                android:layout_height="@dimen/profile_image_size"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/pro_badge"
                android:background="@drawable/gradient_pro_profile_badge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginTop="-2dp"
                android:text="@string/pro_pro"
                android:layout_marginEnd="@dimen/p5d_space_large"
                android:paddingHorizontal="@dimen/p5d_space_xxx_small"
                android:paddingVertical="@dimen/p5d_space_xx_tiny"
                style="@style/Planner5D.TextView.Medium"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/font_size_very_very_big"
            android:layout_gravity="center"
            android:id="@+id/profileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textSize="@dimen/font_size_normal"
            android:textColor="@color/p5d_grey"
            android:layout_gravity="center"
            android:id="@+id/profileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            style="@style/Planner5D.TextView"/>
        <com.planner5d.library.widget.textview.ButtonTextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/profileUpgradeToPremiumButton"
            android:background="@drawable/gradient_green"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:foreground="@drawable/ripple_rounded_corners_huge"
            android:text="@string/upgrade_to_premium"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            android:layout_marginEnd="@dimen/p5d_space_x_small"
            app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
            style="@style/Planner5D.TextView.Medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
