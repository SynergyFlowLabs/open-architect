<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/purchasePremiumScrollView"
    android:background="@drawable/gradient_paywall"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:src="@drawable/icon_logo_full_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/purchase_title_font_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginTop="@dimen/purchase_trial_title_top"
            android:text="@string/purchases_switch_paywall_colored_title"
            android:paddingHorizontal="@dimen/purchase_title_padding"
            app:autoSizeMaxTextSize="@dimen/purchase_title_font_size"
            app:autoSizeMinTextSize="@dimen/font_size_small"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo"
            app:layout_constraintVertical_chainStyle="spread"
            style="@style/Planner5D.TextView.Bold"/>
        <TextView
            android:textSize="@dimen/purchase_marquee_font_size"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@+id/marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/purchase_trial_marquee_top"
            android:layout_marginBottom="@dimen/p5d_space_x_huge"
            android:text="@string/purchases_pro_color_scroll_label"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/Planner5D.TextView.Medium"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/purchasePremiumProducts"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/disclaimerText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width">
            <include
                android:id="@+id/trial_switch"
                layout="@layout/view_purchase_trial_switch"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/purchasePremiumList"
                android:clipChildren="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="@dimen/p5d_space_x_small"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/trial_switch"/>
            <com.planner5d.library.widget.preloader.PreloaderCoverView
                android:id="@+id/purchasePremiumProductListPreloader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/trial_switch"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/error"
                android:gravity="center"
                android:id="@+id/purchasePremiumErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/p5d_space_medium"
                android:layout_marginEnd="@dimen/p5d_space_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/purchase_premium_content_max_width"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/font_size_small"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/disclaimerText"
            android:paddingTop="@dimen/p5d_space_tiny"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/purchases_subscription_disclaimer"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:layout_constraintBottom_toTopOf="@+id/purchasePremiumTerms"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Planner5D.TextView"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:orientation="horizontal"
            android:id="@+id/purchaseTermsFlow"
            android:paddingTop="@dimen/purchase_trial_terms_margin_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="purchasePremiumTerms,purchasePremiumPrivacy,purchasePremiumRestore"
            app:flow_horizontalStyle="packed"
            app:flow_wrapMode="chain"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/white"
            android:id="@+id/purchasePremiumTerms"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy_message_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/purchasePremiumPrivacy"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProducts"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/white"
            android:id="@+id/purchasePremiumPrivacy"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy_policy"
            app:layout_constraintEnd_toStartOf="@+id/purchasePremiumRestore"
            app:layout_constraintStart_toEndOf="@+id/purchasePremiumTerms"
            app:layout_constraintTop_toTopOf="@+id/purchasePremiumTerms"/>
        <TextView
            android:textSize="@dimen/purchase_terms_font_size"
            android:textColor="@color/white"
            android:id="@+id/purchasePremiumRestore"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchases_button_restore"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/purchasePremiumPrivacy"
            app:layout_constraintTop_toTopOf="@+id/purchasePremiumTerms"/>
        <com.planner5d.library.widget.preloader.PreloaderCoverView
            android:id="@+id/purchasesDialogPreloader"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
