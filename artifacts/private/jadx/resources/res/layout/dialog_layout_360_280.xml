<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="280dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="360dp"
        android:layout_height="280dp">
        <TextView
            android:textColor="#ff444444"
            android:gravity="center"
            android:id="@+id/title"
            android:background="#ffe0e0e0"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/folder_selection_header_height"/>
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="right"
            android:id="@+id/dialog_button_container"
            android:background="#ffe0e0e0"
            android:paddingLeft="24dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/folder_selection_header_height">
            <Button
                android:textColor="@color/main_theme_color"
                android:gravity="center"
                android:id="@+id/button_additional"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/Cancel"
                android:textAllCaps="true"
                style="?android:attr/borderlessButtonStyle"/>
            <Button
                android:textColor="@color/main_theme_color"
                android:gravity="center"
                android:id="@+id/button_cancel"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/Cancel"
                android:textAllCaps="true"
                style="?android:attr/borderlessButtonStyle"/>
            <Button
                android:textColor="@color/main_theme_color"
                android:gravity="center"
                android:id="@+id/button_save"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/save"
                android:textAllCaps="true"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
    <com.planner5d.library.widget.preloader.PreloaderBoxView
        android:id="@+id/preloader"
        android:layout_width="360dp"
        android:layout_height="280dp"/>
</FrameLayout>
