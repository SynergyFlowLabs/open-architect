<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.planner5d.library.widget.carousel.CarouselView
        android:id="@+id/rendersCarousel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="360:313"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.planner5d.library.widget.ProfileIconView
        android:id="@+id/winnerAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="@dimen/p5d_space_xx_small"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        app:imageSize="28dp"
        app:layout_constraintBottom_toTopOf="@+id/slidesIndicator"
        app:layout_constraintStart_toStartOf="@+id/winnerPlace"/>
    <com.planner5d.library.widget.ContestPlaceBadgeView
        android:id="@+id/winnerPlace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/carousel_indicator_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/winnerAvatar"
        app:layout_constraintStart_toStartOf="@+id/slidesIndicator"
        app:layout_constraintTop_toTopOf="@+id/winnerAvatar"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/winnerName"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        android:letterSpacing="-0.02"
        app:layout_constraintBottom_toBottomOf="@+id/winnerAvatar"
        app:layout_constraintStart_toEndOf="@+id/winnerAvatar"
        app:layout_constraintTop_toTopOf="@+id/winnerAvatar"
        style="@style/Planner5D.Contest.Archive.Carousel.Name"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:id="@+id/winnerPercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_medium"
        android:layout_marginEnd="@dimen/carousel_indicator_margin_horizontal"
        app:layout_constraintBaseline_toBaselineOf="@+id/winnerName"
        style="@style/Planner5D.Contest.Archive.Carousel.Percentage"/>
    <View
        android:id="@+id/slidesIndicator"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginBottom="@dimen/carousel_indicator_margin_bottom"
        app:layout_constraintBottom_toBottomOf="@+id/rendersCarousel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
