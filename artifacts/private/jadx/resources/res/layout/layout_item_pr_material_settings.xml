<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/material_settings_texture_mode"
        style="@style/Planner5D.RadioGroupTitle"/>
    <RadioGroup
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny">
        <RadioButton
            android:id="@+id/texture_mode_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/material_settings_tile_mode"
            android:layout_weight="1"
            android:drawableEnd="@drawable/icon_radio_button"
            android:paddingHorizontal="@dimen/p5d_space_xx_small"
            android:paddingVertical="@dimen/p5d_space_tiny"
            style="@style/Planner5D.RadioButton"/>
        <RadioButton
            android:id="@+id/texture_mode_stretch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/material_settings_stretch_mode"
            android:layout_weight="1"
            android:drawableEnd="@drawable/icon_radio_button"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            android:paddingHorizontal="@dimen/p5d_space_xx_small"
            android:paddingVertical="@dimen/p5d_space_tiny"
            style="@style/Planner5D.RadioButton"/>
    </RadioGroup>
    <TextView
        android:id="@+id/texture_alignment_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_large"
        android:text="@string/material_settings_texture_alignment"
        style="@style/Planner5D.RadioGroupTitle"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/texture_alignment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny">
        <RadioButton
            android:id="@+id/texture_alignment_center"
            android:padding="@dimen/p5d_space_x_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/material_settings_alignment_center"
            android:drawableTop="@drawable/ic_center"
            android:drawablePadding="@dimen/p5d_space_xxx_small"
            android:layout_weight="1"
            android:textAlignment="center"
            style="@style/Planner5D.RadioButton"/>
        <RadioButton
            android:id="@+id/texture_alignment_corner"
            android:padding="@dimen/p5d_space_x_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/material_settings_alignment_corner"
            android:drawableTop="@drawable/ic_corner"
            android:drawablePadding="@dimen/p5d_space_xxx_small"
            android:layout_weight="1"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            style="@style/Planner5D.RadioButton"/>
    </RadioGroup>
</LinearLayout>
