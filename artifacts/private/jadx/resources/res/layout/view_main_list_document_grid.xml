<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWrapper"
    android:tag="layout/view_main_list_document_grid_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/ripple_white"
    android:stateListAnimator="@animator/card_press">
    <View
        android:tag="binding_1"
        android:background="@drawable/background_item_selected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-12dp"
        android:layout_marginHorizontal="-8dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.planner5d.library.widget.RoundedCornersLayout
        android:id="@+id/imageWrapper"
        android:background="@drawable/background_button_project_medium"
        android:padding="@dimen/p5d_border"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cornerRadius="@dimen/p5d_corner_radius_large"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/image_document_placeholder"
            android:scaleType="centerCrop"/>
        <FrameLayout
            android:id="@+id/download_button"
            android:background="@color/absolute.black.B25"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/ripple_white">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/download_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_download_white_round"/>
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_gravity="center"
                android:id="@+id/progress"
                android:visibility="gone"
                android:layout_width="@dimen/p5d_space_x_large"
                android:layout_height="@dimen/p5d_space_x_large"
                app:indicatorColor="@color/white"
                app:indicatorSize="@dimen/progress_indicator_size"
                app:trackColor="@color/transparent"
                app:trackCornerRadius="@dimen/p5d_corner_radius_progress_indicator"
                app:trackThickness="@dimen/progress_indicator_track_thickness"/>
        </FrameLayout>
    </com.planner5d.library.widget.RoundedCornersLayout>
    <androidx.appcompat.widget.AppCompatToggleButton
        android:id="@+id/selection_tag"
        android:tag="binding_2"
        android:background="@null"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="@dimen/p5d_space_xxx_small"
        android:button="@drawable/icon_selection_tag"
        app:layout_constraintBottom_toBottomOf="@+id/imageWrapper"
        app:layout_constraintStart_toStartOf="@+id/imageWrapper"/>
    <TextView
        android:textColor="@color/text.alpha"
        android:id="@+id/title"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_20"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:singleLine="true"
        app:layout_constraintEnd_toStartOf="@+id/buttonMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageWrapper"
        style="@style/Planner5D.Text.Title_ExtraSmall"/>
    <TextView
        android:textColor="@color/text.gamma"
        android:id="@+id/summary"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_x_small"
        android:layout_marginTop="@dimen/p5d_space_xx_tiny"
        android:singleLine="true"
        app:layout_constraintEnd_toStartOf="@+id/buttonMenu"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Planner5D.Text.Misc_Caption"/>
    <ImageButton
        android:id="@+id/buttonMenu"
        android:tag="binding_5"
        android:background="@null"
        android:layout_width="@dimen/p5d_space_large"
        android:layout_height="@dimen/p5d_space_large"
        android:foreground="@drawable/ripple_rounded_corners"
        android:src="@drawable/icon_menu_list"
        app:layout_constraintBottom_toBottomOf="@+id/summary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:tint="@color/p5d_grey_3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
