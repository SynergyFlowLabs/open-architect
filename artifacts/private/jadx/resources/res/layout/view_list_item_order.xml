<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/column0"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/p5d_space_x_small"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.ListOrderItemColumn"/>
    <TextView
        android:id="@+id/column1"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/column0"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.ListOrderItemColumn"/>
    <TextView
        android:id="@+id/column2"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/column1"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.ListOrderItemColumn"/>
    <TextView
        android:id="@+id/column3"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/column2"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.ListOrderItemColumn"/>
    <ImageButton
        android:id="@+id/button"
        android:layout_width="36dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/column0"
        app:layout_constraintLeft_toRightOf="@+id/column3"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</androidx.constraintlayout.widget.ConstraintLayout>
