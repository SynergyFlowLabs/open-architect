<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_main_list_design_generator_0"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:theme="@style/Theme.Planner5D.MaterialCard.Material"
        android:id="@+id/card_view"
        android:layout_width="@dimen/feed_long_card_width"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:stateListAnimator="@animator/card_press"
        app:cardCornerRadius="@dimen/p5d_corner_radius_large"
        app:cardElevation="@dimen/p5d_elevation_large">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/preview"
                android:layout_width="140dp"
                android:layout_height="@dimen/main_list_card_height"
                android:src="@drawable/design_generator_entry_point"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/gradient_white"
                android:layout_width="140dp"
                android:layout_height="@dimen/main_list_card_height"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/main_list_contest_item_title_text_size"
                android:textColor="@color/p5d_text"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_small"
                android:text="@string/tools_autostyles_main_title"
                android:maxLines="2"
                android:layout_marginStart="@dimen/p5d_space_xx_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_small"
                android:textColor="@color/p5d_grey"
                android:ellipsize="end"
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_tiny"
                android:text="@string/tools_autostyles_main_subtitle"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/roboto_regular_w400"
                android:layout_marginStart="@dimen/p5d_space_xx_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <com.planner5d.library.widget.textview.ButtonTextView
                android:textSize="@dimen/font_size_small"
                android:textColor="@color/white"
                android:id="@+id/start"
                android:background="@drawable/gradient_green"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/p5d_space_xx_small"
                android:foreground="@drawable/ripple_rounded"
                android:text="@string/design_generator_start"
                android:layout_marginHorizontal="@dimen/p5d_space_xx_small"
                android:paddingHorizontal="23dp"
                android:paddingVertical="5dp"
                app:backgroundCornerRadius="@dimen/p5d_corner_radius_large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
