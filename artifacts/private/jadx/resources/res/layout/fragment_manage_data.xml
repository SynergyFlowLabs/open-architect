<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/manage_data_horizontal_padding"
        android:layout_marginEnd="@dimen/manage_data_horizontal_padding">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.planner5d.library.activity.fragment.settings.ViewManagedFiles
                android:layout_gravity="center_horizontal"
                android:id="@+id/manageDataFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"/>
            <com.planner5d.library.activity.fragment.settings.ViewDataRemoval
                android:layout_gravity="center_horizontal"
                android:id="@+id/manageDataPersonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:layout_marginBottom="@dimen/p5d_space_large"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.planner5d.library.widget.preloader.PreloaderCoverView
        android:id="@+id/manageDataPreloader"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
