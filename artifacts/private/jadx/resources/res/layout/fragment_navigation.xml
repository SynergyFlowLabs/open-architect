<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.planner5d.library.widget.AppBarLayout
        android:id="@+id/navigation_app_bar_layout"
        android:background="@color/theme_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.planner5d.library.widget.Toolbar
            android:theme="@style/Theme.Planner5D.Toolbar"
            android:id="@+id/navigation_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_toolbar_height"
            style="@style/Planner5D.Toolbar"/>
        <com.planner5d.library.widget.ScalableTabLayout
            android:theme="@style/Theme.Planner5D.TabLayout.Material"
            android:id="@+id/navigation_toolbar_tabs"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabContentStart="0dp"
            app:tabIndicator="@drawable/tab_indicator_rounded"
            app:tabIndicatorColor="@color/text.alpha"
            app:tabIndicatorFullWidth="false"
            app:tabMaxWidth="0dp"
            app:tabMinWidth="96dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="@dimen/p5d_space_xxx_small"
            app:tabPaddingStart="@dimen/p5d_space_xxx_small"
            app:tabTextAppearance="@style/Planner5D.TabLayout.TextAppearance.Material"
            app:tabTextColor="@color/text.alpha"/>
    </com.planner5d.library.widget.AppBarLayout>
    <androidx.fragment.app.FragmentContainerView
        android:name="com.planner5d.library.util.navigation.uistate.UiStateNavHostFragment"
        android:id="@+id/navigation_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_appBarLayoutId="@+id/navigation_app_bar_layout"
        app:behavior_scrollableToolbarId="@+id/navigation_toolbar"
        app:defaultNavHost="true"
        app:layout_behavior="com.planner5d.library.widget.toolbar.ToolbarShadowOnScrollBehavior"/>
    <View
        android:id="@+id/navigation_content_blocker"
        android:background="@color/white_50"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_appBarLayoutId="@+id/navigation_app_bar_layout"
        app:layout_behavior="com.planner5d.library.widget.toolbar.ToolbarShadowOnScrollBehavior"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/navigation_progress_indicator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_border_thick"
        android:indeterminate="true"
        app:behavior_appBarLayoutId="@+id/navigation_app_bar_layout"
        app:hideAnimationBehavior="outward"
        app:indicatorColor="@color/primary.fill.beta"
        app:layout_behavior="com.planner5d.library.widget.toolbar.ToolbarShadowOnScrollBehavior"
        app:showAnimationBehavior="inward"
        app:trackColor="@color/neutral.fill.gamma"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
