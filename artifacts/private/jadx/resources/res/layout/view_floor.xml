<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="start"
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp">
        <com.planner5d.library.widget.ImageButtonWithStates
            android:id="@+id/grab_button"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="@dimen/p5d_space_huge"
            android:scaleType="center"
            style="?attr/actionOverflowButtonStyle"/>
        <com.planner5d.library.widget.textview.TextViewWithStates
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/drawer_text"
            android:gravity="center"
            android:id="@+id/floor_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/p5d_space_huge"/>
        <ImageView
            android:id="@+id/selected_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/p5d_space_huge"
            android:src="@drawable/icon_check"
            android:layout_marginStart="@dimen/p5d_space_x_small"/>
    </LinearLayout>
    <com.planner5d.library.widget.ImageButtonWithStates
        android:layout_gravity="end"
        android:id="@+id/button_menu"
        android:layout_width="30dp"
        android:layout_height="@dimen/p5d_space_huge"
        android:scaleType="center"
        style="?attr/actionOverflowButtonStyle"/>
</merge>
