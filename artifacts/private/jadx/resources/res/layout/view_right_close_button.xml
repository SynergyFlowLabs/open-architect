<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/barBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_toolbar_height"
        app:layout_constraintBottom_toBottomOf="@+id/buttonClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/buttonClose"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/buttonClose"
        android:background="@drawable/ripple_rounded"
        android:padding="@dimen/p5d_space_x_small"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/icon_close"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
