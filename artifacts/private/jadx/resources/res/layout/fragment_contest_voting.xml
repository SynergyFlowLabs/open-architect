<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_contest_voting"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.planner5d.library.contest.view.voting.ContestVotingItemView
        android:id="@+id/item0"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/item1"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Planner5D.Contest.Voting.Item"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/item0preloader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/white"
        app:indicatorSize="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="@+id/item0"
        app:layout_constraintLeft_toLeftOf="@+id/item0"
        app:layout_constraintRight_toRightOf="@+id/item0"
        app:layout_constraintTop_toTopOf="@+id/item0"
        app:trackThickness="@dimen/p5d_border_medium"/>
    <com.planner5d.library.contest.view.voting.ContestVotingItemView
        android:id="@+id/item1"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        app:layout_constraintBottom_toTopOf="@+id/contestVotingProgress"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="@+id/item0"
        app:layout_constraintRight_toRightOf="@+id/item0"
        app:layout_constraintTop_toBottomOf="@+id/item0"
        style="@style/Planner5D.Contest.Voting.Item"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/item1preloader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/white"
        app:indicatorSize="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="@+id/item1"
        app:layout_constraintLeft_toLeftOf="@+id/item1"
        app:layout_constraintRight_toRightOf="@+id/item1"
        app:layout_constraintTop_toTopOf="@+id/item1"
        app:trackThickness="@dimen/p5d_border_medium"/>
    <com.planner5d.library.contest.view.voting.ContestVotingProgressView
        android:id="@+id/contestVotingProgress"
        android:paddingTop="@dimen/p5d_space_x_small"
        android:paddingBottom="@dimen/p5d_space_x_small"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintLeft_toLeftOf="@+id/item1"
        app:layout_constraintRight_toRightOf="@+id/item1"
        app:layout_constraintTop_toBottomOf="@+id/item1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/font_size_normal"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingTop="@dimen/p5d_space_tiny"
        android:paddingBottom="@dimen/p5d_space_x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/p5d_space_40"
        android:paddingEnd="@dimen/p5d_space_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/item1"
        app:layout_constraintRight_toRightOf="@+id/item1"
        app:layout_constraintTop_toBottomOf="@+id/contestVotingProgress"
        style="@style/Planner5D.TextView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
