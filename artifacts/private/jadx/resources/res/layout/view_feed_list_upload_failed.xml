<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:theme="@style/Theme.Planner5D.MaterialCard.Material"
        android:id="@+id/imageWrapper"
        android:layout_width="@dimen/feed_projects_image_size"
        android:layout_height="@dimen/feed_projects_image_size"
        android:layout_marginTop="@dimen/p5d_space_xxx_small"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginStart="@dimen/p5d_space_xxx_small"
        android:layout_marginEnd="@dimen/p5d_space_xxx_small"
        android:stateListAnimator="@animator/card_press"
        app:cardCornerRadius="@dimen/p5d_corner_radius_large"
        app:cardElevation="@dimen/p5d_elevation_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/progressImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/p5d_space_medium"
            android:src="@drawable/icon_exclamation_triangle"/>
        <TextView
            android:textSize="@dimen/font_size_small"
            android:textColor="@color/p5d_grey_2_5"
            android:layout_gravity="center"
            android:id="@+id/buttonLearn"
            android:background="@drawable/background_button_project_failed_learn_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_large"
            android:text="@string/learn_more"
            android:paddingHorizontal="@dimen/p5d_space_x_small"
            android:paddingVertical="@dimen/p5d_space_tiny"
            style="@style/Planner5D.TextView.Medium"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:ellipsize="end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:text="@string/ai_recognition_failed"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="@+id/imageWrapper"
        app:layout_constraintStart_toStartOf="@+id/imageWrapper"
        app:layout_constraintTop_toBottomOf="@+id/imageWrapper"
        style="@style/Planner5D.TextView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
