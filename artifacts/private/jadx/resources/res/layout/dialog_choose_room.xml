<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/white_dialog_background_no_stroke"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="320dp">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="168dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:src="@drawable/icon_curved_hands"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="@dimen/p5d_space_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/buttonClose"
        android:padding="@dimen/p5d_space_x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_close_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_40"
        android:text="@string/ai_designer_choose_room"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_grey_1_dark"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:text="@string/room_wizard_need_select_room_message"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Planner5D.TextView"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/buttonYes"
        android:background="@drawable/gradient_green"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginTop="@dimen/p5d_space_medium"
        android:layout_marginBottom="@dimen/p5d_space_x_small"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/contest_continue"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        style="@style/Planner5D.TextView.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
