<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_app_bar_layout"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/supportScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:behavior_appBarLayoutId="@+id/appBarLayout"
        app:behavior_scrollableToolbarId="@+id/toolbar"
        app:layout_behavior="com.planner5d.library.widget.toolbar.ToolbarShadowOnScrollBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxWidth="704dp">
            <com.planner5d.library.widget.textview.TextViewFormField
                android:textSize="@dimen/font_size_big"
                android:gravity="center_vertical"
                android:id="@+id/supportTopic"
                android:background="@drawable/ripple_rectangle"
                android:focusable="true"
                android:nextFocusUp="@+id/supportButtonSend"
                android:nextFocusDown="@+id/supportEmail"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_huge"
                android:layout_marginTop="@dimen/p5d_space_large"
                android:text="@string/support_topic"
                android:paddingStart="@dimen/p5d_space_medium"
                android:paddingEnd="@dimen/p5d_space_20"
                app:drawableEndCompat="@drawable/icon_arrow_right_22"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
            <View
                android:background="@color/p5d_grey_5"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/p5d_space_medium"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/supportTopic"/>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:textColorHint="@color/p5d_grey_2"
                android:id="@+id/supportEmailLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_large"
                android:hint="@string/email"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:endIconDrawable="@null"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:errorTextAppearance="@style/ErrorTextStyle"
                app:helperText=" "
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/supportTopic">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:theme="@style/Theme.Planner5D.Form.Material"
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/p5d_text"
                    android:id="@+id/supportEmail"
                    android:nextFocusUp="@+id/supportTopic"
                    android:nextFocusDown="@+id/supportDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:maxLines="1"
                    android:inputType="textEmailAddress"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:id="@+id/supportDescriptionLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:endIconDrawable="@null"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:errorTextAppearance="@style/ErrorTextStyle"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/supportEmailLayout">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:theme="@style/Theme.Planner5D.Form.Material"
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/p5d_text"
                    android:textColorHint="@color/p5d_grey_2"
                    android:gravity="start|top"
                    android:id="@+id/supportDescription"
                    android:nextFocusUp="@+id/supportEmail"
                    android:nextFocusDown="@+id/supportButtonSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:hint="@string/placeholder_problem_description"
                    android:maxLines="@integer/support_input_field_height"
                    android:lines="@integer/support_input_field_height"
                    android:minLines="@integer/support_input_field_height"
                    android:inputType="textMultiLine"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.planner5d.library.widget.editor.projectsettings.ProjectSettingCheckboxView
                android:id="@+id/supportAttachProjects"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_large"
                android:layout_marginStart="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/supportDescriptionLayout"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/button_text_default"
                android:gravity="center"
                android:id="@+id/supportButtonSend"
                android:background="@drawable/background_button_default"
                android:paddingLeft="@dimen/p5d_space_medium"
                android:paddingRight="@dimen/p5d_space_medium"
                android:nextFocusUp="@+id/supportDescription"
                android:nextFocusDown="@+id/supportTopic"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_xx_large"
                android:layout_marginTop="@dimen/p5d_space_large"
                android:layout_marginBottom="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/send"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/supportAttachProjects"
                app:layout_constraintVertical_bias="1"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.planner5d.library.widget.preloader.PreloaderSimpleV2View
        android:id="@+id/supportDialogPreloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
