<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message"
    android:paddingTop="@dimen/p5d_space_x_tiny"
    android:paddingBottom="@dimen/p5d_space_tiny"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text.alpha"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_40"
        android:paddingVertical="@dimen/p5d_space_xxx_small"
        app:layout_constraintBottom_toTopOf="@+id/commands"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/Planner5D.Text.Body_Medium"/>
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/commands"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:chipSpacingVertical="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_paywall"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_x_large"
        android:layout_marginTop="22dp"
        android:text="@string/ai_chat_subscribe_button_text"
        android:drawablePadding="@dimen/p5d_space_x_tiny"
        android:layout_marginHorizontal="@dimen/p5d_space_x_large"
        app:icon="@drawable/icon_lock"
        app:iconGravity="textStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"
        style="@style/Planner5D.UnelevatedButton"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/loader"
        android:paddingBottom="@dimen/p5d_space_medium"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.planner5d.library.widget.preloader.shimmer.ShimmerTextView
            android:textColor="@color/neutral.fill.alpha"
            android:id="@+id/reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_chat_thinking"
            app:shimmerAlpha="1"
            app:shimmerColor="@color/text.gamma"
            app:shimmerDuration="@integer/animation_duration_very_very_slow"
            style="@style/Planner5D.Text.Title_Small"/>
        <ImageView
            android:id="@+id/bar_one"
            android:background="@drawable/thinking_shimmer"
            android:layout_width="74dp"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:src="@drawable/placeholder_shimmer_ai_chat"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/bar_two"
            android:background="@drawable/thinking_shimmer"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/space_3"
            android:src="@drawable/placeholder_shimmer_ai_chat"
            android:scaleType="centerCrop"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
