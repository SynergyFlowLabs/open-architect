<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/survey_button_back"
        android:padding="@dimen/p5d_space_xx_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/icon_back_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:theme="@style/Theme.Planner5D.Material3"
        android:id="@+id/survey_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:progress="40"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="6dp"
        app:indicatorColor="@color/primary.icon.gamma"
        app:layout_constraintBottom_toBottomOf="@+id/survey_step_nr"
        app:layout_constraintEnd_toStartOf="@+id/survey_step_nr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/survey_step_nr"
        app:trackColor="@color/neutral.border.beta"/>
    <TextView
        android:id="@+id/survey_step_nr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2/5"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/survey_button_back"
        style="@style/Planner5D.Text.Misc_Caption"/>
    <TextView
        android:textColor="@color/text.alpha"
        android:gravity="center"
        android:id="@+id/survey_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_20"
        android:text="@string/survey_select_role_section_title"
        android:letterSpacing="-0.021"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/survey_step_nr"
        style="@style/Planner5D.Text.Headline_Small_W2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/recycler_view"
        android:paddingTop="@dimen/p5d_space_medium"
        android:paddingBottom="@dimen/p5d_space_40"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/button_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/survey_title"
        app:layout_constraintWidth_max="520dp"/>
    <View
        android:background="@drawable/onboarding_fade_out"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintBottom_toTopOf="@+id/white_mask"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/white_mask"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button_continue"/>
    <TextView
        android:enabled="false"
        android:id="@+id/button_continue"
        android:layout_width="0dp"
        android:layout_height="@dimen/smart_wizard_next_button_height"
        android:layout_marginBottom="54dp"
        android:maxWidth="334dp"
        android:text="@string/continue_premium_purchase"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.Button.GreenRounded"/>
</androidx.constraintlayout.widget.ConstraintLayout>
