<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.planner5d.library.widget.editor.editor3d.compatibility.GLTextureView
            android:id="@+id/textureAddPreviewSpinning3DShape"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/editor_popup_content_padding"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/texturePreviewGrid"
            app:layout_constraintDimensionRatio="H, 32:25"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:id="@+id/texturePreviewGrid"
            android:background="@drawable/background_border_green_selector_radius_medium"
            android:paddingTop="@dimen/texture_preview_icon_padding_vertical"
            android:paddingBottom="@dimen/texture_preview_icon_padding_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/texture_preview_icon_padding_horizontal"
            android:paddingEnd="@dimen/texture_preview_icon_padding_horizontal"
            app:layout_constraintBottom_toTopOf="@+id/textureAddPreviewDivider"
            app:layout_constraintEnd_toStartOf="@+id/texturePreviewCube"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textureAddPreviewSpinning3DShape"
            app:srcCompat="@drawable/icon_grid_light_grey"/>
        <ImageView
            android:id="@+id/texturePreviewCube"
            android:background="@drawable/background_border_green_selector_radius_medium"
            android:paddingTop="@dimen/texture_preview_icon_padding_vertical"
            android:paddingBottom="@dimen/texture_preview_icon_padding_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/texture_preview_icon_padding_horizontal"
            android:paddingEnd="@dimen/texture_preview_icon_padding_horizontal"
            android:layout_marginHorizontal="@dimen/texture_preview_icon_margin_horizontal"
            app:layout_constraintEnd_toStartOf="@+id/texturePreviewSphere"
            app:layout_constraintStart_toEndOf="@+id/texturePreviewGrid"
            app:layout_constraintTop_toTopOf="@+id/texturePreviewGrid"
            app:srcCompat="@drawable/icon_cube_light_grey"/>
        <ImageView
            android:id="@+id/texturePreviewSphere"
            android:background="@drawable/background_border_green_selector_radius_medium"
            android:paddingTop="@dimen/texture_preview_icon_padding_vertical"
            android:paddingBottom="@dimen/texture_preview_icon_padding_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/texture_preview_icon_padding_horizontal"
            android:paddingEnd="@dimen/texture_preview_icon_padding_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/texturePreviewCube"
            app:layout_constraintTop_toTopOf="@+id/texturePreviewCube"
            app:srcCompat="@drawable/icon_circle"/>
        <View
            android:id="@+id/textureAddPreviewDivider"
            android:background="@color/light_grey"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/editor_popup_content_padding"
            app:layout_constraintBottom_toTopOf="@+id/texturePreviewScale"
            app:layout_constraintTop_toBottomOf="@+id/texturePreviewGrid"/>
        <com.planner5d.library.widget.NumberInputView
            android:id="@+id/texturePreviewScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/texture_preview_element_spacing"
            android:layout_marginHorizontal="@dimen/editor_popup_content_padding"
            app:layout_constraintBottom_toTopOf="@+id/texturePreviewRotation"
            app:layout_constraintTop_toBottomOf="@+id/textureAddPreviewDivider"/>
        <com.planner5d.library.widget.SliderViewV2
            android:id="@+id/texturePreviewRotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/texture_preview_element_spacing"
            android:layout_marginHorizontal="@dimen/editor_popup_content_padding"
            app:layout_constraintBottom_toTopOf="@+id/texturePreviewUpload"
            app:layout_constraintTop_toBottomOf="@+id/texturePreviewScale"
            app:maxValue="360"
            app:minValue="0"
            app:text="@string/rotate_action"
            app:units="°"/>
        <Button
            android:textSize="@dimen/font_size_big"
            android:id="@+id/texturePreviewUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/texture_preview_element_spacing"
            android:layout_marginBottom="@dimen/editor_popup_content_padding"
            android:text="@string/texture_upload"
            android:fontFamily="@font/roboto_medium_w500"
            android:layout_marginHorizontal="@dimen/editor_popup_content_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/texturePreviewRotation"
            style="@style/Planner5D.Button.Material.PrimaryColor"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
