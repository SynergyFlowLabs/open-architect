<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    style="@style/Planner5D.Contest.Dialog">
    <ScrollView
        android:background="@drawable/background_dialog_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/contestSubmittedCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_round"
                android:layout_marginEnd="@dimen/p5d_space_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/icon_close_24"/>
            <TextView
                android:textSize="@dimen/font_size_very_very_very_very_big"
                android:textColor="@color/text.alpha"
                android:gravity="center"
                android:id="@+id/contestSubmittedTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:text="@string/design_contest_project_submitted_title"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSubmittedCancel"
                style="@style/Planner5D.Font.Bold"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/text.beta"
                android:gravity="center"
                android:id="@+id/contestSubmittedSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/design_contest_project_submitted_subtitle"
                android:layout_marginHorizontal="@dimen/p5d_space_40"
                app:layout_constraintBottom_toTopOf="@+id/contestSubmittedImage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSubmittedTitle"
                app:layout_constraintVertical_chainStyle="spread_inside"
                style="@style/Planner5D.TextView"/>
            <ImageView
                android:id="@+id/contestSubmittedImage"
                android:layout_width="280dp"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/p5d_space_large"
                android:src="@drawable/waiting"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSubmittedSubtitle"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/background_button_primary_gamma_large"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_large"
                android:layout_marginBottom="80dp"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestSubmittedImage"
                app:layout_constraintVertical_bias="1">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/primary.label.alpha"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/p5d_space_medium"
                    android:text="@string/design_battle_submit_dialog_share_explain"
                    android:layout_marginHorizontal="@dimen/p5d_space_medium"
                    style="@style/Planner5D.TextView.Medium"/>
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/contestSubmittedOk"
                    android:background="@drawable/background_button_primary_fill_beta_rounded"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/p5d_space_xx_large"
                    android:layout_marginTop="@dimen/p5d_space_x_small"
                    android:layout_marginBottom="@dimen/p5d_space_medium"
                    android:foreground="@drawable/ripple_rounded_corners_huge"
                    android:text="@string/design_battle_share_button"
                    android:layout_marginHorizontal="@dimen/p5d_space_medium"
                    style="@style/Planner5D.TextView.Medium"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
