<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/unlock_banner_clock_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_20"
        android:layout_marginBottom="@dimen/p5d_space_20"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_clock_white"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/unlock_banner_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/unlock_banner_message"
        android:maxLines="2"
        android:lineSpacingExtra="@dimen/p5d_space_x_tiny"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/unlock_banner_button"
        app:layout_constraintStart_toEndOf="@+id/unlock_banner_clock_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Bold"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/p5d_primary"
        android:id="@+id/unlock_banner_button"
        android:background="@drawable/background_white_round_large"
        android:paddingTop="@dimen/p5d_space_x_tiny"
        android:paddingBottom="@dimen/p5d_space_x_tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unlock_banner_button_text"
        android:paddingStart="@dimen/p5d_space_tiny"
        android:paddingEnd="@dimen/p5d_space_tiny"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/unlock_banner_message"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
</merge>
