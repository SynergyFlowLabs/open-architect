<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/status_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_cloud"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text.alpha"
        android:id="@+id/status_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_x_tiny"
        android:layout_marginHorizontal="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toTopOf="@+id/status_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/action_container"
        app:layout_constraintStart_toEndOf="@+id/status_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Text.Title_Small"/>
    <TextView
        android:textColor="@color/neutral.text.beta"
        android:id="@+id/status_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_container"
        app:layout_constraintStart_toEndOf="@+id/status_icon"
        app:layout_constraintTop_toBottomOf="@+id/status_title"
        style="@style/Planner5D.Text.Body_Small"/>
    <FrameLayout
        android:id="@+id/action_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="@dimen/p5d_space_x_large"
            android:layout_height="@dimen/p5d_space_x_large"
            app:indicatorColor="@color/neutral.icon.beta"
            app:indicatorSize="@dimen/progress_indicator_size"
            app:trackColor="@color/surface.beta"
            app:trackCornerRadius="@dimen/p5d_corner_radius_progress_indicator"
            app:trackThickness="@dimen/progress_indicator_track_thickness"/>
        <ImageView
            android:id="@+id/download_button"
            android:visibility="gone"
            android:layout_width="@dimen/p5d_space_x_large"
            android:layout_height="@dimen/p5d_space_x_large"
            android:foreground="@drawable/ripple_rounded"
            android:src="@drawable/icon_download_green_round"/>
        <TextView
            android:textColor="@color/primary.text.on.fill"
            android:gravity="center"
            android:id="@+id/retry_button"
            android:background="@drawable/background_error_beta_round"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/p5d_space_x_large"
            android:foreground="@drawable/ripple_rounded"
            android:text="@string/retry"
            android:paddingHorizontal="@dimen/p5d_space_x_small"
            style="@style/Planner5D.Text.Title_ExtraSmall"/>
    </FrameLayout>
</merge>
