<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.planner5d.library.widget.editor.propertiesbar.PropertiesBarView
        android:id="@+id/properties_bar"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.planner5d.library.widget.editor.itemactionsbar.ItemActionsBar
        android:orientation="horizontal"
        android:id="@+id/itemActionsBar"
        android:background="@drawable/background_white_round_large"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="@dimen/p5d_elevation_medium"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>
    <FrameLayout
        android:id="@+id/banner_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.planner5d.library.widget.VirtualJoystickView
        android:id="@+id/joystick_left"
        android:visibility="gone"
        android:layout_marginStart="@dimen/joystick_margin_3d"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.Joystick"/>
    <com.planner5d.library.widget.VirtualJoystickView
        android:id="@+id/joystick_right"
        android:visibility="gone"
        android:layout_marginEnd="@dimen/joystick_margin_3d"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Planner5D.Joystick"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/buttonRateAi"
        android:background="@drawable/gradient_green"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/ai_upload_plan_csi_notification_title"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/icon_satisfaction_info"
        android:paddingStart="10dp"
        android:paddingEnd="@dimen/p5d_space_x_small"
        android:layout_marginStart="@dimen/p5d_space_40"
        android:layout_marginEnd="52dp"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/buttonSelectItem"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginTop="42dp"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/ai_chat_tap_to_select"
        android:drawablePadding="@dimen/p5d_space_tiny"
        android:drawableStart="@drawable/icon_sparkles"
        android:paddingStart="@dimen/p5d_space_xxx_small"
        android:paddingEnd="@dimen/p5d_space_x_small"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tooltip_look_at_this"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginTop="42dp"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/ai_chat_look_at_this"
        android:drawablePadding="@dimen/p5d_space_tiny"
        android:layout_marginHorizontal="@dimen/p5d_space_tiny"
        android:paddingHorizontal="@dimen/p5d_space_medium"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_normal"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/editorContestSubmit"
        android:background="@drawable/gradient_green"
        android:visibility="visible"
        android:layout_width="120dp"
        android:layout_height="@dimen/p5d_space_large"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/done"
        android:elevation="@dimen/p5d_elevation_medium"
        app:backgroundCornerRadius="@dimen/p5d_space_x_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:paddingBottom="@dimen/p5d_space_x_tiny"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/p5d_space_x_tiny"
        android:paddingEnd="@dimen/p5d_space_x_tiny"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintBottom_toBottomOf="@+id/back_button"
        app:layout_constraintEnd_toStartOf="@+id/editorToolbarContainer"
        app:layout_constraintStart_toEndOf="@+id/back_button"
        app:layout_constraintTop_toTopOf="@+id/back_button"
        style="@style/Planner5D.TextView.WithShadow"/>
    <TextView
        android:id="@+id/project_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_xx_huge"
        android:layout_marginEnd="@dimen/p5d_space_xx_huge"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Caption"/>
    <com.planner5d.library.widget.editor.toolbar.EditorToolbar
        android:id="@+id/editorToolbarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/white"
        android:id="@+id/tooltip_ai_designer"
        android:background="@drawable/background_ai_designer_tooltip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_x_small"
        android:text="@string/editor_ai_designer_tooltip"
        android:layout_marginEnd="62dp"
        android:paddingHorizontal="@dimen/p5d_space_xx_small"
        android:paddingVertical="@dimen/p5d_space_x_tiny"
        app:layout_constraintBottom_toBottomOf="@+id/editorToolbarContainer"
        app:layout_constraintEnd_toEndOf="@+id/editorToolbarContainer"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tooltip_pro_4k"
        android:background="@drawable/background_pro_tooltip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginTop="57dp"
        android:minWidth="176dp"
        android:text="@string/editor_room_4k_prompt"
        android:layout_marginEnd="56dp"
        android:paddingHorizontal="@dimen/p5d_space_x_small"
        android:paddingVertical="@dimen/p5d_space_x_tiny"
        app:layout_constraintEnd_toEndOf="@+id/editorToolbarContainer"
        app:layout_constraintTop_toTopOf="@+id/editorToolbarContainer"
        style="@style/Planner5D.TextView.Medium"/>
    <ImageView
        android:id="@+id/tooltip_pro_4k_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_pro_tooltip_right"
        app:layout_constraintBottom_toBottomOf="@+id/tooltip_pro_4k"
        app:layout_constraintStart_toEndOf="@+id/tooltip_pro_4k"
        app:layout_constraintTop_toTopOf="@+id/tooltip_pro_4k"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tooltip_pro_export_to_cad"
        android:background="@drawable/background_pro_tooltip"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginTop="145dp"
        android:minWidth="176dp"
        android:text="@string/editor_room_export_to_cad_prompt"
        android:layout_marginEnd="56dp"
        android:paddingHorizontal="@dimen/p5d_space_x_small"
        android:paddingVertical="@dimen/p5d_space_x_tiny"
        app:layout_constraintEnd_toEndOf="@+id/editorToolbarContainer"
        app:layout_constraintTop_toTopOf="@+id/editorToolbarContainer"
        style="@style/Planner5D.TextView.Medium"/>
    <ImageView
        android:id="@+id/tooltip_pro_export_to_cad_bubble"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_pro_tooltip_right"
        app:layout_constraintBottom_toBottomOf="@+id/tooltip_pro_export_to_cad"
        app:layout_constraintStart_toEndOf="@+id/tooltip_pro_export_to_cad"
        app:layout_constraintTop_toTopOf="@+id/tooltip_pro_export_to_cad"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/tooltip_pro_4k_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tooltip_pro_4k,tooltip_pro_4k_bubble"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/tooltip_pro_cad_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tooltip_pro_export_to_cad,tooltip_pro_export_to_cad_bubble"/>
    <com.planner5d.library.widget.editor.toolbar.EditorSubmenu
        android:id="@+id/editorSubmenuContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="@dimen/p5d_space_tiny_perfect"/>
    <com.planner5d.library.widget.editor.history.EditorHistoryButtons
        android:id="@+id/editorHistotyButtons"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/editor_floors_popup_container"
            android:padding="@dimen/p5d_space_tiny"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/catalog_drawer_peek_height_plus_padding"
            android:layout_marginEnd="@dimen/p5d_space_x_tiny"/>
        <com.planner5d.library.widget.editor.menu.EditorFloorsView
            android:layout_gravity="end|bottom"
            android:orientation="vertical"
            android:id="@+id/editor_floors_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/catalog_drawer_peek_height_plus_padding"
            android:layout_marginEnd="@dimen/p5d_space_tiny"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/pov_prompt"
        android:layout="@layout/view_pov_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <include layout="@layout/view_back_button"/>
    <FrameLayout
        android:id="@+id/bottom_sheets_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="@dimen/p5d_elevation_medium"/>
    <com.planner5d.library.widget.preloader.PreloaderAnimationView
        android:id="@+id/preloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.planner5d.library.widget.preloader.PreloaderCoverView
        android:id="@+id/preloader_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="@dimen/p5d_elevation_medium"/>
    <FrameLayout
        android:id="@+id/aiChatFlowBlocker"
        android:background="@color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="@dimen/p5d_elevation_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/aiChatFlowProgressBar"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:elevation="@dimen/p5d_elevation_medium"
        app:indicatorColor="@color/p5d_indigo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="@color/absolute.white.W45"
        app:trackThickness="3dp"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/aiChatFlowProgress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="aiChatFlowBlocker,aiChatFlowProgressBar"/>
</merge>
