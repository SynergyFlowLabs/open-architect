<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.Authentication.Content">
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_grey"
                android:id="@+id/authenticationForgotPasswordExplanation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:text="@string/forgot_password_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView"/>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:id="@+id/authenticationForgotPasswordEmailLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:hint="@string/email"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:errorTextAppearance="@style/ErrorTextStyle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationForgotPasswordExplanation">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/authenticationForgotPasswordEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/authenticationForgotPasswordSend"
                android:background="@drawable/background_button_default"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/authentication_button_height"
                android:layout_marginTop="@dimen/authentication_forgot_password_submit_top_margin"
                android:foreground="@drawable/ripple_rounded_corners"
                android:imeOptions="actionDone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/authenticationForgotPasswordEmailLayout">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@android:color/white"
                    android:id="@+id/authenticationForgotPasswordSendLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/send"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Planner5D.TextView.Medium"/>
                <ProgressBar
                    android:theme="@style/progressBarWhite"
                    android:id="@+id/authenticationForgotPasswordSpinner"
                    android:visibility="invisible"
                    android:layout_width="@dimen/p5d_space_x_small"
                    android:layout_height="@dimen/p5d_space_x_small"
                    android:layout_marginLeft="@dimen/p5d_space_tiny"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/authenticationForgotPasswordSendLabel"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
