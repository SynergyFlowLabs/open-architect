<?xml version="1.0" encoding="utf-8"?>
<com.planner5d.library.widget.RoundedCornersLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cornerRadius="@dimen/p5d_corner_radius_medium">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_size_small"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/purchasePremiumProductSaleTag"
            android:background="@drawable/gradient_orange"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
        <View
            android:id="@+id/whiteBackground"
            android:background="@color/paywall_item_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProductSaleTag"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/primary.P60"
            android:id="@+id/purchasePremiumProductText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_xxx_small"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            app:layout_constraintBottom_toTopOf="@+id/purchasePremiumProductDetails"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProductSaleTag"
            app:layout_goneMarginBottom="11dp"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textSize="@dimen/font_size_normal"
            android:textColor="@color/primary.P60"
            android:id="@+id/purchasePremiumProductDetails"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="@dimen/p5d_space_xx_small"
            android:layout_marginStart="@dimen/p5d_space_x_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProductText"
            app:layout_constraintVertical_bias="0"
            app:layout_goneMarginTop="11dp"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/font_size_normal"
            android:textColor="@color/primary.P60"
            android:id="@+id/purchasePremiumProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/p5d_space_x_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchasePremiumProductSaleTag"
            style="@style/Planner5D.TextView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.planner5d.library.widget.RoundedCornersLayout>
