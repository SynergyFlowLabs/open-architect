<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/p5d_space_tiny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/orders_history_margin_start"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/orders_history_platform_title"
            android:gravity="start|top"
            android:id="@+id/ordersHistoryPlatformRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView.Medium"/>
        <TextView
            android:textSize="@dimen/orders_history_text"
            android:id="@+id/ordersHistoryPlatformRowPremiumTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_xx_small"
            android:text="@string/premium_access"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ordersHistoryPlatformRowTitle"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/orders_history_text"
            android:textColor="@color/p5d_grey"
            android:id="@+id/ordersHistoryPlatformRowPremium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_tiny"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ordersHistoryPlatformRowPremiumTitle"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/orders_history_text"
            android:id="@+id/ordersHistoryPlatformRowSnapshotsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_xx_small"
            android:text="@string/snapshots"
            android:layout_marginStart="@dimen/orders_history_column2_margin"
            app:layout_constraintEnd_toStartOf="@+id/ordersHistoryPlatformRowTexturesTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ordersHistoryPlatformRowTitle"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/orders_history_text"
            android:textColor="@color/p5d_grey"
            android:id="@+id/ordersHistoryPlatformRowSnapshots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_tiny"
            app:layout_constraintStart_toStartOf="@+id/ordersHistoryPlatformRowSnapshotsTitle"
            app:layout_constraintTop_toBottomOf="@+id/ordersHistoryPlatformRowSnapshotsTitle"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/orders_history_text"
            android:id="@+id/ordersHistoryPlatformRowTexturesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_xx_small"
            android:text="@string/custom_textures"
            android:layout_marginStart="@dimen/orders_history_column3_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ordersHistoryPlatformRowTitle"
            style="@style/Planner5D.TextView"/>
        <TextView
            android:textSize="@dimen/orders_history_text"
            android:textColor="@color/p5d_grey"
            android:id="@+id/ordersHistoryPlatformRowTextures"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_tiny"
            app:layout_constraintStart_toStartOf="@+id/ordersHistoryPlatformRowTexturesTitle"
            app:layout_constraintTop_toBottomOf="@+id/ordersHistoryPlatformRowTexturesTitle"
            style="@style/Planner5D.TextView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
