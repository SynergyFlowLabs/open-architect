<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/white_dialog_background"
    android:paddingBottom="@dimen/p5d_space_20"
    android:layout_width="320dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/buttonClose"
        android:padding="@dimen/p5d_space_x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_close_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/icon"
        android:paddingTop="@dimen/p5d_space_20"
        android:paddingBottom="17dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_checkmark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_very_very_big"
        android:textColor="@color/p5d_grey_1"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ai_thank_you"
        android:layout_marginHorizontal="@dimen/p5d_space_x_huge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_text"
        android:textColorHint="@color/p5d_grey_3"
        android:gravity="center"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:hint="@string/ai_thank_you_description"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
