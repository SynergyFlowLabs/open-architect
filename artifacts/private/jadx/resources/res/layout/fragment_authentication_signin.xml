<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.Authentication.Content">
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:id="@+id/authenticationSignInEmailLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_small"
                android:hint="@string/email"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:helperText=" "
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/authenticationSignInEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionNext"
                    android:nextFocusForward="@+id/authenticationSignInPassword"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:id="@+id/authenticationSignInPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:hint="@string/password"
                app:endIconDrawable="@drawable/icon_password_visible"
                app:endIconMode="password_toggle"
                app:errorIconDrawable="@null"
                app:helperText=" "
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationSignInEmailLayout">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/authenticationSignInPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/authenticationSignInContinue"
                android:background="@drawable/background_button_default"
                android:layout_width="0dp"
                android:layout_height="@dimen/authentication_button_height"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_rounded_corners"
                android:imeOptions="actionDone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationSignInPasswordLayout">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@android:color/white"
                    android:id="@+id/authenticationSignInContinueLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in"
                    android:letterSpacing="@dimen/p5d_letter_spacing_large"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Planner5D.Font.Medium"/>
                <ProgressBar
                    android:theme="@style/progressBarWhite"
                    android:id="@+id/authenticationSignInSpinner"
                    android:visibility="invisible"
                    android:layout_width="@dimen/p5d_space_x_small"
                    android:layout_height="@dimen/p5d_space_x_small"
                    android:layout_marginStart="@dimen/p5d_space_tiny"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/authenticationSignInContinueLabel"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.planner5d.library.widget.textview.TextViewWithLine
                android:textColor="@color/p5d_grey"
                android:gravity="center"
                android:id="@+id/authenticationSignInOrLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:text="@string/sign_in_or_continue_with"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationSignInContinue"
                style="@style/Planner5D.TextView.Medium"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/authenticationSignInByService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/authenticationSignInOrLabel"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/p5d_primary"
                android:id="@+id/authenticationSignInForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:text="@string/question_forgot_password"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationSignInByService"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/p5d_grey_2"
                android:id="@+id/authenticationSignInCreateQuestion"
                android:background="@drawable/ripple_rounded_corners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:layout_marginBottom="@dimen/p5d_space_medium"
                android:text="@string/dont_have_an_account_question"
                android:layout_marginEnd="@dimen/p5d_space_tiny"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/authenticationSignInCreate"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authenticationSignInForgot"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_normal"
                android:textColor="@color/p5d_primary"
                android:id="@+id/authenticationSignInCreate"
                android:background="@drawable/ripple_rounded_corners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_medium"
                android:layout_marginBottom="@dimen/p5d_space_medium"
                android:text="@string/sign_up"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/authenticationSignInCreateQuestion"
                app:layout_constraintTop_toBottomOf="@+id/authenticationSignInForgot"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
