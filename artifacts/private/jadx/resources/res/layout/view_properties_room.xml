<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/p5d_grey_1"
            android:id="@+id/roomPropertiesTitleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_20"
            android:text="@string/room_title"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Planner5D.TextView"/>
        <com.google.android.material.textfield.TextInputLayout
            android:theme="@style/Theme.Planner5D.Form.Material"
            android:id="@+id/roomPropertiesTitleInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:endIconMode="custom"
            app:errorIconDrawable="@null"
            app:helperText=" "
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/roomPropertiesTitleLabel">
            <com.planner5d.library.widget.TextInputEditTextCompat
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_text"
                android:id="@+id/roomPropertiesTitleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/room_title_hint"
                android:inputType="text"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/p5d_grey_1"
            android:id="@+id/roomPropertiesTypeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_20"
            android:text="@string/room_type"
            android:layout_marginStart="@dimen/p5d_space_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/roomPropertiesTitleInputLayout"
            style="@style/Planner5D.TextView"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/roomPropertiesType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintTop_toBottomOf="@+id/roomPropertiesTypeLabel"
            style="@style/Planner5D.Settings.Dropdown">
            <AutoCompleteTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                style="@style/Planner5D.Settings.Dropdown.Input"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.planner5d.library.widget.NumberInputView
            android:id="@+id/roomPropertiesHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_large"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintTop_toBottomOf="@+id/roomPropertiesType"/>
        <com.planner5d.library.widget.NumberInputView
            android:id="@+id/roomPropertiesWallThickness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_40"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintTop_toBottomOf="@+id/roomPropertiesHeight"/>
        <com.planner5d.library.widget.SliderViewV2
            android:id="@+id/roomRotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_40"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:layout_constraintTop_toBottomOf="@+id/roomPropertiesWallThickness"
            app:maxValue="360"
            app:minValue="0"
            app:text="@string/rotation_action"
            app:units="°"/>
        <com.planner5d.library.widget.NumberInputView
            android:id="@+id/roomPropertiesFlooringHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_40"
            android:layout_marginStart="@dimen/p5d_space_20"
            android:layout_marginEnd="@dimen/p5d_space_20"
            app:layout_constraintTop_toBottomOf="@+id/roomRotation"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/roomPropertiesMaterials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_40"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/roomPropertiesFlooringHeight"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
