<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_eerie_black"
        android:gravity="center_vertical"
        android:id="@+id/purchasePremiumProductText"
        android:background="@drawable/background_border_green_selector"
        android:paddingTop="@dimen/p5d_space_xx_small"
        android:paddingBottom="@dimen/p5d_space_xx_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_rounded_corners"
        android:minHeight="@dimen/p5d_space_xx_huge"
        android:paddingStart="@dimen/p5d_space_x_small"
        android:paddingEnd="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/white"
        android:id="@+id/purchasePremiumProductSaleTag"
        android:background="@drawable/background_green_gradient_rounded"
        android:paddingTop="@dimen/p5d_space_x_tiny"
        android:paddingBottom="@dimen/p5d_space_x_tiny"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_percent"
        android:textAllCaps="true"
        android:paddingStart="@dimen/p5d_space_xx_small"
        android:paddingEnd="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
</merge>
