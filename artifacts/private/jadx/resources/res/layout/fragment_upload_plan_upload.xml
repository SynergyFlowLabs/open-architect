<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textColor="@color/p5d_grey_1"
        android:gravity="center"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_medium"
        android:text="@string/ai_turn_your_blueprint_into_a_digital_plan"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_grey_1"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:text="@string/ai_convert_plan_image_into_3d_project"
        android:layout_marginHorizontal="@dimen/p5d_space_x_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        style="@style/Planner5D.TextView"/>
    <include
        android:id="@+id/banner"
        layout="@layout/view_upload_plan_banner"/>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:textColor="@color/p5d_grey_2"
        android:gravity="center"
        android:id="@+id/description2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_20"
        android:text="@string/ai_use_high_quality_images"
        android:layout_marginHorizontal="@dimen/p5d_space_x_large"
        app:layout_constraintBottom_toTopOf="@+id/uploadButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.TextView"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/uploadButton"
        android:background="@drawable/gradient_green"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_xx_large"
        android:layout_marginBottom="@dimen/p5d_space_40"
        android:foreground="@drawable/ripple_rounded_corners_huge"
        android:text="@string/ai_upload_a_floor_plan"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
