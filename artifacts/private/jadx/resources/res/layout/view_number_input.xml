<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_grey_1"
        android:ellipsize="end"
        android:id="@+id/numberInputLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/numberInputEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/p5d_grey_1"
        android:id="@+id/numberInputEditText"
        android:background="@drawable/background_grey_5_round_medium"
        android:layout_width="@dimen/number_input_edit_text_width"
        android:layout_height="34dp"
        android:selectAllOnFocus="true"
        android:inputType="numberDecimal"
        android:fontFamily="@font/roboto_medium_w500"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        android:paddingHorizontal="@dimen/p5d_space_xx_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/numberInputButtons"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/numberInputButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/numberInputMinus"
            android:background="@drawable/background_grey_round_with_border_left"
            android:padding="@dimen/p5d_space_x_tiny"
            android:layout_width="@dimen/p5d_space_xx_large"
            android:layout_height="34dp"
            android:foreground="@drawable/ripple_rounded_corners_medium_left"
            android:src="@drawable/icon_numberpicker_minus"
            app:tint="@color/p5d_grey_2"/>
        <ImageView
            android:id="@+id/numberInputPlus"
            android:background="@drawable/background_grey_round_with_border_right"
            android:padding="@dimen/p5d_space_x_tiny"
            android:layout_width="@dimen/p5d_space_xx_large"
            android:layout_height="34dp"
            android:foreground="@drawable/ripple_rounded_corners_medium_right"
            android:src="@drawable/icon_numberpicker_plus"
            app:tint="@color/p5d_grey_2"/>
    </LinearLayout>
</merge>
