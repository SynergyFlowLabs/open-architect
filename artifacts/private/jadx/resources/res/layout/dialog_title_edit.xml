<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/p5d_space_40"
    android:layout_marginHorizontal="@dimen/p5d_space_medium">
    <com.google.android.material.textfield.TextInputLayout
        android:theme="@style/Theme.Planner5D.Form.Material.Grey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/title">
        <com.planner5d.library.widget.TextInputEditTextCompat
            android:id="@+id/input_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionNone"/>
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
