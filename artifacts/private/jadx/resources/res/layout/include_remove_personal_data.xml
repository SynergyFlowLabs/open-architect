<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:id="@+id/requestPersonalDataRemovalFormTitle"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/requestPersonalDataRemoval"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:id="@+id/input_personal_data_removal_label"
            style="@style/Planner5D.Settings.Label"/>
        <com.planner5d.library.widget.EditTextWithValidator
            android:gravity="start"
            android:id="@+id/inputPersonalDataRemoval"
            android:layout_height="36dp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionNone"
            android:textAlignment="viewStart"
            style="@style/Planner5D.Settings.Input"/>
    </LinearLayout>
</merge>
