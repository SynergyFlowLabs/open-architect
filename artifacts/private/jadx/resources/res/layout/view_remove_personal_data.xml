<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Button
        android:id="@+id/request_personal_data_removal_form_title"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/p5d_space_medium"
        android:text="@string/manage_personal_data"
        android:textAllCaps="false"
        android:paddingStart="@dimen/p5d_space_xx_tiny"
        android:paddingEnd="0dp"
        android:letterSpacing="@dimen/p5d_letter_spacing_large"
        android:paddingVertical="@dimen/p5d_space_xx_tiny"
        app:icon="@drawable/icon_personal_data"
        app:iconGravity="start"
        app:iconPadding="@dimen/p5d_space_xx_small"
        app:iconTint="@color/p5d_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Header.Material"/>
    <ImageView
        android:id="@+id/manage_data_personal_expand_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/request_personal_data_removal_form_title"
        app:layout_constraintEnd_toEndOf="@+id/request_personal_data_removal_form_title"
        app:layout_constraintTop_toTopOf="@+id/request_personal_data_removal_form_title"
        app:srcCompat="@drawable/icon_expand_more_22"/>
    <TextView
        android:textSize="@dimen/manage_data_text"
        android:textColor="@color/text.gamma"
        android:id="@+id/manage_personal_data_explanation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-3dp"
        android:text="@string/tap_to_manage_your_personal_data"
        android:layout_marginStart="@dimen/p5d_space_x_large"
        android:letterSpacing="@dimen/p5d_letter_spacing_x_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/request_personal_data_removal_form_title"/>
    <TextView
        android:textSize="@dimen/manage_data_text"
        android:textColor="@color/form_text_color"
        android:id="@+id/request_personal_data_removal"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/request_personal_data_removal_form_title"/>
    <com.google.android.material.textfield.TextInputLayout
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:id="@+id/input_personal_data_removal_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        app:endIconDrawable="@drawable/icon_password_visible"
        app:endIconMode="password_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/request_personal_data_removal">
        <com.planner5d.library.widget.TextInputEditTextCompat
            android:theme="@style/Theme.Planner5D.Form.Material"
            android:id="@+id/input_personal_data_removal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:imeOptions="actionNone"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:textSize="@dimen/manage_data_text_button"
        android:id="@+id/button_delete"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:text="@string/request_personal_data_removal_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_personal_data_removal_layout"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:textSize="@dimen/manage_data_text_button"
        android:id="@+id/button_download"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:text="@string/download"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_delete"/>
</merge>
