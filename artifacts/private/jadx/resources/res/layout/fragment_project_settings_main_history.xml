<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/p5d_space_small"
    android:paddingBottom="@dimen/p5d_space_small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_rectangle"
    android:paddingStart="@dimen/p5d_space_20"
    android:paddingEnd="@dimen/p5d_space_20">
    <TextView
        android:textSize="@dimen/font_size_very_very_big"
        android:id="@+id/projectSettingsHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/projectSettingsNewBadge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:id="@+id/projectSettingsNewBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_new"
        android:layout_marginStart="@dimen/p5d_space_xxx_small"
        android:layout_marginEnd="@dimen/p5d_space_xxx_small"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/projectSettingsHistoryTitle"
        app:layout_constraintEnd_toStartOf="@+id/projectSettingsHistoryArrow"
        app:layout_constraintStart_toEndOf="@+id/projectSettingsHistoryTitle"
        app:layout_constraintTop_toTopOf="@+id/projectSettingsHistoryTitle"
        style="@style/Planner5D.TextView.Badge"/>
    <ImageView
        android:id="@+id/projectSettingsHistoryArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_arrow_right_22"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/projectSettingsHistoryTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/projectSettingsHistoryTitle"/>
    <TextView
        android:id="@+id/projectSettingsHistoryLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:text="@string/explore_past_versions_of_your_project"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/projectSettingsHistoryTitle"
        style="@style/Planner5D.TextView.Big.Grey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
