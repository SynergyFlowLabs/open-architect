<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/profileEditExpandableItemIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/p5d_space_medium"
        app:layout_constraintBottom_toBottomOf="@+id/profileEditExpandableItemTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profileEditExpandableItemTitle"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:id="@+id/profileEditExpandableItemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_xx_small"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        app:layout_constraintStart_toEndOf="@+id/profileEditExpandableItemIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/p5d_grey"
        android:id="@+id/profileEditExpandableItemAdditionalText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        app:layout_constraintEnd_toStartOf="@+id/profileEditGroupIndicator"
        app:layout_constraintStart_toStartOf="@+id/profileEditExpandableItemTitle"
        app:layout_constraintTop_toBottomOf="@+id/profileEditExpandableItemTitle"
        style="@style/Planner5D.TextView"/>
    <ImageView
        android:id="@+id/profileEditGroupIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:src="@drawable/icon_expand_more_22"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.planner5d.library.activity.fragment.settings.ViewSocial
        android:id="@+id/profileEditSocial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_medium"
        android:layout_marginEnd="@dimen/p5d_space_medium"
        app:layout_constraintTop_toBottomOf="@+id/profileEditExpandableItemAdditionalText"/>
    <View
        android:background="@color/p5d_grey_5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_border_small"
        android:layout_marginTop="10dp"
        android:layout_marginStart="@dimen/p5d_space_20"
        app:layout_constraintTop_toBottomOf="@+id/profileEditSocial"/>
</androidx.constraintlayout.widget.ConstraintLayout>
