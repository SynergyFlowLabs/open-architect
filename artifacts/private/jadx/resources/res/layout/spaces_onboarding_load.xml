<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/back_button"
        android:padding="@dimen/p5d_space_x_tiny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        android:layout_marginBottom="@dimen/p5d_space_x_tiny"
        android:foreground="@drawable/ripple_rounded_corners_medium"
        android:src="@drawable/icon_back_32"
        android:layout_marginStart="@dimen/p5d_space_tiny"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/animation"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:adjustViewBounds="true"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loader_light_small"/>
        <TextSwitcher
            android:layout_gravity="center_horizontal"
            android:id="@+id/text_switcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:inAnimation="@anim/fade_slide_in_right"
            android:outAnimation="@anim/fade_slide_out_left"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
