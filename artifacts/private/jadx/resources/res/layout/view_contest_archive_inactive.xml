<?xml version="1.0" encoding="utf-8"?>
<com.planner5d.library.contest.view.archive.ContestInactiveView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.planner5d.library.widget.RoundedCornersLayout
        android:id="@+id/contentWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_rounded_corners_large"
        app:cornerRadius="@dimen/p5d_corner_radius_large"
        app:roundedBorderColor="@color/p5d_grey_5"
        app:roundedBorderWidth="@dimen/p5d_border">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/contestArchiveWinnerRender"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="2:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/contestArchiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_completed_badge"
                android:layout_marginEnd="@dimen/p5d_space_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/font_size_big"
                android:id="@+id/contestTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBaseline_toBaselineOf="@+id/participantsCount"
                app:layout_constraintEnd_toStartOf="@+id/participantsCount"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Planner5D.TextView.ContestDates"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/font_size_big"
                android:id="@+id/participantsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestArchiveWinnerRender"
                style="@style/Planner5D.TextView.ContestParticipantsCount"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:id="@+id/contestName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="@+id/participantsCount"
                app:layout_constraintStart_toStartOf="@+id/contestTime"
                app:layout_constraintTop_toBottomOf="@+id/participantsCount"
                style="@style/Planner5D.TextView.ContestTitle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:id="@+id/contestRequirements"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_tiny"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="@+id/contestName"
                app:layout_constraintStart_toStartOf="@+id/contestName"
                app:layout_constraintTop_toBottomOf="@+id/contestName"
                style="@style/Planner5D.TextView.ContestDetails"/>
            <View
                android:id="@+id/contestLine"
                android:background="@color/p5d_grey_5"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="@+id/contestRequirements"
                app:layout_constraintStart_toStartOf="@+id/contestRequirements"
                app:layout_constraintTop_toBottomOf="@+id/contestRequirements"/>
            <com.planner5d.library.contest.view.archive.ContestParticipantView
                android:id="@+id/contestArchiveParticipant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:layout_marginBottom="@dimen/p5d_space_20"
                android:layout_marginStart="@dimen/p5d_space_xx_tiny"
                android:layout_marginEnd="@dimen/p5d_space_xx_tiny"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/contestRequirements"
                app:layout_constraintStart_toStartOf="@+id/contestRequirements"
                app:layout_constraintTop_toBottomOf="@+id/contestLine"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.planner5d.library.widget.preloader.shimmer.ShimmerView
            android:id="@+id/preloader"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.planner5d.library.widget.RoundedCornersLayout>
</com.planner5d.library.contest.view.archive.ContestInactiveView>
