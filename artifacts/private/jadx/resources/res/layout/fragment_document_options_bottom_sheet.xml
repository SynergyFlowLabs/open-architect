<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheet"
    android:background="@drawable/background_surface_beta_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/handle"
        android:background="@drawable/background_grey_round"
        android:layout_width="@dimen/bottom_sheet_drag_handle_width"
        android:layout_height="@dimen/bottom_sheet_drag_handle_height"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:layout_marginBottom="@dimen/p5d_space_x_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text.gamma"
        android:gravity="center_vertical"
        android:id="@+id/document_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:minHeight="@dimen/p5d_space_x_huge"
        android:paddingHorizontal="@dimen/p5d_space_20"
        app:layout_constraintTop_toBottomOf="@+id/handle"
        style="@style/Planner5D.Text.Title_ExtraSmall"/>
    <com.planner5d.library.activity.fragment.spaces.view.DocumentStatusView
        android:id="@+id/document_status"
        android:background="@drawable/background_transparent_radius_very_very_large_border_gamma"
        android:padding="@dimen/p5d_space_x_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toTopOf="@+id/menu_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/document_name"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menu_list"
        android:paddingBottom="@dimen/p5d_space_20"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_xxx_small"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toBottomOf="@+id/document_status"/>
</androidx.constraintlayout.widget.ConstraintLayout>
