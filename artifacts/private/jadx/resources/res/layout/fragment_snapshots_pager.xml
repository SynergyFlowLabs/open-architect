<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/view_back_button"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.planner5d.library.widget.previewtoolbar.PreviewToolbar
        android:id="@+id/preview_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_x_small"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.planner5d.library.widget.previewtoolbar.PreviewToolbarItem
            android:id="@+id/item_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iconSrc="@drawable/icon_download"/>
        <com.planner5d.library.widget.previewtoolbar.PreviewToolbarItem
            android:id="@+id/item_improve_with_ai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iconSrc="@drawable/icon_sparkles"/>
        <com.planner5d.library.widget.previewtoolbar.PreviewToolbarItem
            android:id="@+id/item_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iconSrc="@drawable/icon_share"/>
        <com.planner5d.library.widget.previewtoolbar.PreviewToolbarItem
            android:id="@+id/item_improve"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iconSrc="@drawable/icon_magic_wand"/>
        <com.planner5d.library.widget.previewtoolbar.PreviewToolbarItem
            android:id="@+id/item_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iconSrc="@drawable/icon_trash"/>
    </com.planner5d.library.widget.previewtoolbar.PreviewToolbar>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/preloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
