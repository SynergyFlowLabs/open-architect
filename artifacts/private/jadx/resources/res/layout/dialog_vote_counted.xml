<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_round_huge"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/rate_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/feedback"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/button_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:src="@drawable/icon_close_24"
        android:layout_marginEnd="@dimen/p5d_space_x_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textStyle="bold"
        android:textColor="@color/text.alpha"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/design_battle_vote_counted"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rate_image"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/text.alpha"
        android:gravity="center"
        android:id="@+id/rate_us_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/design_battle_vote_counted_subtitle"
        android:letterSpacing="0.005"
        android:layout_marginHorizontal="@dimen/p5d_space_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Planner5D.TextView"/>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/button_save"
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_x_large"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:layout_marginBottom="@dimen/p5d_space_20"
        android:text="@string/design_battle_vote_counted_button_ok"
        android:layout_marginHorizontal="@dimen/p5d_space_medium"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rate_us_message"
        style="@style/Planner5D.Button.GreenRounded"/>
</androidx.constraintlayout.widget.ConstraintLayout>
