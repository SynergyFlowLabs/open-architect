<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Authentication.Content">
        <TextView
            android:textSize="@dimen/font_size_very_very_very_very_big"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small"
            android:text="@string/digital_code_auth_continue_with_email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/authentication_max_width"
            style="@style/Planner5D.TextView.Medium"/>
        <EditText
            android:theme="@style/Theme.Planner5D.Form.Material"
            android:textColor="@color/text.alpha"
            android:id="@+id/authenticationSignInEmail"
            android:background="@drawable/background_button_outline_g04"
            android:layout_width="0dp"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_medium_perfect"
            android:text=""
            android:hint="@string/feedback.placeholder.enter_email"
            android:inputType="textEmailAddress"
            android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
            android:paddingStart="@dimen/p5d_space_medium"
            android:paddingEnd="@dimen/p5d_space_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_constraintWidth_max="@dimen/authentication_max_width"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/error.fill.beta"
            android:gravity="center_horizontal"
            android:id="@+id/error"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_x_small_perfect"
            android:text="@string/profile_signin_contact_support"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/authenticationSignInEmail"
            app:layout_constraintWidth_max="@dimen/authentication_max_width"
            style="@style/Planner5D.TextView"/>
        <com.planner5d.library.widget.RoundedCornersLayout
            android:id="@+id/authenticationSignInContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_medium"
            app:cornerRadius="@dimen/p5d_corner_radius_rounded"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/error"
            app:layout_constraintWidth_max="@dimen/authentication_max_width">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/button_background"
                android:background="@drawable/background_button_primary_p40"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:foreground="@drawable/ripple_rounded"
                android:imeOptions="actionDone">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/button_text_default"
                    android:id="@+id/authenticationSignInContinueLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contest_continue"
                    android:letterSpacing="0.02"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Planner5D.Font.Medium"/>
                <ProgressBar
                    android:theme="@style/progressBarBlack"
                    android:id="@+id/authenticationSignInSpinner"
                    android:visibility="gone"
                    android:layout_width="@dimen/p5d_space_x_small"
                    android:layout_height="@dimen/p5d_space_x_small"
                    android:layout_marginStart="@dimen/p5d_space_tiny"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/authenticationSignInContinueLabel"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.planner5d.library.widget.RoundedCornersLayout>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/text.alpha"
            android:id="@+id/or"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_20"
            android:text="@string/or"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/authenticationSignInContinue"
            app:layout_constraintWidth_max="@dimen/authentication_max_width"
            style="@style/Planner5D.TextView.Medium"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/authenticationSignInByService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/or"
            app:layout_constraintWidth_max="@dimen/authentication_max_width"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
