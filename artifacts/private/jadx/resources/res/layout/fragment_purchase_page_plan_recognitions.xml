<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/purchaseScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/purchase_title_top_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:id="@+id/purchaseProducts"
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="@dimen/purchase_default_product_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/purchaseList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Planner5D.Purchase.ProductList"/>
        </HorizontalScrollView>
        <com.planner5d.library.widget.preloader.PreloaderCoverView
            android:id="@+id/purchaseListPreloader"
            android:layout_width="0dp"
            android:layout_height="@dimen/purchase_default_product_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/error"
            android:gravity="center"
            android:id="@+id/purchaseErrorMessage"
            android:layout_width="0dp"
            android:layout_height="@dimen/purchase_default_product_height"
            android:layout_marginHorizontal="@dimen/p5d_space_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/purchaseBenefits"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchaseProducts"/>
        <LinearLayout
            android:id="@+id/purchaseBenefits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_tiny"
            android:layout_marginBottom="@dimen/p5d_space_x_large"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/banner"
            app:layout_constraintWidth_max="@dimen/content_max_width"
            style="@style/Planner5D.Purchase.TextureBenefits"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
