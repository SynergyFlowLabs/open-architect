<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/placeholderImage1"
        android:background="@drawable/background_white_round_large"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/placeholder_shimmer"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/placeholderImage2"
        android:background="@drawable/background_white_round_large"
        android:layout_width="270dp"
        android:layout_height="@dimen/p5d_space_x_small"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:src="@drawable/placeholder_shimmer"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/placeholderImage1"/>
    <ImageView
        android:id="@+id/placeholderImage3"
        android:background="@drawable/background_white_round_large"
        android:layout_width="196dp"
        android:layout_height="@dimen/p5d_space_x_small"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:src="@drawable/placeholder_shimmer"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/placeholderImage2"/>
</merge>
