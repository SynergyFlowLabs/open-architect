<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="560dp"
            style="@style/Planner5D.ProfileEdit.Content">
            <com.google.android.material.textfield.TextInputLayout
                android:theme="@style/Theme.Planner5D.Form.Material"
                android:textColorHint="@color/p5d_grey_2"
                android:id="@+id/profileItemEditInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:hint="@string/title"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:errorTextAppearance="@style/ErrorTextStyle"
                app:helperText=" "
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.planner5d.library.widget.TextInputEditTextCompat
                    android:id="@+id/profileItemEditInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/button_text_default"
                android:gravity="center"
                android:id="@+id/profileItemEditSave"
                android:background="@drawable/background_button_default"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_xx_large"
                android:layout_marginTop="124dp"
                android:layout_marginBottom="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/save"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/profileEditItemPreloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
