<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/p5d_space_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsVirtualJoystickSwitch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/view_option_virtual_joystick"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:id="@+id/divider_1"
            android:background="@color/p5d_grey_5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsSnapToPointsSwitch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/view_option_snap_to_points"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:id="@+id/divider_2"
            android:background="@color/p5d_grey_5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsSnapToRulersSwitch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/view_option_snap_to_rulers"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:id="@+id/divider_3"
            android:background="@color/p5d_grey_5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsLockWallsSwitch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/view_option_lock_walls"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:id="@+id/divider_4"
            android:background="@color/p5d_grey_5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsMoveWallsSwitch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/view_option_move_walls_on_one_dimension"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:id="@+id/divider_5"
            android:background="@color/p5d_grey_5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsPositionCameraSwitch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/view_option_position_in_3d_first_floor"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:id="@+id/divider_6"
            android:background="@color/p5d_grey_5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
