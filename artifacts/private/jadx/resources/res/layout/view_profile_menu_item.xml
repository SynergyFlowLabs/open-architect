<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/p5d_space_x_huge">
    <ImageView
        android:id="@+id/profileMenuItemIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/p5d_space_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:id="@+id/profileMenuItemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/profileMenuItemAdditionalText"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/profileMenuItemIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="@dimen/profile_menu_text_min_width"
        style="@style/Planner5D.TextView.Ellipsized"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:gravity="end"
        android:id="@+id/profileMenuItemAdditionalText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p5d_space_x_small"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/profileMenuItemTitle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="@dimen/profile_menu_text_min_width"
        style="@style/Planner5D.TextView.Ellipsized"/>
    <View
        android:background="@color/p5d_grey_5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/p5d_border_small"
        android:layout_marginStart="@dimen/p5d_space_20"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
