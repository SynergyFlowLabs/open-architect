<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_main_list_add_new_grid_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/imageWrapper"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:foreground="?attr/selectableItemBackground"
        android:stateListAnimator="@animator/card_press"
        app:cardCornerRadius="@dimen/p5d_corner_radius_large"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="5:4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/background_border_dashed_green_rounded"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/primary.text.brand"
                android:id="@+id/titleCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:text="@string/add_new"
                android:layout_marginHorizontal="@dimen/p5d_space_x_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Planner5D.Text.Title_Large"/>
            <TextView
                android:textColor="@color/text.gamma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_tiny"
                android:text="@string/tap_to_add"
                android:layout_below="@+id/titleCard"
                android:layout_marginHorizontal="@dimen/p5d_space_x_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleCard"
                style="@style/Planner5D.Text.Body_Small"/>
            <ImageView
                android:background="@drawable/icon_add_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/p5d_space_x_small"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="167:38"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageWrapper"/>
</androidx.constraintlayout.widget.ConstraintLayout>
