<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/p5d_space_xx_small"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/styles_list"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/p5d_space_medium"
            android:minHeight="136dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <com.planner5d.library.widget.textview.ButtonTextView
            android:enabled="false"
            android:id="@+id/next_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/smart_wizard_next_button_height"
            android:layout_marginBottom="@dimen/p5d_space_large"
            android:text="@string/next"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:backgroundCornerRadius="@dimen/p5d_corner_radius_rounded"
            style="@style/Planner5D.ButtonTextView.Green"/>
    </LinearLayout>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textColor="@color/button_text_dark_green"
        android:id="@+id/more_button"
        android:background="@drawable/background_light_green_outline"
        android:padding="@dimen/p5d_space_xxx_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/p5d_space_x_small"
        android:foreground="@drawable/ripple_rounded_corners"
        android:text="@string/more"
        android:drawablePadding="@dimen/p5d_space_tiny"
        android:textAllCaps="false"
        android:paddingStart="@dimen/p5d_space_x_small"
        android:paddingEnd="@dimen/p5d_space_x_small"
        android:letterSpacing="@dimen/p5d_letter_spacing_default"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_rounded"
        app:drawableStartCompat="@drawable/icon_refresh"
        app:drawableTint="@color/button_text_dark_green"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
    <com.planner5d.library.widget.preloader.PreloaderDialogView
        android:id="@+id/preloader_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
