<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/p5d_space_huge"
    android:foreground="@drawable/ripple_rectangle">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_location_pin"
        android:layout_marginStart="@dimen/p5d_space_medium_rare"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:ellipsize="end"
        android:id="@+id/main_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/find_my_location"
        android:maxLines="2"
        android:layout_marginStart="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_medium_rare"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
