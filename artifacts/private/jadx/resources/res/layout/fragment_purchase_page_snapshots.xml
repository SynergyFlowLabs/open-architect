<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/purchaseRendersScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/purchase_title_top_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:id="@+id/purchaseRendersProducts"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/purchase_default_product_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/purchaseRendersList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Planner5D.Purchase.ProductList"/>
        </HorizontalScrollView>
        <com.planner5d.library.widget.preloader.PreloaderCoverView
            android:id="@+id/purchaseRendersListPreloader"
            android:layout_width="0dp"
            android:layout_height="@dimen/purchase_default_product_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/error"
            android:gravity="center"
            android:id="@+id/purchaseRendersErrorMessage"
            android:layout_width="0dp"
            android:layout_height="@dimen/purchase_default_product_height"
            android:layout_marginLeft="@dimen/p5d_space_medium"
            android:layout_marginRight="@dimen/p5d_space_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.planner5d.library.widget.ImageSlider
            android:id="@+id/purchaseRendersImageSlider"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/purchase_renders_image_slider_top_margin"
            android:layout_marginStart="@dimen/purchase_content_horizontal_margin"
            android:layout_marginEnd="@dimen/purchase_content_horizontal_margin"
            app:layout_constraintDimensionRatio="16:11"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchaseRendersProducts"
            app:layout_constraintWidth_max="@dimen/content_max_width"
            app:leftLabel="@string/regular_view"
            app:rightLabel="@string/hd_snapshot"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/purchaseRendersBenefits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/purchase_renders_benefits_top_margin"
            android:layout_marginBottom="@dimen/p5d_space_x_large"
            android:layout_marginStart="@dimen/purchase_content_horizontal_margin"
            android:layout_marginEnd="@dimen/purchase_content_horizontal_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/purchaseRendersImageSlider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
