<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/p5d_space_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsActionsEverything"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/center_active_floor"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:background="@color/p5d_grey_5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/projectSettingsActionsOutside"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_space_x_huge"
            android:foreground="@drawable/ripple_rectangle"
            android:text="@string/center_outsice_scene"
            android:paddingStart="@dimen/p5d_space_20"
            android:paddingEnd="@dimen/p5d_space_20"
            style="@style/Planner5D.TextView.Big.Grey"/>
        <View
            android:background="@color/p5d_grey_5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border"
            android:layout_marginStart="@dimen/p5d_space_20"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
