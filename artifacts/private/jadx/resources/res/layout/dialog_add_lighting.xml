<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_round_huge"
    android:paddingBottom="@dimen/p5d_space_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="480dp"
    android:paddingHorizontal="@dimen/p5d_space_medium">
    <ImageView
        android:id="@+id/dialog_icon"
        android:layout_width="@dimen/dialog_icon_size"
        android:layout_height="@dimen/dialog_icon_size"
        android:layout_marginTop="@dimen/p5d_space_medium"
        android:src="@drawable/icon_lighting"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textColor="@color/text.alpha"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/render_check_your_lighting"
        android:lines="1"
        android:paddingStart="@dimen/p5d_space_xx_small"
        android:paddingEnd="@dimen/p5d_space_xx_small"
        android:layout_marginEnd="@dimen/p5d_space_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dialog_icon"
        app:layout_constraintTop_toBottomOf="@+id/dialog_icon"
        app:layout_constraintTop_toTopOf="@+id/dialog_icon"
        style="@style/Planner5D.TextView.Medium"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/text.beta"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_small"
        android:text="@string/render_light_adjust_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_icon"
        style="@style/Planner5D.TextView"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/button_add_lights"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_x_large"
        android:layout_marginTop="@dimen/p5d_space_xx_large"
        android:minWidth="0dp"
        android:text="@string/render_light_adjust_button"
        android:layout_marginEnd="@dimen/p5d_space_tiny"
        app:layout_constraintEnd_toStartOf="@+id/button_render"
        app:layout_constraintTop_toBottomOf="@+id/text"
        style="@style/Planner5D.UnelevatedButton.Secondary"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/button_render"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/p5d_space_x_large"
        android:layout_marginTop="@dimen/p5d_space_xx_large"
        android:minWidth="0dp"
        android:text="@string/render_button_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"
        style="@style/Planner5D.UnelevatedButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
