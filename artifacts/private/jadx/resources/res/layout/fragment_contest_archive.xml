<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/contestArchiveRendersCarouselContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/contestArchiveBackWrapper"
                android:layout_width="?attr/actionBarSize"
                android:layout_height="?attr/actionBarSize"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/contestArchiveBack"
                    android:background="@drawable/ripple_round"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="?attr/homeAsUpIndicator"
                    android:scaleType="centerInside"
                    app:tint="@color/white"/>
            </FrameLayout>
            <TextView
                android:id="@+id/contestArchiveDates"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/contest_contents_margin"
                android:layout_marginEnd="@dimen/contest_contents_margin"
                app:layout_constraintBaseline_toBaselineOf="@+id/contestArchiveParticipantsCount"
                app:layout_constraintEnd_toStartOf="@+id/contestArchiveParticipantsCount"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Planner5D.TextView.ContestDates"/>
            <TextView
                android:id="@+id/contestArchiveParticipantsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                android:layout_marginEnd="@dimen/contest_contents_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestArchiveRendersCarouselContainer"
                style="@style/Planner5D.TextView.ContestParticipantsCount"/>
            <TextView
                android:id="@+id/contestArchiveContestName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_x_small"
                app:layout_constraintEnd_toEndOf="@+id/contestArchiveParticipantsCount"
                app:layout_constraintStart_toStartOf="@+id/contestArchiveDates"
                app:layout_constraintTop_toBottomOf="@+id/contestArchiveParticipantsCount"
                style="@style/Planner5D.TextView.ContestTitle"/>
            <TextView
                android:id="@+id/contestArchiveRequirements"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xx_small"
                app:layout_constraintEnd_toEndOf="@+id/contestArchiveContestName"
                app:layout_constraintStart_toStartOf="@+id/contestArchiveContestName"
                app:layout_constraintTop_toBottomOf="@+id/contestArchiveContestName"
                style="@style/Planner5D.TextView.ContestDetails"/>
            <Space
                android:id="@+id/contestArchiveSpace"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_x_tiny"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestArchiveRequirements"/>
            <com.planner5d.library.widget.RoundedCornersLayout
                android:id="@+id/contestArchiveUserParticipant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cornerRadius="@dimen/p5d_corner_radius_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestArchiveSpace"
                app:roundedBorderColor="@color/p5d_grey_5"
                app:roundedBorderWidth="@dimen/p5d_border">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/white"
                    android:paddingTop="@dimen/p5d_space_xx_small"
                    android:paddingBottom="@dimen/p5d_space_xx_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/p5d_space_x_small"
                    android:paddingEnd="@dimen/p5d_space_20">
                    <com.planner5d.library.widget.ProfileIconView
                        android:id="@+id/contestArchiveUserParticipantAvatar"
                        android:layout_width="@dimen/profile_icon_size"
                        android:layout_height="@dimen/profile_icon_size"
                        android:layout_marginStart="@dimen/p5d_space_x_small"
                        app:imageSize="@dimen/profile_icon_size"
                        app:layout_constraintStart_toStartOf="@+id/contestArchiveUserParticipantPlaceBadge"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.planner5d.library.widget.ContestPlaceBadgeView
                        android:id="@+id/contestArchiveUserParticipantPlaceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/contestArchiveUserParticipantAvatar"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/contestArchiveUserParticipantAvatar"/>
                    <TextView
                        android:textSize="@dimen/font_size_big"
                        android:textColor="@color/p5d_text"
                        android:ellipsize="end"
                        android:id="@+id/contestArchiveUserParticipantName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/p5d_space_tiny"
                        android:layout_marginEnd="@dimen/p5d_space_20"
                        android:letterSpacing="@dimen/p5d_letter_spacing_large"
                        app:layout_constraintBottom_toBottomOf="@+id/contestArchiveUserParticipantAvatar"
                        app:layout_constraintEnd_toStartOf="@+id/contestArchiveUserParticipantVotesPercentage"
                        app:layout_constraintStart_toEndOf="@+id/contestArchiveUserParticipantAvatar"
                        app:layout_constraintTop_toTopOf="@+id/contestArchiveUserParticipantAvatar"
                        style="@style/Planner5D.Font.Medium"/>
                    <TextView
                        android:textSize="@dimen/font_size_big"
                        android:textColor="@color/p5d_text"
                        android:id="@+id/contestArchiveUserParticipantVotesPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="@dimen/p5d_letter_spacing_large"
                        app:layout_constraintBaseline_toBaselineOf="@+id/contestArchiveUserParticipantName"
                        app:layout_constraintEnd_toEndOf="parent"
                        style="@style/Planner5D.Font.Medium"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.planner5d.library.widget.RoundedCornersLayout>
            <com.planner5d.library.widget.RoundedCornersLayout
                android:id="@+id/contestArchiveWinnersTable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cornerRadius="@dimen/p5d_corner_radius_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestArchiveUserParticipant"
                app:roundedBorderColor="@color/p5d_grey_5"
                app:roundedBorderWidth="@dimen/p5d_border">
                <FrameLayout
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/contestArchiveWinnersList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="22dp"
                        android:layout_marginStart="@dimen/p5d_space_x_small"
                        android:layout_marginEnd="@dimen/p5d_space_x_small"/>
                </FrameLayout>
            </com.planner5d.library.widget.RoundedCornersLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_x_tiny"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestArchiveWinnersTable"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.planner5d.library.widget.preloader.PreloaderBoxV2View
        android:id="@+id/contestArchivePreloader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
