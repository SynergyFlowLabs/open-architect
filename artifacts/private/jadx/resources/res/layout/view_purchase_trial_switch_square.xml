<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trial_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:layout_marginHorizontal="@dimen/p5d_space_20"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/white"
        android:gravity="start|center_vertical"
        android:id="@+id/trialSwitchText"
        android:background="@drawable/background_switch_white_round"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_rounded_corners"
        android:minHeight="56dp"
        android:text="@string/purchases.switch_trial.title"
        android:paddingStart="@dimen/p5d_space_medium"
        android:paddingEnd="@dimen/p5d_space_xx_huge"
        android:paddingVertical="@dimen/p5d_space_x_tiny"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.TextView"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/trialSwitch"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/p5d_space_xxx_tiny"
        android:paddingStart="@dimen/p5d_space_x_small"
        android:paddingEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:thumbTint="@color/white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
