<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.planner5d.library.widget.RoundedCornersLayout
        android:id="@+id/file_preview_container"
        android:background="@drawable/background_transparent_radius_very_large_border_gamma"
        android:layout_width="0dp"
        android:layout_height="@dimen/file_image_size"
        android:layout_marginVertical="@dimen/p5d_space_x_small"
        app:cornerRadius="@dimen/p5d_space_x_small"
        app:layout_constrainedWidth="true"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedBorderWidth="@dimen/p5d_border">
        <ImageView
            android:id="@+id/file_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </com.planner5d.library.widget.RoundedCornersLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:theme="@style/Theme.Planner5D.Form.Material.Grey"
        android:id="@+id/name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_large"
        android:hint="@string/document_name"
        android:layout_marginStart="@dimen/p5d_space_20"
        android:layout_marginEnd="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/file_preview_container">
        <com.planner5d.library.widget.TextInputEditTextCompat
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionDone"
            style="@style/Planner5D.Text.Body_Medium"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:theme="@style/Theme.Planner5D.Form.Material.Grey"
        android:id="@+id/folder_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_20"
        android:hint="@string/folder_capital"
        android:layout_marginHorizontal="@dimen/p5d_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_input">
        <com.planner5d.library.widget.TextInputEditTextCompat
            android:id="@+id/selected_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="none"
            android:paddingEnd="@dimen/p5d_space_huge"
            style="@style/Planner5D.Text.Body_Medium"/>
    </com.google.android.material.textfield.TextInputLayout>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:layout_width="@dimen/p5d_space_medium"
        android:layout_height="@dimen/p5d_space_medium"
        android:src="@drawable/icon_chevron_bottom"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/p5d_space_20"
        android:layout_marginVertical="@dimen/p5d_space_x_small"
        app:layout_constraintBottom_toBottomOf="@+id/folder_input"
        app:layout_constraintEnd_toEndOf="@+id/folder_input"/>
    <View
        android:id="@+id/select_folder"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/ripple_rounded_corners_medium"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/folder_input"
        app:layout_constraintEnd_toEndOf="@+id/folder_input"
        app:layout_constraintStart_toStartOf="@+id/folder_input"
        app:layout_constraintTop_toTopOf="@+id/folder_input"/>
    <com.planner5d.library.widget.preloader.PreloaderSimpleV2View
        android:id="@+id/preloader_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
