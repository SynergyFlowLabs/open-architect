<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/p5d_space_x_tiny"
    android:paddingEnd="@dimen/p5d_space_x_tiny">
    <ImageView
        android:id="@+id/image"
        android:background="@drawable/background_white_round_medium_white_border"
        android:padding="@dimen/p5d_space_x_tiny"
        android:layout_width="@dimen/smart_wizard_style_image_size"
        android:layout_height="@dimen/smart_wizard_style_image_size"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        android:lines="1"
        android:fontFamily="@font/roboto_medium_w500"/>
</LinearLayout>
