<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Dialog.Title"/>
    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="360dp"
        android:fillViewport="false"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/space"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <Space
        android:id="@+id/space"
        android:layout_width="4dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="@+id/content"/>
    <View
        android:layout_width="0dp"
        app:layout_constraintLeft_toLeftOf="@+id/content"
        app:layout_constraintRight_toRightOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/space"
        style="@style/Planner5D.Dialog.Separator"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:id="@+id/button_cancel"
        android:layout_marginTop="3dp"
        android:layout_marginRight="8dp"
        android:text="@string/Cancel"
        android:layout_marginEnd="8dp"
        app:layout_constraintRight_toLeftOf="@+id/button_middle"
        app:layout_constraintTop_toTopOf="@+id/space"
        style="@style/Planner5D.Dialog.Button"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:id="@+id/button_middle"
        android:visibility="gone"
        android:layout_marginTop="3dp"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintRight_toLeftOf="@+id/button_save"
        app:layout_constraintTop_toTopOf="@+id/space"
        style="@style/Planner5D.Dialog.Button"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/Theme.Planner5D.Form.Material"
        android:id="@+id/button_save"
        android:visibility="gone"
        android:layout_marginTop="3dp"
        android:layout_marginRight="4dp"
        android:text="@string/save"
        android:layout_marginEnd="4dp"
        app:layout_constraintRight_toLeftOf="@+id/space"
        app:layout_constraintTop_toTopOf="@+id/space"
        style="@style/Planner5D.Dialog.Button.Theme"/>
    <com.planner5d.library.widget.preloader.PreloaderCoverView
        android:id="@+id/preloader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
