<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWrapper"
    android:tag="layout/view_main_list_project_grid_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/ripple_white"
    android:stateListAnimator="@animator/card_press">
    <View
        android:tag="binding_1"
        android:background="@drawable/background_item_selected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-12dp"
        android:layout_marginHorizontal="-8dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.planner5d.library.widget.RoundedCornersLayout
        android:id="@+id/imageWrapper"
        android:tag="binding_2"
        android:background="@drawable/background_button_project_medium"
        android:padding="@dimen/p5d_border"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cornerRadius="@dimen/p5d_corner_radius_large"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <include
            android:id="@+id/progress_layout"
            layout="@layout/view_main_list_progress_ongoing"/>
        <include
            android:id="@+id/error_layout"
            layout="@layout/view_main_list_progress_failed"/>
    </com.planner5d.library.widget.RoundedCornersLayout>
    <androidx.appcompat.widget.AppCompatToggleButton
        android:id="@+id/selection_tag"
        android:tag="binding_3"
        android:background="@null"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="@dimen/p5d_space_xxx_small"
        android:button="@drawable/icon_selection_tag"
        app:layout_constraintBottom_toBottomOf="@+id/imageWrapper"
        app:layout_constraintStart_toStartOf="@+id/imageWrapper"/>
    <ImageView
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_design_battle_flag"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_design_battle_flag_completed"
        android:layout_marginEnd="@dimen/p5d_space_xx_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.planner5d.library.widget.textview.ButtonTextView
        android:textSize="@dimen/font_size_small"
        android:textColor="@color/white"
        android:id="@+id/badge_new"
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        android:drawablePadding="3dp"
        android:fontFamily="@font/roboto_medium_w500"
        android:layout_marginEnd="@dimen/p5d_space_x_tiny"
        android:paddingHorizontal="@dimen/p5d_space_tiny"
        android:paddingVertical="@dimen/p5d_space_xx_tiny"
        app:backgroundCornerRadius="@dimen/p5d_corner_radius_huge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/title"
        android:tag="binding_7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_tiny"
        app:layout_constraintEnd_toStartOf="@+id/buttonMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageWrapper"
        style="@style/Planner5D.TextView.Item"/>
    <TextView
        android:id="@+id/summary"
        android:tag="binding_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/p5d_space_x_tiny"
        app:layout_constraintEnd_toStartOf="@+id/buttonMenu"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Planner5D.TextView.Meta"/>
    <ImageButton
        android:id="@+id/buttonMenu"
        android:tag="binding_9"
        android:background="@null"
        android:layout_width="@dimen/p5d_space_large"
        android:layout_height="@dimen/p5d_space_large"
        android:foreground="@drawable/ripple_rounded_corners"
        android:src="@drawable/icon_menu_list"
        app:layout_constraintBottom_toBottomOf="@+id/summary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:tint="@color/p5d_grey_3"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/p5d_space_tiny"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summary"/>
    <View
        android:id="@+id/blocker"
        android:background="@color/white_50"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Planner5D.Blocker"/>
</androidx.constraintlayout.widget.ConstraintLayout>
