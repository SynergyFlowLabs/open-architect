<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_editor_popup_new_design"
    android:padding="@dimen/p5d_border_small"
    android:clipChildren="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/editor_popup_container"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/catalog_view_width"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/editor_popup_header"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/editor_popup_button_back"
                    android:background="?android:attr/selectableItemBackground"
                    android:visibility="gone"
                    android:layout_width="@dimen/editor_popup_new_design_header_height"
                    android:layout_height="@dimen/editor_popup_new_design_header_height"
                    android:scaleType="centerInside"
                    android:layout_weight="0"/>
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:gravity="start|center_vertical"
                    android:id="@+id/editor_popup_title"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/editor_popup_new_design_header_height"
                    android:layout_weight="1"
                    android:textAlignment="viewStart"
                    android:paddingStart="@dimen/p5d_space_x_small"
                    android:paddingEnd="0dp"
                    app:autoSizeMaxTextSize="16dp"
                    app:autoSizeMinTextSize="10dp"
                    app:autoSizeTextType="uniform"
                    style="@style/Planner5D.TextView.Medium"/>
                <ImageView
                    android:id="@+id/editor_button_close"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_width="@dimen/editor_popup_new_design_header_height"
                    android:layout_height="@dimen/editor_popup_new_design_header_height"
                    android:scaleType="centerInside"
                    android:layout_weight="0"
                    android:contentDescription="@string/close"
                    app:srcCompat="@drawable/icon_close_button"/>
            </LinearLayout>
            <com.planner5d.library.widget.TabLayout
                android:id="@+id/editor_popup_tabs"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/editor_popup_new_design_header_height"
                app:tabIndicatorColor="@color/catalog_icon_active"
                app:tabSelectedTextColor="@color/catalog_icon_active"/>
        </FrameLayout>
        <View
            android:background="@color/p5d_grey_3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p5d_border_small"/>
        <FrameLayout
            android:id="@+id/editor_popup_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.planner5d.library.widget.preloader.PreloaderCoverView
                android:id="@+id/editor_popup_preloader"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
