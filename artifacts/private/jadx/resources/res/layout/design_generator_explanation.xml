<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_size_very_big"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/explanation_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tools_autostyles_main_title"
            android:fontFamily="@font/roboto_bold_w700"
            android:layout_marginHorizontal="@dimen/p5d_space_x_large"
            app:layout_constraintBottom_toTopOf="@+id/explanation_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/p5d_grey_1"
            android:gravity="center"
            android:id="@+id/explanation_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tools_autostyles_main_subtitle"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/roboto_regular_w400"
            android:layout_marginHorizontal="@dimen/p5d_space_x_small"
            app:layout_constraintBottom_toTopOf="@+id/explanation_image_compare"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/explanation_title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/explanation_image_compare"
            android:background="@drawable/background_white_round_medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/p5d_space_medium"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:layout_constraintBottom_toTopOf="@+id/explanation_photo_format"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/explanation_description"
            style="@style/WeakShadow">
            <com.planner5d.library.widget.CompareImagesView
                android:layout_gravity="center_horizontal"
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="@dimen/p5d_elevation_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:left_image="@drawable/room_unfinished"
                app:right_image="@drawable/room_finished"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/font_size_normal"
            android:textColor="@color/p5d_grey_2"
            android:gravity="center"
            android:id="@+id/explanation_photo_format"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="100dp"
            android:text="@string/dashboard_design_generator_about_description"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/roboto_regular_w400"
            android:layout_marginHorizontal="@dimen/p5d_space_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
