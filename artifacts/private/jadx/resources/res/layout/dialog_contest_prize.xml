<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    style="@style/Planner5D.Contest.Dialog">
    <ScrollView
        android:background="@drawable/background_dialog_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/contestPrizeCloseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:src="@drawable/icon_close_24"
                android:contentDescription="@string/close"
                android:layout_marginEnd="@dimen/p5d_space_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.planner5d.library.widget.AnimatedImageView
                android:id="@+id/contestPrizeChestAnimation"
                android:layout_width="@dimen/dialog_contest_image_size"
                android:layout_height="@dimen/dialog_contest_image_size"
                android:layout_marginTop="@dimen/p5d_space_x_huge"
                app:layout_constraintBottom_toTopOf="@+id/contestPrizePlaceWon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestPrizeCloseButton"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="@dimen/font_size_very_very_very_very_big"
                android:textColor="@color/p5d_text"
                android:gravity="center"
                android:id="@+id/contestPrizePlaceWon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_20"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                android:letterSpacing="@dimen/p5d_letter_spacing_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestPrizeChestAnimation"
                style="@style/Planner5D.Font.Bold"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/p5d_grey_1"
                android:gravity="center"
                android:id="@+id/contestPrizeClaimPrizeDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p5d_space_xxx_small"
                android:text="@string/desing_contest_good_start_subtitle"
                android:lineSpacingExtra="3dp"
                android:layout_marginStart="@dimen/p5d_space_40"
                android:layout_marginEnd="@dimen/p5d_space_40"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestPrizePlaceWon"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contestPrizePrizes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="@dimen/p5d_space_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contestPrizeClaimPrizeDescription"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/contestPrizeClaimPrize"
                android:background="@drawable/background_button_orange_rounded"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_huge"
                android:layout_marginBottom="@dimen/p5d_space_20"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/desing_contest_claim_prize"
                android:layout_marginStart="@dimen/p5d_space_20"
                android:layout_marginEnd="@dimen/p5d_space_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/contestButtonShare"
                android:background="@drawable/background_button_primary_fill_beta_rounded"
                android:layout_width="0dp"
                android:layout_height="@dimen/p5d_space_huge"
                android:layout_marginBottom="@dimen/p5d_space_xx_small"
                android:foreground="@drawable/ripple_rounded_corners"
                android:text="@string/design_battle_share_result_button"
                android:layout_marginHorizontal="@dimen/p5d_space_20"
                app:layout_constraintBottom_toTopOf="@+id/contestPrizeClaimPrize"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Planner5D.TextView.Medium"/>
            <com.planner5d.library.widget.preloader.PreloaderBoxV2View
                android:id="@+id/contestPrizePreloader"
                android:background="@drawable/background_dialog_white"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
