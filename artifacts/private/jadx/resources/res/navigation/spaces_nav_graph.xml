<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spaces_search_graph"
    app:startDestination="@+id/dashboard">
    <fragment
        android:name="com.planner5d.library.activity.fragment.spaces.dashboard.SpacesDashboardFragment"
        android:id="@+id/dashboard"
        app:bottomNavigationVisible="true"
        app:drawUnderStatusBar="true"
        app:toolbarVisible="false">
        <action
            android:id="@+id/to_profile"
            app:destination="@+id/profile"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_chat"
            app:destination="@+id/ai_chat"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_compare_plans"
            app:destination="@+id/compare_plans"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="@string/profile"
        android:name="com.planner5d.library.activity.fragment.profile.ProfileFragment"
        android:id="@+id/profile"
        app:bottomNavigationVisible="true"
        app:toolbarVisible="true">
        <action
            android:id="@+id/to_profile_edit"
            app:destination="@+id/profile_edit"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_purchase_page_snapshots"
            app:destination="@+id/purchase_page_snapshots"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_purchase_page_textures"
            app:destination="@+id/purchase_page_textures"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_purchase_page_plan_recognitions"
            app:destination="@+id/purchase_page_plan_recognitions"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_about"
            app:destination="@+id/about"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_orders_history"
            app:destination="@+id/orders_history"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_promo_code"
            app:destination="@+id/promo_code"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_manage_data"
            app:destination="@+id/manage_data"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_sign_up_options"
            app:destination="@+id/sign_up_options"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_sign_in"
            app:destination="@+id/sign_in"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_sign_in_with_link"
            app:destination="@+id/sign_in_with_link"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="fromProfile"
                android:defaultValue="@null"
                app:argType="java.lang.Boolean"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/to_compare_plans"
            app:destination="@+id/compare_plans"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_privacy_agreement"
            app:destination="@+id/privacy_agreement"/>
    </fragment>
    <fragment
        android:label="@string/profile_edit_profile"
        android:name="com.planner5d.library.activity.fragment.profile.edit.ProfileEditFragment"
        android:id="@+id/profile_edit">
        <action
            android:id="@+id/to_profile_edit_password"
            app:destination="@+id/profile_edit_password"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_profile_edit_item"
            app:destination="@+id/profile_edit_item"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="@string/change_password"
        android:name="com.planner5d.library.activity.fragment.profile.edit.password.ProfileEditPasswordFragment"
        android:id="@+id/profile_edit_password">
        <action
            android:id="@+id/to_profile_edit_password_success"
            app:destination="@+id/profile_edit_password_success"
            app:popUpTo="@+id/profile_edit"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.activity.fragment.profile.edit.password.ProfileEditPasswordSuccessFragment"
        android:id="@+id/profile_edit_password_success"
        app:toolbarVisible="false"/>
    <fragment
        android:name="com.planner5d.library.activity.fragment.profile.edit.item.ProfileEditItemFragment"
        android:id="@+id/profile_edit_item">
        <argument
            android:name="label"
            app:argType="reference"/>
        <argument
            android:name="itemType"
            app:argType="com.planner5d.library.activity.fragment.profile.edit.ProfileEditItem$ProfileEditItemType"/>
    </fragment>
    <fragment
        android:label="@string/snapshots"
        android:name="com.planner5d.library.activity.fragment.dialog.purchase.snapshots.PurchasePageSnapshots"
        android:id="@+id/purchase_page_snapshots"/>
    <fragment
        android:label="@string/textures"
        android:name="com.planner5d.library.activity.fragment.dialog.purchase.textures.PurchasePageTextures"
        android:id="@+id/purchase_page_textures"/>
    <fragment
        android:label="@string/profile_purchases_plan_recognitions"
        android:name="com.planner5d.library.activity.fragment.dialog.purchase.recognitions.PurchasePagePlanRecognitions"
        android:id="@+id/purchase_page_plan_recognitions"/>
    <fragment
        android:label="@string/about"
        android:name="com.planner5d.library.activity.fragment.profile.about.AboutFragment"
        android:id="@+id/about"/>
    <fragment
        android:label="@string/orders_history"
        android:name="com.planner5d.library.activity.fragment.profile.orders.OrdersHistoryFragment"
        android:id="@+id/orders_history"/>
    <fragment
        android:label="@string/promo_code"
        android:name="com.planner5d.library.activity.fragment.profile.promocode.PromoCodeFragment"
        android:id="@+id/promo_code">
        <action
            android:id="@+id/to_promo_code_success"
            app:destination="@+id/promo_code_success"
            app:popUpTo="@+id/profile"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.activity.fragment.profile.promocode.PromoCodeSuccessFragment"
        android:id="@+id/promo_code_success"
        app:toolbarVisible="false"/>
    <fragment
        android:label="@string/manage_data"
        android:name="com.planner5d.library.activity.fragment.profile.managedata.ManageDataFragment"
        android:id="@+id/manage_data"/>
    <fragment
        android:label="@string/pro_compare_plans"
        android:name="com.planner5d.library.activity.fragment.compareplans.ComparePlansFragment"
        android:id="@+id/compare_plans"/>
    <fragment
        android:label=""
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.Authentication"
        android:id="@+id/sign_up_options">
        <action
            android:id="@+id/sign_up_options_to_sign_up"
            app:destination="@+id/sign_up"/>
        <action
            android:id="@+id/sign_up_options_to_sign_in"
            app:destination="@+id/sign_in"/>
        <action
            android:id="@+id/sign_up_options_to_external_services"
            app:destination="@+id/external_services"/>
    </fragment>
    <fragment
        android:label="@string/welcome_sign_up"
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.AuthenticationSignUp"
        android:id="@+id/sign_up">
        <action
            android:id="@+id/to_profile"
            app:destination="@+id/profile_menu"/>
    </fragment>
    <fragment
        android:label="@string/sign_in"
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.AuthenticationSignIn"
        android:id="@+id/sign_in">
        <action
            android:id="@+id/to_forgot_password"
            app:destination="@+id/forgot_password"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_sign_up"
            app:destination="@+id/sign_up"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/sign_up_options"/>
        <action
            android:id="@+id/to_error"
            app:destination="@+id/authentication_error"/>
        <action
            android:id="@+id/to_privacy_agreement"
            app:destination="@+id/privacy_agreement"/>
        <action
            android:id="@+id/to_external_services"
            app:destination="@+id/external_services"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.onelink.AuthenticationSignInWithLink"
        android:id="@+id/sign_in_with_link">
        <argument
            android:name="fromProfile"
            android:defaultValue="@null"
            app:argType="java.lang.Boolean"
            app:nullable="true"/>
        <action
            android:id="@+id/to_external_services"
            app:destination="@+id/external_services"/>
        <action
            android:id="@+id/to_sign_in_with_link_confirmation"
            app:destination="@+id/sign_in_with_link_confirmation"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/sign_in_with_link"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.onelink.AuthenticationSignInConfirmation"
        android:id="@+id/sign_in_with_link_confirmation"
        app:dynamicLabelFromArgument="title">
        <argument
            android:name="signup"
            app:argType="java.lang.Boolean"/>
        <argument
            android:name="title"
            app:argType="integer"/>
        <argument
            android:name="fromProfile"
            app:argType="java.lang.Boolean"/>
        <action
            android:id="@+id/to_privacy_agreement"
            app:destination="@+id/privacy_agreement"/>
        <action
            android:id="@+id/to_enter_code"
            app:destination="@+id/enter_code"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/sign_in_with_link_confirmation"/>
        <action
            android:id="@+id/to_external_services"
            app:destination="@+id/external_services"/>
    </fragment>
    <fragment
        android:label="@string/sign_in"
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.onelink.AuthenticationSignInEnterCode"
        android:id="@+id/enter_code">
        <argument
            android:name="id"
            app:argType="integer"/>
        <argument
            android:name="email"
            app:argType="string"/>
        <argument
            android:name="fromProfile"
            app:argType="java.lang.Boolean"/>
        <argument
            android:name="signup"
            app:argType="java.lang.Boolean"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.AuthenticationForgotPassword"
        android:id="@+id/forgot_password">
        <action
            android:id="@+id/to_remind_password_success"
            app:destination="@+id/remind_password_success"
            app:popUpTo="@+id/sign_in"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.AuthenticationRemindPasswordSuccess"
        android:id="@+id/remind_password_success"/>
    <fragment
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.AuthenticationError"
        android:id="@+id/authentication_error">
        <argument
            android:name="error"
            app:argType="com.planner5d.library.services.exceptions.ErrorMessageException"/>
        <argument
            android:name="fromProfile"
            app:argType="java.lang.Boolean"/>
        <action
            android:id="@+id/authentication_error_to_sign_in"
            app:destination="@+id/sign_in"/>
        <action
            android:id="@+id/to_sign_in_with_link"
            app:destination="@+id/sign_in_with_link"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.AuthenticationExternalService"
        android:id="@+id/external_services">
        <argument
            android:name="type"
            app:argType="com.planner5d.library.modules.user.auth.SocialAuthType"/>
        <argument
            android:name="fromProfile"
            app:argType="java.lang.Boolean"/>
        <argument
            android:name="signUp"
            app:argType="java.lang.Boolean"/>
        <action
            android:id="@+id/external_services_to_agreements"
            app:destination="@+id/privacy_agreement"/>
        <action
            android:id="@+id/external_services_to_error"
            app:destination="@+id/authentication_error"/>
    </fragment>
    <fragment
        android:label="@string/privacy_message_title"
        android:name="com.planner5d.library.activity.fragment.dialog.authentication.privacy.AuthenticationPrivacyAgreement"
        android:id="@+id/privacy_agreement">
        <argument
            android:name="user"
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="@string/ai_chat_assistant"
        android:name="com.planner5d.library.aichat.view.fragment.ChatFragment"
        android:id="@+id/ai_chat"/>
</navigation>
