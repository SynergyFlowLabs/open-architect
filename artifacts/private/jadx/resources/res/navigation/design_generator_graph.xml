<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/design_generator_graph"
    app:startDestination="@+id/list">
    <include app:graph="@navigation/room_type_graph"/>
    <fragment
        android:label="@string/tools_main_autostyles"
        android:name="com.planner5d.library.dgenerator.fragment.list.AutoStyleListFragment"
        android:id="@+id/list"
        app:bottomNavigationVisible="false">
        <action
            android:id="@+id/to_image_crop"
            app:destination="@+id/image_crop"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_gallery"
            app:destination="@+id/gallery"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.dgenerator.fragment.crop.AutoStyleImageCropFragment"
        android:id="@+id/image_crop"
        app:lightStatusBarIcons="true"
        app:statusBarColor="@color/black"
        app:toolbarVisible="false">
        <argument
            android:name="autoStyleId"
            app:argType="long"/>
        <action
            android:id="@+id/to_room_type"
            app:destination="@+id/room_type_graph"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="autoStyleId"
                app:argType="long"/>
        </action>
    </fragment>
    <fragment
        android:name="com.planner5d.library.dgenerator.fragment.gallery.GalleryFragment"
        android:id="@+id/gallery">
        <argument
            android:name="toolbarTitle"
            app:argType="string"/>
        <argument
            android:name="autoStyleId"
            app:argType="long"/>
        <action
            android:id="@+id/to_gallery_pager"
            app:destination="@+id/gallery_pager"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.dgenerator.fragment.gallery.pager.GalleryPagerFragment"
        android:id="@+id/gallery_pager">
        <argument
            android:name="toolbarTitle"
            app:argType="string"/>
        <argument
            android:name="autoStyleId"
            app:argType="long"/>
        <argument
            android:name="imageIndex"
            app:argType="integer"/>
    </fragment>
</navigation>
