<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contest_graph"
    app:startDestination="@+id/main_contest_page">
    <fragment
        android:label="@string/design_battle"
        android:name="com.planner5d.library.contest.view.MainContestPage"
        android:id="@+id/main_contest_page"
        app:bottomNavigationVisible="true"
        app:drawUnderStatusBar="false"
        app:lightStatusBarIcons="false"
        app:statusBarVisible="true"
        app:toolbarTabsVisible="true"
        app:toolbarVisible="true">
        <action
            android:id="@+id/to_single_contest_fragment"
            app:destination="@+id/single_contest_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_single_contest_archive_fragment"
            app:destination="@+id/single_contest_archive_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="contestUid"
                app:argType="long"/>
        </action>
    </fragment>
    <fragment
        android:name="com.planner5d.library.contest.view.detail.ContestDetailsFragment"
        android:id="@+id/single_contest_fragment"
        app:drawUnderStatusBar="true"
        app:lightStatusBarIcons="false"
        app:statusBarVisible="false"
        app:toolbarVisible="false"/>
    <fragment
        android:name="com.planner5d.library.contest.view.archive.ContestArchive"
        android:id="@+id/single_contest_archive_fragment"
        app:drawUnderStatusBar="true"
        app:lightStatusBarIcons="false"
        app:statusBarVisible="false"
        app:toolbarVisible="false"/>
</navigation>
