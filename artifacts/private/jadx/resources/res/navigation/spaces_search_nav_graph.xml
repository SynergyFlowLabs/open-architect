<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spaces_search_graph"
    app:startDestination="@+id/start">
    <fragment
        android:name="com.planner5d.library.spaces.view.start.SpacesStartFragment"
        android:id="@+id/start"
        app:toolbarVisible="false">
        <action
            android:id="@+id/to_search_address"
            app:destination="@+id/search_address"
            app:exitAnim="@anim/fade_out"/>
        <action
            android:id="@+id/to_survey"
            app:destination="@+id/survey_step_usage"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.search.SpacesSearchFragment"
        android:id="@+id/search_address"
        app:toolbarVisible="false">
        <action
            android:id="@+id/to_loading"
            app:destination="@+id/loading"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_fake_loading"
            app:destination="@+id/fake_loading"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.loading.SpacesLoadingFragment"
        android:id="@+id/loading"
        app:toolbarVisible="false">
        <argument
            android:name="address"
            app:argType="string"/>
        <action
            android:id="@+id/to_info"
            app:destination="@+id/info"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/start"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.loading.SpacesFakeLoadingFragment"
        android:id="@+id/fake_loading"
        app:toolbarVisible="false">
        <argument
            android:name="address"
            app:argType="string"/>
        <action
            android:id="@+id/to_survey"
            app:destination="@+id/survey_step_usage"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/start"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.info.SpacesInfoFragment"
        android:id="@+id/info"
        app:toolbarVisible="false">
        <argument
            android:name="spacesProjectData"
            app:argType="com.planner5d.library.spaces.entity.SpacesProjectData"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.survey.usage.SurveyStepUsageFragment"
        android:id="@+id/survey_step_usage"
        app:toolbarVisible="false">
        <action
            android:id="@+id/to_personality"
            app:destination="@+id/survey_step_personality"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.survey.personality.SurveyStepPersonalityFragment"
        android:id="@+id/survey_step_personality"
        app:toolbarVisible="false">
        <action
            android:id="@+id/to_space_type"
            app:destination="@+id/survey_step_space_type"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.survey.spacetype.SurveyStepSpaceTypeFragment"
        android:id="@+id/survey_step_space_type"
        app:toolbarVisible="false">
        <action
            android:id="@+id/to_goals"
            app:destination="@+id/survey_step_goals"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.survey.goals.SurveyStepGoalsFragment"
        android:id="@+id/survey_step_goals"
        app:toolbarVisible="false">
        <action
            android:id="@+id/to_style"
            app:destination="@+id/survey_step_style"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.survey.style.SurveyStepStyleFragment"
        android:id="@+id/survey_step_style"
        app:toolbarVisible="false">
        <action
            android:id="@+id/to_info"
            app:destination="@+id/info"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_more_loading"
            app:destination="@+id/more_loading"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.planner5d.library.spaces.view.loading.SpacesMoreLoadingFragment"
        android:id="@+id/more_loading"
        app:toolbarVisible="false">
        <action
            android:id="@+id/to_info"
            app:destination="@+id/info"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/start"/>
    </fragment>
</navigation>
